# Variables de entorno (Railway Variables, Vercel o .env local).
# Todas son opcionales: sin ellas el sitio no carga ninguna etiqueta de seguimiento.
# Las PUBLIC_* se incrustan en el build: tras cambiarlas hay que volver a desplegar.

# --- Microsoft Clarity (mapas de calor). En el Dockerfile el valor por defecto es ylu80felfk.
CLARITY_PROJECT_ID=ylu80felfk

# --- Analítica y publicidad (se cargan SOLO si el visitante acepta cookies) ---
# Recomendado: un único contenedor de Google Tag Manager y montar ahí GA4, Google Ads, Meta, TikTok…
PUBLIC_GTM_ID=
# Alternativa sin GTM: cada píxel directo
PUBLIC_GA4_ID=
PUBLIC_GADS_ID=
PUBLIC_GADS_LEAD_LABEL=
PUBLIC_META_PIXEL_ID=
PUBLIC_TIKTOK_PIXEL_ID=
PUBLIC_LINKEDIN_PARTNER_ID=
PUBLIC_LINKEDIN_LEAD_CONVERSION_ID=
PUBLIC_BING_UET_ID=

# --- Formulario: endpoint HTTPS que recibe el brief (Formspree, Web3Forms, función propia).
# Con endpoint, el lead redirige a /gracias/ y la conversión es fiable. Sin él, se abre el correo.
PUBLIC_FORM_ENDPOINT=

# --- Verificación de propiedad (solo el código del content="…") ---
PUBLIC_GSC_VERIFICATION=
PUBLIC_BING_VERIFICATION=
PUBLIC_META_DOMAIN_VERIFICATION=
PUBLIC_TIKTOK_VERIFICATION=
PUBLIC_PINTEREST_VERIFICATION=
