---
import "../styles/global.css";
import fontUrl from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import StickyCta from "../components/StickyCta.astro";
import { site, team, testimonials } from "../data/site";
import { places } from "../data/places";
import { adsEnabled, verification } from "../data/ads";
import { services } from "../data/services";
import { basePlan } from "../data/pricing";

interface Crumb {
  name: string;
  path: string;
}
interface Props {
  title?: string;
  description: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  crumbs?: Crumb[];
  stickyCta?: boolean;
  /** Imagen para redes (ruta absoluta en /public). */
  image?: string;
  /** "article" para guías; "website" para el resto. */
  type?: "website" | "article";
  /** ISO 8601. Se publican en og:article y en el WebPage del schema. */
  published?: string;
  modified?: string;
  /** Landing de anuncios: noindex y sin botón flotante (cabecera y pie van por slots). */
  minimal?: boolean;
}

const {
  title,
  description,
  noindex: noindexProp = false,
  schema = [],
  crumbs = [],
  stickyCta: stickyProp = true,
  image,
  type = "website",
  published,
  modified,
  minimal = false,
} = Astro.props;
const noindex = noindexProp || minimal;
const stickyCta = stickyProp && !minimal;
const fullTitle = title ? `${title} | COMA` : `${site.title} · Diseño web desde ${basePlan.price} €, SEO e IA`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image ?? "/og-coma.png", site.url).href;
const orgId = `${site.url}/#org`;

const org = {
  "@context": "https://schema.org",
  "@type": ["MarketingAgency", "ProfessionalService"],
  "@id": orgId,
  name: site.brand,
  alternateName: ["COMA", "Comunicación en Mallorca"],
  legalName: site.legalName,
  taxID: site.cif,
  url: site.url,
  // Google pide un logo rasterizado de al menos 112 px para el panel de empresa.
  logo: {
    "@type": "ImageObject",
    url: new URL("/icon-512.png", site.url).href,
    width: 512,
    height: 512,
  },
  image: new URL("/og-coma.png", site.url).href,
  email: site.email,
  foundingDate: String(site.since),
  foundingLocation: {
    "@type": "Place",
    name: "Palma, Mallorca",
    address: { "@type": "PostalAddress", addressLocality: site.address.city, addressRegion: site.address.region, addressCountry: site.address.country },
  },
  slogan: "Hacemos que tu empresa se note",
  description:
    "Agencia de diseño web y marketing en Mallorca desde 1997. Webs desde 99 € + IVA, SEO y posicionamiento en IA (GEO), agentes de IA y automatizaciones para autónomos y pymes de toda España.",
  priceRange: "€",
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  geo: { "@type": "GeoCoordinates", latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.mapsUrl,
  areaServed: [
    { "@type": "Country", name: "España" },
    ...places
      .filter((p) => p.kind === "ccaa" || p.kind === "isla")
      .map((p) => ({ "@type": "AdministrativeArea", name: p.name })),
  ],
  knowsLanguage: site.languages,
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "customer service",
      email: site.email,
      areaServed: "ES",
      availableLanguage: ["Spanish", "Catalan", "English"],
    },
  ],
  ...(site.social.length ? { sameAs: site.social } : {}),
  ...(team.length
    ? {
        employee: team.map((m) => ({
          "@type": "Person",
          name: m.name,
          jobTitle: m.role,
          worksFor: { "@id": orgId },
          ...(m.url ? { sameAs: [m.url] } : {}),
        })),
      }
    : {}),
  ...(testimonials.length
    ? {
        review: testimonials.map((t) => ({
          "@type": "Review",
          reviewBody: t.quote,
          author: { "@type": "Person", name: t.author },
          itemReviewed: { "@id": orgId },
        })),
      }
    : {}),
  knowsAbout: [
    "Diseño web",
    "Desarrollo web",
    "SEO local",
    "Generative Engine Optimization (GEO)",
    "Agentes de inteligencia artificial",
    "Automatización de procesos",
    "Marketing digital",
    "Branding",
    "Publicidad en radio, prensa y televisión",
    "Kit Digital",
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios",
    itemListElement: services.map((s) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: s.label, url: `${site.url}/${s.slug}/` },
    })),
  },
  makesOffer: {
    "@type": "Offer",
    name: `${basePlan.name}: web profesional`,
    price: basePlan.price,
    priceCurrency: "EUR",
    priceSpecification: {
      "@type": "PriceSpecification",
      price: basePlan.price,
      priceCurrency: "EUR",
      valueAddedTaxIncluded: false,
    },
    url: `${site.url}/precios/`,
  },
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site.url}/#web`,
  url: site.url,
  name: site.title,
  inLanguage: "es-ES",
  publisher: { "@id": orgId },
};

const webpage = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#page`,
  url: canonical,
  name: fullTitle,
  description,
  inLanguage: "es-ES",
  isPartOf: { "@id": `${site.url}/#web` },
  about: { "@id": orgId },
  primaryImageOfPage: { "@type": "ImageObject", url: ogImage },
  ...(published ? { datePublished: published } : {}),
  ...(modified ?? published ? { dateModified: modified ?? published } : {}),
};

const breadcrumb = crumbs.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [{ name: "Inicio", path: "/" }, ...crumbs].map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: new URL(c.path, site.url).href,
      })),
    }
  : null;

const ld = [org, website, webpage, ...(breadcrumb ? [breadcrumb] : []), ...schema];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"}
    />
    <meta name="theme-color" content="#f3f0ea" />
    <meta name="author" content={site.brand} />
    <meta name="geo.region" content="ES-IB" />
    <meta name="geo.placename" content="Palma de Mallorca" />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    <meta name="ICBM" content={`${site.geo.lat}, ${site.geo.lng}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" hreflang="es-ES" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {verification.google && <meta name="google-site-verification" content={verification.google} />}
    {verification.bing && <meta name="msvalidate.01" content={verification.bing} />}
    {verification.meta && <meta name="facebook-domain-verification" content={verification.meta} />}
    {verification.tiktok && <meta name="tiktok-developers-site-verification" content={verification.tiktok} />}
    {verification.pinterest && <meta name="p:domain_verify" content={verification.pinterest} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Resumen para modelos de IA" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content={type} />
    {type === "article" && published && <meta property="article:published_time" content={published} />}
    {type === "article" && (modified ?? published) && <meta property="article:modified_time" content={modified ?? published} />}
    {type === "article" && <meta property="article:author" content={site.brand} />}
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="COMA - Comunicación en Mallorca. Webs desde 99 €, SEO e IA." />
    <meta name="twitter:image:alt" content="COMA - Comunicación en Mallorca. Webs desde 99 €, SEO e IA." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        try {
          var reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (!reduced && !sessionStorage.getItem("coma_intro")) d.classList.add("intro-on");
          if (sessionStorage.getItem("coma_curtain")) d.classList.add("curtain-open");
        } catch (e) {}
      })();
    </script>
    {
      adsEnabled && (
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag("consent","default",{ad_storage:"denied",ad_user_data:"denied",ad_personalization:"denied",analytics_storage:"denied",functionality_storage:"granted",security_storage:"granted"});gtag("set","ads_data_redaction",true);gtag("set","url_passthrough",true);`}
        />
      )
    }
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <div class="intro" aria-hidden="true" data-intro>
      <div class="intro__word">
        {["C", "O", "M", "A"].map((l, i) => <span style={`--i:${i}`}>{l}</span>)}<svg viewBox="0 0 20 40"
          ><path d="M6 0h14v21c0 10-5 16.5-15 19l-2-5.5c5-1.8 7.5-5.2 8-9.5H6z" fill="currentColor"></path></svg
        >
      </div>
      <span class="intro__count">Comunicación en Mallorca · <span data-intro-count>0</span>%</span>
      <i class="intro__bar"></i>
    </div>
    <div class="curtain" aria-hidden="true" data-curtain>
      <svg viewBox="0 0 20 40"
        ><path d="M6 0h14v21c0 10-5 16.5-15 19l-2-5.5c5-1.8 7.5-5.2 8-9.5H6z" fill="currentColor"></path></svg
      >
    </div>
    <div class="cursor" aria-hidden="true" data-cursor></div>
    <div class="sp" aria-hidden="true" data-sp><i></i></div>
    <a class="skip" href="#main">Saltar al contenido</a>
    {Astro.slots.has("header") ? <slot name="header" /> : <Header />}
    <main id="main">
      <slot />
    </main>
    {Astro.slots.has("footer") ? <slot name="footer" /> : <Footer />}
    {stickyCta && <StickyCta />}
    <CookieBanner />
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
