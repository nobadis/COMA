---
interface Props {
  eyebrow?: string;
  text: string;
}
const { eyebrow = "Quiénes somos", text } = Astro.props;
---

<section class="section mf">
  <div class="wrap">
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <p class="mf__text display" data-scrub>{text}</p>
  </div>
</section>

<style>
  .mf {
    padding-block: clamp(5rem, 12vw, 11rem);
  }
  .mf .wrap {
    display: grid;
    gap: 2rem;
  }
  .mf__text {
    font-size: clamp(1.8rem, 0.8rem + 3.6vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.045em;
    max-width: 24ch;
    font-variation-settings: "wdth" 112;
    font-weight: 600;
  }
  .mf__text :global(span) {
    opacity: 0.16;
    transition: opacity 0.4s var(--ease);
  }
  .mf__text :global(span.on) {
    opacity: 1;
  }
  @media (min-width: 900px) {
    .mf__text {
      max-width: 30ch;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mf__text :global(span) {
      opacity: 1;
    }
  }
</style>
