---
import Arrow from "./Arrow.astro";
import { site, mailto, ctaPicks } from "../data/site";

interface Props {
  title?: string;
  subject?: string;
  /** Texto bajo el titular (por defecto, el genérico de propuesta). */
  lead?: string;
  /** Botón principal (por defecto, al brief de contacto). */
  action?: { href: string; label: string };
  /** Enlace del email (por defecto, mailto con el asunto). */
  mail?: string;
  /** Atajos a cada servicio bajo los botones (en páginas generales, no en las de un servicio). */
  picks?: boolean;
}
const {
  title = "¿Qué necesita tu negocio? Empecemos.",
  subject = "Nuevo proyecto",
  lead = "Una web desde 99 €, que te encuentren en Google y en la IA, un agente que atienda por ti o quitarte tareas de encima. Cuéntanoslo y te respondemos personalmente con una propuesta clara, sin compromiso.",
  action = { href: "/contacto/", label: "Pedir propuesta" },
  mail,
  picks = false,
} = Astro.props;
---

<section class="section cta" data-hide-sticky>
  <div class="wrap cta__inner">
    <p class="eyebrow" data-reveal>Empecemos</p>
    <h2 class="cta__title" data-split>{title}</h2>
    <p class="lead" data-reveal style="--d:2">{lead}</p>
    <div class="cta__actions" data-reveal style="--d:3">
      <a class="btn btn--red cta__btn" href={action.href} data-magnetic>{action.label} <Arrow /></a>
      <a class="link-arrow" href={mail ?? mailto(subject)}>{site.email}</a>
    </div>
    {
      picks && (
        <nav class="cta__picks" data-reveal style="--d:4" aria-label="Ve directo a lo que buscas">
          {ctaPicks.map((p) => (
            <a href={p.href}>{p.label}</a>
          ))}
        </nav>
      )
    }
  </div>
</section>

<style>
  .cta {
    background: var(--red);
    color: #fff;
    overflow: hidden;
    padding-block: clamp(5rem, 12vw, 10rem);
    --muted: rgb(255 255 255 / 0.85);
  }
  .cta__inner {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .cta .eyebrow {
    color: #fff;
  }
  .cta .eyebrow::before {
    background: #fff;
  }
  .cta__title {
    font-size: clamp(2.6rem, 1rem + 8vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
    max-width: 14ch;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
  }
  .cta__actions .link-arrow {
    white-space: nowrap;
    font-size: min(var(--fs-md), 4.3vw);
  }
  .cta__picks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cta__picks a {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border: 1px solid rgb(255 255 255 / 0.55);
    border-radius: 999px;
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition:
      background 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .cta__picks a:hover {
    background: #fff;
    color: var(--red);
  }
  .cta .btn--red {
    --bg: var(--ink);
    --fg: var(--paper);
    --fill: var(--paper);
  }
  .cta .btn--red:hover {
    color: var(--ink);
  }
</style>
