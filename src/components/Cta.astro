---
import Arrow from "./Arrow.astro";
import { site, mailto } from "../data/site";

interface Props {
  title?: string;
  subject?: string;
  /** Texto bajo el titular (por defecto, el genérico de propuesta). */
  lead?: string;
  /** Botón principal (por defecto, al brief de contacto). */
  action?: { href: string; label: string };
  /** Enlace del email (por defecto, mailto con el asunto). */
  mail?: string;
}
const {
  title = "Tu web, desde 99 €. ¿Empezamos?",
  subject = "Nuevo proyecto",
  lead = "Cuéntanos qué necesitas y te respondemos personalmente con una propuesta clara, sin compromiso. Desde Mallorca para toda España.",
  action = { href: "/contacto/", label: "Pedir propuesta" },
  mail,
} = Astro.props;
---

<section class="section cta" data-hide-sticky>
  <div class="wrap cta__inner">
    <p class="eyebrow" data-reveal>Empecemos</p>
    <h2 class="cta__title" data-split>{title}</h2>
    <p class="lead" data-reveal style="--d:2">{lead}</p>
    <div class="cta__actions" data-reveal style="--d:3">
      <a class="btn btn--red cta__btn" href={action.href} data-magnetic data-track="cta_click" data-track-label={action.label}>{action.label} <Arrow /></a>
      <a class="link-arrow" href={mail ?? mailto(subject)}>{site.email}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--red);
    color: #fff;
    overflow: hidden;
    padding-block: clamp(5rem, 12vw, 10rem);
    --muted: rgb(255 255 255 / 0.85);
  }
  .cta__inner {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .cta .eyebrow {
    color: #fff;
  }
  .cta .eyebrow::before {
    background: #fff;
  }
  .cta__title {
    font-size: clamp(2.6rem, 1rem + 8vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
    max-width: 14ch;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
  }
  .cta__actions .link-arrow {
    white-space: nowrap;
    font-size: min(var(--fs-md), 4.3vw);
  }
  .cta .btn--red {
    --bg: var(--ink);
    --fg: var(--paper);
    --fill: var(--paper);
  }
  .cta .btn--red:hover {
    color: var(--ink);
  }
</style>
