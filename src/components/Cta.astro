---
import Arrow from "./Arrow.astro";
import { site, mailto } from "../data/site";

interface Props {
  title?: string;
  subject?: string;
}
const { title = "¿Hablamos?", subject = "Nuevo proyecto" } = Astro.props;
---

<section class="section cta">
  <div class="wrap cta__inner">
    <p class="eyebrow" data-reveal>Empecemos</p>
    <h2 class="cta__title" data-split>{title}</h2>
    <p class="lead" data-reveal style="--d:2">
      Cuéntanos qué quieres conseguir. Te respondemos personalmente con una
      primera propuesta, sin compromiso.
    </p>
    <div class="cta__actions" data-reveal style="--d:3">
      <a class="btn btn--red cta__btn" href="/contacto/" data-magnetic>Pedir propuesta <Arrow /></a>
      <a class="link-arrow" href={mailto(subject)}>{site.email}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    text-align: center;
    border-top: 1px solid var(--line);
  }
  .cta__inner {
    display: grid;
    justify-items: center;
    gap: 1.75rem;
  }
  .cta__title {
    font-size: var(--fs-3xl);
    max-width: 16ch;
  }
  .cta .lead {
    max-width: 50ch;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.5rem 2rem;
  }
  .cta__btn {
    padding: 1.4rem 2.2rem;
    font-size: var(--fs-md);
  }
</style>
