---
import Arrow from "./Arrow.astro";
import SiteMock from "./SiteMock.astro";
import { works } from "../data/work";

interface Props {
  title?: string;
  link?: boolean;
}
const { title = "Webs que hacen que te elijan", link = true } = Astro.props;
---

<section class="sc night" id="trabajos" data-hscroll data-dark>
  <div class="sc__sticky">
    <div class="wrap sc__head">
      <div>
        <p class="eyebrow">Trabajos y conceptos</p>
        <h2 data-split>{title}<span class="comma">,</span></h2>
      </div>
      <div class="sc__side">
        <p class="muted">
          Así de bien puede verse tu negocio. Ejemplos de diseño por sector: rápidos, claros y
          pensados para convertir.
        </p>
        {link && <a class="link-arrow" href="/trabajos/">Ver todos <Arrow /></a>}
      </div>
    </div>

    <div class="sc__viewport">
      <ol class="sc__track" data-hscroll-track>
        {
          works.map((w, i) => (
            <li class="sc__item" style={`--i:${i}`}>
              <SiteMock work={w} />
              <div class="sc__meta">
                <span class="sc__n">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{w.sector}</h3>
                  <p>{w.tags.join(" · ")}</p>
                </div>
              </div>
            </li>
          ))
        }
        <li class="sc__item sc__end">
          <p class="display">¿La próxima es la tuya<span class="comma">?</span></p>
          <a class="btn btn--red btn--lg" href="/contacto/?plan=web">Quiero mi web <Arrow /></a>
        </li>
      </ol>
    </div>
    <div class="wrap sc__bar" aria-hidden="true"><i></i></div>
  </div>
</section>

<style>
  .sc {
    --p: 0;
    position: relative;
    padding-block: clamp(4rem, 8vw, 6rem);
  }
  .sc__head {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .sc__head > div:first-child {
    display: grid;
    gap: 1.25rem;
  }
  .sc__side {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 40ch;
  }
  @media (min-width: 900px) {
    .sc__head {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .sc__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .sc__viewport::-webkit-scrollbar {
    display: none;
  }
  .sc__track {
    list-style: none;
    display: flex;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    padding: 0 var(--gutter) 1rem;
    width: max-content;
  }
  .sc__item {
    width: min(84vw, 40rem);
    scroll-snap-align: center;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .sc__item :global(.mk) {
    transition: transform 0.7s var(--ease);
  }
  .sc__item:hover :global(.mk) {
    transform: translateY(-8px) rotate(-0.6deg);
  }
  .sc__meta {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }
  .sc__n {
    font-size: var(--fs-xs);
    color: var(--red);
    font-weight: 600;
  }
  .sc__meta h3 {
    font-size: 1.35rem;
  }
  .sc__meta p {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .sc__end {
    width: min(84vw, 26rem);
    align-content: center;
    justify-items: start;
    gap: 2rem;
  }
  .sc__end .display {
    font-size: var(--fs-2xl);
  }
  .sc__bar {
    display: none;
  }

  @media (min-width: 900px) {
    .sc {
      padding-block: 0;
    }
    .sc__sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
      padding-block: 6rem 2rem;
    }
    .sc__viewport {
      overflow: visible;
    }
    .sc__track {
      will-change: transform;
      padding-left: max(var(--gutter), calc((100vw - var(--max)) / 2));
    }
    .sc__item {
      width: clamp(26rem, 38vw, 38rem);
    }
    .sc__bar {
      display: block;
      margin-top: 1.5rem;
      height: 2px;
      background: var(--line);
      border-radius: 2px;
    }
    .sc__bar i {
      display: block;
      height: 100%;
      background: var(--red);
      transform-origin: left;
      transform: scaleX(var(--p));
    }
  }
  @media (min-width: 900px) and (max-height: 760px) {
    .sc__item {
      width: clamp(22rem, 30vw, 30rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sc__sticky {
      position: static;
      height: auto;
    }
    .sc__viewport {
      overflow-x: auto;
    }
  }
</style>
