---
import Logo from "./Logo.astro";
import Arrow from "./Arrow.astro";
import { navServices, site, mailto } from "../data/site";

const links = [
  ...navServices,
  { href: "/precios/", label: "Precios" },
  { href: "/kit-digital/", label: "Kit Digital" },
  { href: "/sobre-coma/", label: "Sobre COMA" },
  { href: "/guias/", label: "Guías" },
];
const zones = [
  { href: "/zonas/mallorca/", label: "Mallorca" },
  { href: "/zonas/palma/", label: "Palma" },
  { href: "/zonas/illes-balears/", label: "Illes Balears" },
  { href: "/zonas/madrid/", label: "Madrid" },
  { href: "/zonas/barcelona/", label: "Barcelona" },
  { href: "/zonas/valencia/", label: "Valencia" },
  { href: "/zonas/sevilla/", label: "Sevilla" },
  { href: "/zonas/bilbao/", label: "Bilbao" },
  { href: "/zonas/", label: "Todas las zonas" },
];
---

<footer class="ftr night" data-dark data-hide-sticky>
  <div class="wrap">
    <div class="ftr__top">
      <a href="/" class="ftr__logo" aria-label="COMA, ir al inicio"><Logo /></a>
      <a class="btn btn--red" href={mailto("Nuevo proyecto")}>
        {site.email}
        <Arrow />
      </a>
    </div>

    <nav class="ftr__links" aria-label="Pie de página">
      {links.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="/aviso-legal/">Aviso legal</a>
      <a href="/cookies/">Cookies</a>
      <a href="/privacidad/">Privacidad</a>
      <button type="button" class="ftr__linkbtn" data-cookie-open>Preferencias de cookies</button>
    </nav>

    <nav class="ftr__links ftr__zones" aria-label="Zonas">
      <span>Diseño web, SEO e IA en:</span>
      {zones.map((z) => <a href={z.href}>{z.label}</a>)}
    </nav>

    <p class="ftr__bottom">
      © <span class="coma-year">{new Date().getFullYear()}</span>{" "}
      {`${site.brand} · ${site.legalName} · CIF ${site.cif} · ${site.address.street}, ${site.address.postalCode} ${site.address.city}`}
    </p>
  </div>
</footer>

<style>
  .ftr {
    padding-block: clamp(1.75rem, 4vw, 2.5rem) 1.25rem;
  }
  .ftr__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .ftr__logo {
    text-decoration: none;
  }
  .ftr__logo :global(.logo) {
    font-size: 1.75rem;
  }
  .ftr .btn {
    color: #fff;
    max-width: 100%;
    overflow-wrap: anywhere;
    min-height: 3rem;
    padding-block: 0.75rem;
  }
  .ftr__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    padding-block: 1.25rem;
    margin-block: 1.25rem 0;
    border-block: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
  .ftr__links a,
  .ftr__linkbtn {
    text-decoration: none;
    transition: color 0.3s;
  }
  .ftr__links a:hover,
  .ftr__linkbtn:hover {
    color: var(--red);
  }
  .ftr__linkbtn {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-size: inherit;
    color: var(--night-muted);
  }
  .ftr__zones {
    margin-block: 0;
    border-top: 0;
    color: var(--night-muted);
  }
  .ftr__bottom {
    padding-top: 1rem;
    font-size: var(--fs-xs);
    color: var(--muted);
  }
</style>
