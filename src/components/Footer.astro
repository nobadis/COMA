---
import Logo from "./Logo.astro";
import Arrow from "./Arrow.astro";
import { navServices, site, mailto } from "../data/site";

const links = [
  ...navServices,
  { href: "/precios/", label: "Precios" },
  { href: "/kit-digital/", label: "Kit Digital" },
];
---

<footer class="ftr night" data-dark data-hide-sticky>
  <div class="wrap">
    <div class="ftr__top">
      <a href="/" class="ftr__logo" aria-label="COMA, ir al inicio"><Logo /></a>
      <button type="button" class="ftr__play" data-video-open data-track="video_play" data-track-label="footer">
        <span class="ftr__play-ic" aria-hidden="true"></span>
        COMA en 34 segundos
      </button>
      <a class="btn btn--red" href={mailto("Nuevo proyecto")}>
        {site.email}
        <Arrow />
      </a>
    </div>

    <nav class="ftr__links" aria-label="Pie de página">
      {links.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="/sobre-coma/">Sobre COMA</a>
      <a href="/guias/">Guías</a>
      <a href="/zonas/">Zonas</a>
      <a href="/aviso-legal/">Aviso legal</a>
      <a href="/cookies/">Cookies</a>
      <a href="/privacidad/">Privacidad</a>
      <button type="button" class="ftr__linkbtn" data-cookie-open>Preferencias de cookies</button>
    </nav>

    <p class="ftr__bottom">
      © <span class="coma-year">{new Date().getFullYear()}</span>{" "}
      {`${site.brand} · ${site.legalName} · CIF ${site.cif} · ${site.address.street}, ${site.address.postalCode} ${site.address.city}`}
    </p>
  </div>

  <!-- Vídeo promocional: el MP4 solo se descarga al abrir el diálogo. -->
  <dialog class="vd" data-video aria-label="Vídeo: COMA en 34 segundos">
    <div class="vd__box">
      <button type="button" class="vd__close" data-video-close aria-label="Cerrar vídeo">×</button>
      <video
        class="vd__video"
        controls
        playsinline
        preload="none"
        width="1920"
        height="1080"
        data-src="/video/coma-promo.mp4"
        data-poster="/video/coma-promo.jpg"></video>
      <p class="vd__foot">
        <span>Tecnología al servicio de las personas.</span>
        <a href="/contacto/" data-track="video_cta" data-track-label="footer-video">Cuéntanos qué te quita tiempo <Arrow /></a>
      </p>
    </div>
  </dialog>
</footer>

<script>
  document.querySelectorAll<HTMLDialogElement>("[data-video]").forEach((dialog) => {
    const video = dialog.querySelector<HTMLVideoElement>("video");
    if (!video) return;
    const open = () => {
      if (!video.src) {
        video.poster = video.dataset.poster ?? "";
        video.src = video.dataset.src ?? "";
      }
      dialog.showModal();
      void video.play().catch(() => {});
    };
    document.querySelectorAll("[data-video-open]").forEach((b) => b.addEventListener("click", open));
    dialog.querySelector("[data-video-close]")?.addEventListener("click", () => dialog.close());
    // clic fuera del vídeo (en el fondo) cierra
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => video.pause());
  });
</script>

<style>
  .ftr {
    padding-block: clamp(1.75rem, 4vw, 2.5rem) 1.25rem;
  }
  .ftr__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .ftr__logo {
    text-decoration: none;
  }
  .ftr__logo :global(.logo) {
    font-size: 1.75rem;
  }
  .ftr .btn {
    color: #fff;
    max-width: 100%;
    min-height: 3rem;
    padding-block: 0.75rem;
  }
  /* el email cabe siempre en una línea: en minúsculas y con el cuerpo ajustado al ancho */
  @media (max-width: 599px) {
    .ftr .btn {
      white-space: nowrap;
      text-transform: none;
      letter-spacing: 0;
      font-size: min(var(--fs-sm), 4.1vw);
      gap: 0.75rem;
      padding-inline: 1rem;
    }
  }
  .ftr__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    padding-block: 1.25rem;
    margin-block: 1.25rem 0;
    border-block: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
  .ftr__links a,
  .ftr__linkbtn {
    text-decoration: none;
    transition: color 0.3s;
  }
  .ftr__links a:hover,
  .ftr__linkbtn:hover {
    color: var(--red);
  }
  .ftr__linkbtn {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-size: inherit;
    color: var(--night-muted);
  }
  /* botón discreto del vídeo: texto pequeño con un play, entre el logo y el email */
  .ftr__play {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-inline-end: auto;
    background: none;
    border: 0;
    padding: 0.4rem 0;
    cursor: pointer;
    font: inherit;
    font-size: var(--fs-sm);
    color: var(--night-muted);
    transition: color 0.3s;
  }
  .ftr__play:hover {
    color: var(--paper);
  }
  .ftr__play-ic {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--night-line);
    border-radius: 50%;
    transition:
      border-color 0.3s,
      background 0.3s;
  }
  .ftr__play-ic::before {
    content: "";
    margin-left: 0.15rem;
    border-style: solid;
    border-width: 0.3rem 0 0.3rem 0.5rem;
    border-color: transparent transparent transparent currentColor;
  }
  .ftr__play:hover .ftr__play-ic {
    border-color: var(--red);
    background: var(--red);
  }
  @media (min-width: 600px) {
    .ftr__play {
      margin-inline-start: 1.5rem;
    }
  }

  .vd {
    width: min(100% - 2rem, 1100px);
    max-width: none;
    max-height: none;
    padding: 0;
    margin: auto;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .vd::backdrop {
    background: rgb(12 12 12 / 0.86);
    backdrop-filter: blur(6px);
  }
  .vd__box {
    position: relative;
  }
  .vd__video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: var(--ink);
  }
  .vd__close {
    position: absolute;
    top: -2.75rem;
    right: 0;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .vd__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-top: 0.9rem;
    font-size: var(--fs-sm);
    color: var(--night-muted);
  }
  .vd__foot a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--paper);
    text-decoration: none;
  }
  .vd__foot a:hover {
    color: var(--red);
  }
  .ftr__bottom {
    padding-top: 1rem;
    font-size: var(--fs-xs);
    color: var(--muted);
  }
</style>
