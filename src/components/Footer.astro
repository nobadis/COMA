---
import Logo from "./Logo.astro";
import Arrow from "./Arrow.astro";
import { navServices, site, mailto } from "../data/site";
---

<footer class="ftr night" data-dark data-hide-sticky>
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__brand">
        <a href="/" class="ftr__logo" aria-label="COMA, ir al inicio"><Logo /></a>
        <p>Hacemos que tu empresa se note<span class="comma">,</span> sin que te cueste una fortuna.</p>
      </div>
      <a class="btn btn--red" href={mailto("Nuevo proyecto")}>
        {site.email}
        <Arrow />
      </a>
    </div>

    <div class="ftr__grid">
      <div>
        <p class="ftr__h">Servicios</p>
        <ul>
          {navServices.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href="/precios/">Precios</a></li>
          <li><a href="/kit-digital/">Kit Digital</a></li>
        </ul>
      </div>
      <div>
        <p class="ftr__h">Estudio</p>
        <address>
          {site.address.street}<br />
          {site.address.postalCode}
          {site.address.city}, {site.address.region}<br />
          <a href={site.mapsUrl} target="_blank" rel="noopener">Ver en el mapa ↗</a>
        </address>
      </div>
      <div>
        <p class="ftr__h">Legal</p>
        <ul>
          <li><a href="/aviso-legal/">Aviso legal</a></li>
          <li><a href="/cookies/">Política de cookies</a></li>
          <li><a href="/privacidad/">Política de privacidad</a></li>
          <li><button type="button" class="ftr__linkbtn" data-cookie-open>Preferencias de cookies</button></li>
        </ul>
      </div>
    </div>

    <div class="ftr__bottom">
      <span>© <span class="coma-year">{new Date().getFullYear()}</span> {site.brand}. Todos los derechos reservados.</span>
      <span>{site.legalName} · CIF {site.cif}</span>
    </div>
  </div>
</footer>

<style>
  .ftr {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: 1.25rem;
  }
  .ftr__top {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 800px) {
    .ftr__top {
      grid-template-columns: 1fr auto;
    }
  }
  .ftr__brand {
    display: grid;
    gap: 0.75rem;
  }
  .ftr__logo {
    text-decoration: none;
    justify-self: start;
  }
  .ftr__logo :global(.logo) {
    font-size: 2rem;
  }
  .ftr__brand p {
    color: var(--muted);
    max-width: 40ch;
  }
  .ftr__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-block: 2.5rem;
    font-size: var(--fs-sm);
  }
  @media (min-width: 600px) {
    .ftr__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .ftr__h {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.9rem;
  }
  .ftr ul {
    display: grid;
    gap: 0.45rem;
  }
  .ftr address {
    font-style: normal;
    line-height: 1.8;
  }
  .ftr a,
  .ftr__linkbtn {
    text-decoration: none;
    transition: color 0.3s;
  }
  .ftr a:hover,
  .ftr__linkbtn:hover {
    color: var(--red);
  }
  .ftr__linkbtn {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-align: left;
    font-size: inherit;
  }
  .ftr .btn {
    color: #fff;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
</style>
