---
/** Ilustraciones animadas abstractas por servicio (SVG + CSS, sin imágenes). */
interface Props {
  kind: "web" | "seo" | "ia" | "auto" | "medios";
}
const { kind } = Astro.props;
---

<div class={`mo mo--${kind}`} aria-hidden="true">
  {
    kind === "web" && (
      <svg viewBox="0 0 400 300">
        <rect class="b b1" x="20" y="20" width="360" height="26" />
        <rect class="b b2" x="20" y="64" width="210" height="130" />
        <rect class="b b3" x="246" y="64" width="134" height="62" />
        <rect class="b b4" x="246" y="132" width="134" height="62" />
        <rect class="b b5" x="20" y="212" width="112" height="68" />
        <rect class="b b6" x="144" y="212" width="112" height="68" />
        <rect class="b b7" x="268" y="212" width="112" height="68" />
      </svg>
    )
  }
  {
    kind === "seo" && (
      <svg viewBox="0 0 400 300">
        <path class="grid" d="M20 280H380M20 210H380M20 140H380M20 70H380" />
        <polyline class="line" points="20,270 80,240 140,250 200,170 260,150 320,80 380,30" />
        <circle class="dot" cx="380" cy="30" r="9" />
        <g class="tag">
          <rect x="262" y="2" width="96" height="24" />
          <text x="310" y="19" text-anchor="middle">Nº 1</text>
        </g>
      </svg>
    )
  }
  {
    kind === "ia" && (
      <svg viewBox="0 0 400 300">
        <rect class="bub q" x="130" y="20" width="250" height="58" />
        <rect class="bub a" x="20" y="108" width="290" height="58" />
        <rect class="bub a a2" x="20" y="182" width="220" height="40" />
        <g class="typing">
          <circle cx="40" cy="262" r="7" />
          <circle cx="66" cy="262" r="7" />
          <circle cx="92" cy="262" r="7" />
        </g>
      </svg>
    )
  }
  {
    kind === "auto" && (
      <svg viewBox="0 0 400 300">
        <path id="mo-p" class="wire" d="M60 150H170M230 150H340M200 90V60M200 210V240" />
        <rect class="node" x="20" y="120" width="60" height="60" />
        <rect class="node hot" x="170" y="110" width="60" height="80" />
        <rect class="node" x="320" y="120" width="60" height="60" />
        <rect class="node" x="170" y="20" width="60" height="40" />
        <rect class="node" x="170" y="240" width="60" height="40" />
        <circle class="pulse" r="7">
          <animateMotion dur="3s" repeatCount="indefinite" path="M80 150H170M230 150H320" />
        </circle>
      </svg>
    )
  }
  {
    kind === "medios" && (
      <svg viewBox="0 0 400 300">
        <circle class="ring r1" cx="200" cy="150" r="40" />
        <circle class="ring r2" cx="200" cy="150" r="90" />
        <circle class="ring r3" cx="200" cy="150" r="140" />
        <circle class="core" cx="200" cy="150" r="14" />
      </svg>
    )
  }
</div>

<style>
  .mo {
    width: 100%;
    color: currentColor;
  }
  .mo svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .mo rect,
  .mo circle,
  .mo path,
  .mo polyline {
    vector-effect: non-scaling-stroke;
  }

  /* web: bloques que se recolocan */
  .b {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    animation: blk 6s var(--ease-io) infinite;
  }
  .b2 {
    fill: var(--red);
    stroke: var(--red);
  }
  .b1 {
    animation-delay: 0.1s;
  }
  .b2 {
    animation-delay: 0.3s;
  }
  .b3 {
    animation-delay: 0.5s;
  }
  .b4 {
    animation-delay: 0.7s;
  }
  .b5 {
    animation-delay: 0.9s;
  }
  .b6 {
    animation-delay: 1.1s;
  }
  .b7 {
    animation-delay: 1.3s;
  }
  @keyframes blk {
    0%,
    10% {
      transform: translateY(24px) scale(0.92);
      opacity: 0;
    }
    25%,
    80% {
      transform: none;
      opacity: 1;
    }
    95%,
    100% {
      transform: translateY(-14px);
      opacity: 0;
    }
  }

  /* seo */
  .grid {
    stroke: currentColor;
    stroke-opacity: 0.25;
    fill: none;
  }
  .line {
    fill: none;
    stroke: var(--red);
    stroke-width: 5;
    stroke-linejoin: round;
    stroke-dasharray: 700;
    stroke-dashoffset: 700;
    animation: draw 5s var(--ease-io) infinite;
  }
  .dot {
    fill: var(--red);
    animation: pop 5s infinite;
  }
  .tag rect {
    fill: currentColor;
  }
  .tag text {
    fill: var(--ink);
    font: 700 14px var(--font);
  }
  .night .tag text,
  .mo--seo .tag text {
    fill: var(--paper);
  }
  .tag {
    animation: pop 5s infinite;
  }
  @keyframes draw {
    0% {
      stroke-dashoffset: 700;
    }
    55%,
    90% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: -700;
    }
  }
  @keyframes pop {
    0%,
    50% {
      opacity: 0;
    }
    60%,
    90% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* ia */
  .bub {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    animation: bub 6s var(--ease) infinite;
    transform-box: fill-box;
  }
  .bub.q {
    transform-origin: 100% 100%;
  }
  .bub.a {
    fill: var(--red);
    stroke: var(--red);
    transform-origin: 0 0;
    animation-delay: 1s;
  }
  .bub.a2 {
    animation-delay: 1.6s;
  }
  @keyframes bub {
    0%,
    5% {
      transform: scale(0);
      opacity: 0;
    }
    18%,
    85% {
      transform: none;
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  .typing circle {
    fill: currentColor;
    animation: ty 1s infinite;
  }
  .typing circle:nth-child(2) {
    animation-delay: 0.15s;
  }
  .typing circle:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes ty {
    50% {
      transform: translateY(-8px);
    }
  }

  /* auto */
  .wire {
    stroke: currentColor;
    stroke-width: 2;
    stroke-dasharray: 6 6;
    fill: none;
  }
  .node {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .node.hot {
    fill: var(--red);
    stroke: var(--red);
    animation: hot 3s infinite;
  }
  .pulse {
    fill: currentColor;
  }
  @keyframes hot {
    50% {
      opacity: 0.55;
    }
  }

  /* medios */
  .ring {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    animation: ring 4s var(--ease) infinite;
  }
  .r2 {
    animation-delay: 0.5s;
  }
  .r3 {
    animation-delay: 1s;
  }
  .core {
    fill: var(--red);
  }
  @keyframes ring {
    0% {
      transform: scale(0.3);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      transform: scale(1.1);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mo * {
      animation: none !important;
    }
    .line {
      stroke-dashoffset: 0;
    }
  }
</style>
