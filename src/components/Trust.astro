---
import { trust } from "../data/site";

const row = [...trust.references, ...trust.references];
---

<section class="tr" aria-labelledby="tr-title">
  <div class="wrap tr__head">
    <p id="tr-title" class="eyebrow">Han confiado en nosotros</p>
    <p class="tr__note">
      De universidades a farmacias, consultorías y eventos: <strong>más de {trust.pymes} pymes</strong>{" "}
      y proyectos con alcance internacional.
    </p>
  </div>
  <ul class="sr-only">
    {trust.references.map((r) => <li>{r}</li>)}
  </ul>
  <div class="tr__mq" aria-hidden="true">
    <div class="tr__track">
      {
        [0, 1].map(() => (
          <div class="tr__group">
            {row.map((r) => (
              <span class="tr__item">{r}</span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tr {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-block: 1px solid var(--line);
  }
  .tr__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem 2rem;
    margin-bottom: 1.75rem;
  }
  .tr__note {
    color: var(--muted);
    font-size: var(--fs-sm);
    max-width: 52ch;
  }
  .tr__note strong {
    color: var(--ink);
  }
  .tr__mq {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .tr__track {
    display: flex;
    width: max-content;
    animation: tr 60s linear infinite;
  }
  .tr__mq:hover .tr__track {
    animation-play-state: paused;
  }
  .tr__group {
    display: flex;
  }
  .tr__item {
    display: inline-flex;
    align-items: center;
    padding-inline: clamp(1.25rem, 3vw, 2.5rem);
    font-variation-settings: "wdth" 112;
    font-weight: 600;
    font-size: clamp(1.15rem, 0.9rem + 1.1vw, 1.75rem);
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--muted);
    transition: color 0.3s;
    position: relative;
  }
  .tr__item:hover {
    color: var(--ink);
  }
  .tr__item::after {
    content: "";
    position: absolute;
    right: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--red);
    translate: 50% 0;
  }
  @keyframes tr {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tr__track {
      animation: none;
      flex-wrap: wrap;
    }
  }
</style>
