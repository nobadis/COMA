---
import { trust } from "../data/site";
---

<section class="tr" aria-labelledby="tr-title">
  <div class="wrap tr__head">
    <p id="tr-title" class="eyebrow">Han confiado en nosotros</p>
    <p class="tr__note">
      Además de <strong>más de {trust.pymes} pymes</strong>, marcas internacionales, instituciones y
      grandes eventos.
    </p>
  </div>
  <div class="tr__mq">
    <div class="tr__track">
      {
        [0, 1].map((copy) => (
          <ul class="tr__group" aria-hidden={copy ? "true" : undefined}>
            {trust.wall.map((b) => (
              <li class="tr__item">
                {b.logo ? (
                  <span class="tr__logo">
                    <img
                      src={b.logo}
                      alt={copy ? "" : b.name}
                      width={b.w}
                      height={b.h}
                      loading="lazy"
                      decoding="async"
                      style={`--h:${b.size}rem`}
                    />
                    {b.label && <span class="tr__label">{b.label}</span>}
                  </span>
                ) : (
                  <span class="tr__word">{b.name}</span>
                )}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tr {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-block: 1px solid var(--line);
  }
  .tr__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem 2rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .tr__note {
    color: var(--muted);
    font-size: var(--fs-sm);
    max-width: 52ch;
  }
  .tr__note strong {
    color: var(--ink);
  }
  .tr__mq {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .tr__track {
    display: flex;
    width: max-content;
    animation: tr 70s linear infinite;
  }
  .tr__mq:hover .tr__track {
    animation-play-state: paused;
  }
  .tr__group {
    display: flex;
    align-items: center;
  }
  .tr__item {
    display: flex;
    align-items: center;
    height: 3.5rem;
    padding-inline: clamp(1.75rem, 4vw, 3.25rem);
    position: relative;
  }
  .tr__item::after {
    content: "";
    position: absolute;
    right: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--red);
    translate: 50% 0;
  }
  .tr__logo {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    filter: grayscale(1);
    opacity: 0.55;
    transition:
      filter 0.4s var(--ease),
      opacity 0.4s var(--ease);
  }
  .tr__logo img {
    height: var(--h);
    width: auto;
    mix-blend-mode: multiply;
  }
  .tr__label {
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    max-width: 9ch;
    color: var(--ink);
  }
  .tr__word {
    font-variation-settings: "wdth" 112;
    font-weight: 600;
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.2rem);
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--muted);
    opacity: 0.8;
    transition:
      color 0.3s,
      opacity 0.3s;
  }
  @media (hover: hover) {
    .tr__item:hover .tr__logo {
      filter: none;
      opacity: 1;
    }
    .tr__item:hover .tr__word {
      color: var(--ink);
      opacity: 1;
    }
  }
  @keyframes tr {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tr__mq {
      mask-image: none;
    }
    .tr__track {
      animation: none;
      width: auto;
    }
    .tr__group {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 1rem;
    }
    .tr__group[aria-hidden] {
      display: none;
    }
  }
</style>
