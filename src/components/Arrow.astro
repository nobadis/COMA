---
interface Props {
  class?: string;
  diagonal?: boolean;
}
const { class: cls = "arrow", diagonal = false } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  style={diagonal ? "transform: rotate(-45deg)" : undefined}
  ><path d="M4 12h15M13 6l6 6-6 6"></path></svg
>
