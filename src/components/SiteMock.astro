---
import type { Work } from "../data/work";

interface Props {
  work: Work;
}
const { work: w } = Astro.props;
---

<div class={`mk mk--${w.theme}`} aria-hidden="true">
  <div class="mk__bar"><i></i><i></i><i></i><span>{w.domain}</span></div>
  <div class="mk__site">
    <div class="mk__nav">
      <b>{w.brand}</b>
      <span class="mk__links">{w.links.map((l) => <span>{l}</span>)}</span>
    </div>
    <div class="mk__hero">
      <div class="mk__copy">
        <p class="mk__h">{w.headline}</p>
        <p class="mk__p">{w.sub}</p>
        <span class="mk__btn">{w.cta}</span>
      </div>
      <div class="mk__art"><i></i><i></i><i></i></div>
    </div>
    <div class="mk__cards"><i></i><i></i><i></i></div>
  </div>
</div>

<style>
  .mk {
    --bg: #fff;
    --fg: #111;
    --ac: var(--red);
    --soft: #f1f1f1;
    --art1: #ddd;
    --art2: #bbb;
    --hfont: "wdth" 125;
    --hweight: 700;
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg);
    color: var(--fg);
    box-shadow:
      0 40px 80px -30px rgb(0 0 0 / 0.45),
      0 0 0 1px rgb(0 0 0 / 0.06);
    font-size: clamp(9px, 0.9vw, 12px);
    line-height: 1.35;
    user-select: none;
    container-type: inline-size;
  }
  .mk__bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 9px 12px;
    background: rgb(127 127 127 / 0.14);
  }
  .mk__bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgb(127 127 127 / 0.45);
  }
  .mk__bar span {
    margin-left: 10px;
    padding: 2px 10px;
    border-radius: 999px;
    background: rgb(127 127 127 / 0.14);
    font-size: 0.85em;
    opacity: 0.8;
  }
  .mk__site {
    padding: 4% 6% 6%;
    display: grid;
    gap: 7cqw;
  }
  .mk__nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .mk__nav b {
    font-variation-settings: var(--hfont);
    font-weight: var(--hweight);
    letter-spacing: -0.02em;
    font-size: 1.15em;
  }
  .mk__links {
    display: flex;
    gap: 1.2em;
    opacity: 0.7;
  }
  .mk__hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 5cqw;
    align-items: center;
  }
  .mk__copy {
    display: grid;
    gap: 3cqw;
    justify-items: start;
  }
  .mk__h {
    font-variation-settings: var(--hfont);
    font-weight: var(--hweight);
    font-size: 6.2cqw;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .mk__p {
    opacity: 0.7;
    font-size: 2.3cqw;
    max-width: 30ch;
  }
  .mk__btn {
    background: var(--ac);
    color: var(--btnfg, #fff);
    border-radius: 999px;
    padding: 0.9em 1.5em;
    font-weight: 600;
    font-size: 2cqw;
  }
  .mk__art {
    position: relative;
    aspect-ratio: 1;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--art1), var(--art2));
    overflow: hidden;
  }
  .mk__art i {
    position: absolute;
    border-radius: 50%;
    background: var(--ac);
    mix-blend-mode: multiply;
  }
  .mk__art i:nth-child(1) {
    width: 60%;
    height: 60%;
    right: -10%;
    top: -10%;
    opacity: 0.85;
  }
  .mk__art i:nth-child(2) {
    width: 35%;
    height: 35%;
    left: 12%;
    bottom: 12%;
    background: var(--fg);
    opacity: 0.2;
  }
  .mk__art i:nth-child(3) {
    width: 18%;
    height: 18%;
    left: 50%;
    top: 45%;
    background: #fff;
    opacity: 0.7;
  }
  .mk__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3cqw;
  }
  .mk__cards i {
    height: 11cqw;
    border-radius: 10px;
    background: var(--soft);
  }

  /* temas */
  .mk--festival {
    --bg: #0b0b12;
    --fg: #f4f1ff;
    --ac: #c6ff3d;
    --btnfg: #0b0b12;
    --soft: #1b1b28;
    --art1: #ff2e88;
    --art2: #5b2bff;
    --hweight: 800;
  }
  .mk--festival .mk__art i:nth-child(1) {
    mix-blend-mode: screen;
  }
  .mk--festival .mk__h {
    text-transform: uppercase;
  }
  .mk--dental {
    --bg: #f6fbfb;
    --fg: #0f2b33;
    --ac: #12a4a0;
    --soft: #e3f1f1;
    --art1: #c9ecea;
    --art2: #8fd3cf;
    --hweight: 600;
    --hfont: "wdth" 100;
  }
  .mk--farmacia {
    --bg: #fbfdf8;
    --fg: #16301c;
    --ac: #1f9d55;
    --soft: #e8f3ea;
    --art1: #d7efd9;
    --art2: #9fd8a9;
    --hweight: 650;
    --hfont: "wdth" 105;
  }
  .mk--legal {
    --bg: #0f1a2b;
    --fg: #f2ede4;
    --ac: #c8a46a;
    --btnfg: #0f1a2b;
    --soft: #1b2940;
    --art1: #24365a;
    --art2: #0f1a2b;
    --hweight: 500;
    --hfont: "wdth" 85;
  }
  .mk--legal .mk__h {
    font-family: ui-serif, Georgia, "Times New Roman", serif;
    letter-spacing: -0.01em;
  }
  .mk--restaurante {
    --bg: #f7efe4;
    --fg: #3a1d10;
    --ac: #c4512a;
    --soft: #efe1cf;
    --art1: #e7b98f;
    --art2: #b5643a;
    --hweight: 700;
    --hfont: "wdth" 90;
  }
  .mk--restaurante .mk__h {
    font-style: italic;
  }
  .mk--hotel {
    --bg: #f4efe7;
    --fg: #1d2a33;
    --ac: #1d5a7a;
    --soft: #e7dfd2;
    --art1: #9cc7d9;
    --art2: #e9d6b9;
    --hweight: 400;
    --hfont: "wdth" 115;
  }
  .mk--hotel .mk__art i:nth-child(1) {
    background: #f2b45a;
    mix-blend-mode: normal;
    width: 30%;
    height: 30%;
    right: 15%;
    top: 15%;
  }
</style>
