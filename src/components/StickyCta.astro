---
import Arrow from "./Arrow.astro";
import { basePlan } from "../data/pricing";
import { ctaFor } from "../data/site";

const alt = ctaFor(Astro.url.pathname);
---

<div class="sticky-cta" data-sticky-cta>
  {
    alt ? (
      <>
        <span>Te respondemos <strong>personalmente</strong></span>
        <a class="btn btn--red" href={alt.href} tabindex="-1">
          {alt.label} <Arrow />
        </a>
      </>
    ) : (
      <>
        <span>
          Tu web desde <strong>{basePlan.price} €</strong> <span class="muted-sm">{basePlan.suffix}</span>
        </span>
        <a class="btn btn--red" href="/precios/" tabindex="-1">
          Calcula la tuya <Arrow />
        </a>
      </>
    )
  }
</div>

<style>
  .muted-sm {
    color: var(--night-muted);
    font-size: var(--fs-xs);
  }
</style>
