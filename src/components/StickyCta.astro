---
import Arrow from "./Arrow.astro";
import { basePlan } from "../data/pricing";
---

<div class="sticky-cta" data-sticky-cta>
  <span>Tu web desde <strong>{basePlan.price} €</strong> <span class="muted-sm">{basePlan.suffix}</span></span>
  <a class="btn btn--red" href="/precios/" tabindex="-1">Calcula la tuya <Arrow /></a>
</div>

<style>
  .muted-sm {
    color: var(--night-muted);
    font-size: var(--fs-xs);
  }
</style>
