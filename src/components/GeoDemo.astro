---
import Arrow from "./Arrow.astro";

interface Props {
  /** En landings de anuncios se oculta el enlace que saca al visitante. */
  showLink?: boolean;
}
const { showLink = true } = Astro.props;
---

<section class="section geo" id="seo-geo">
  <div class="wrap grid-2 geo__grid">
    <div class="geo__copy">
      <p class="eyebrow" data-reveal>SEO + GEO</p>
      <h2 data-split>Que te encuentren en Google… y en ChatGPT<span class="comma">,</span></h2>
      <p class="lead" data-reveal style="--d:2">
        Tus clientes ya preguntan a la IA qué dentista, qué farmacia o qué asesoría elegir.
        Posicionamos tu pyme para que la respuesta sea tu empresa.
      </p>
      <ul class="geo__points" data-reveal style="--d:3">
        <li><strong>SEO local</strong> y ficha de Google Maps optimizada</li>
        <li><strong>GEO</strong>: visibilidad en ChatGPT, Gemini, Perplexity y Copilot</li>
        <li><strong>Datos estructurados</strong> que buscadores e IA entienden al instante</li>
      </ul>
      {showLink && <a class="btn" href="/seo-geo/" data-reveal style="--d:4">Cómo lo hacemos <Arrow /></a>}
    </div>

    <div class="geo__stack" data-geo>
      <div class="geo__serp" data-reveal style="--d:1">
        <div class="geo__search">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"
            ></circle><path d="M16 16l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            ></path></svg
          >
          <span>dentista en Palma</span>
        </div>
        <div class="geo__result">
          <span class="geo__url">tuclinica.es</span>
          <span class="geo__title">Tu Clínica Dental · Dentista en Palma</span>
          <span class="geo__stars"><b>★★★★★</b> 4,9 · Cita online hoy</span>
        </div>
        <span class="geo__badge">Nº 1 en tu zona</span>
      </div>

      <div class="geo__ai" data-reveal style="--d:3">
        <p class="geo__q">¿Qué clínica dental me recomiendas en Palma?</p>
        <p class="geo__a">
          <span class="geo__spark" aria-hidden="true">✦</span>
          <span data-type
            >Te recomiendo <mark>Tu Clínica Dental</mark>: tiene muy buenas reseñas, cita online y
            atiende en español, inglés y alemán.</span
          >
        </p>
        <span class="geo__tag">Ejemplo ilustrativo</span>
      </div>
    </div>
  </div>
</section>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-geo] [data-type]").forEach((el) => {
    if (reduced) return;
    const html = el.innerHTML;
    const text = el.textContent ?? "";
    el.style.minHeight = `${el.offsetHeight}px`;
    el.textContent = "";
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        let n = 0;
        const tick = () => {
          n += 2;
          el.textContent = text.slice(0, n);
          if (n < text.length) window.setTimeout(tick, 22);
          else el.innerHTML = html;
        };
        window.setTimeout(tick, 900);
      },
      { threshold: 0.6 }
    );
    io.observe(el);
  });
</script>

<style>
  .geo__grid {
    align-items: center;
  }
  .geo__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .geo__points {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .geo__points li {
    padding-left: 1.5rem;
    position: relative;
  }
  .geo__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--red);
  }
  .geo__stack {
    position: relative;
    display: grid;
    gap: 1rem;
    max-width: 32rem;
    width: 100%;
    justify-self: center;
  }
  .geo__serp,
  .geo__ai {
    border-radius: var(--radius);
    padding: 1.25rem;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.35);
    position: relative;
  }
  .geo__serp {
    background: #fff;
    border: 1px solid var(--line);
    transform: rotate(-1.5deg);
  }
  .geo__search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: var(--fs-sm);
    margin-bottom: 1rem;
  }
  .geo__search svg {
    width: 1rem;
    color: var(--muted);
  }
  .geo__result {
    display: grid;
    gap: 0.15rem;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    background: #f7f5f1;
  }
  .geo__url {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .geo__title {
    color: #1a46c4;
    font-weight: 600;
  }
  .geo__stars {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .geo__stars b {
    color: #f2a516;
    font-weight: 400;
  }
  .geo__badge {
    position: absolute;
    top: -0.8rem;
    right: 1rem;
    background: var(--red);
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
  }
  .geo__ai {
    background: var(--ink);
    color: var(--paper);
    transform: rotate(1.2deg) translateX(1.5rem);
    font-size: var(--fs-sm);
  }
  .geo__q {
    justify-self: end;
    background: var(--paper);
    color: var(--ink);
    border-radius: 16px 16px 4px 16px;
    padding: 0.6rem 0.9rem;
    margin: 0 0 0.9rem auto;
    width: fit-content;
    max-width: 85%;
  }
  .geo__a {
    display: flex;
    gap: 0.6rem;
    line-height: 1.5;
  }
  .geo__spark {
    color: var(--red);
    flex: none;
  }
  .geo__a mark {
    background: var(--red);
    color: #fff;
    padding: 0 0.25em;
    border-radius: 4px;
  }
  .geo__tag {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--night-muted);
  }
  @media (max-width: 599px) {
    .geo__ai {
      transform: rotate(1deg);
    }
  }
</style>
