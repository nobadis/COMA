---
import Arrow from "./Arrow.astro";
import { site, trust, years } from "../data/site";
import { basePlan } from "../data/pricing";

const words = ["note", "encuentre", "elija", "venda"];
---

<section class="hero" data-progress="exit">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__glow"></div>
    <div class="hero__comma-wrap">
      <svg class="hero__comma" viewBox="0 0 20 40"
        ><path d="M6 0h14v21c0 10-5 16.5-15 19l-2-5.5c5-1.8 7.5-5.2 8-9.5H6z" fill="currentColor"
        ></path></svg
      >
    </div>
  </div>

  <div class="wrap hero__inner">
    <p class="eyebrow" data-reveal>
      <span
        >Diseño web y marketing<span class="hide-sm"> · Mallorca y toda España</span> · Desde {
          site.since
        }</span
      >
    </p>

    <h1 class="hero__title display" data-split>
      Hacemos que tu empresa se <span class="sr-only">note</span><span
        class="rot"
        data-rotate
        aria-hidden="true">{words.map((w) => <em>{w}</em>)}</span
      ><span class="comma">,</span>
    </h1>

    <div class="hero__row">
      <div class="hero__copy">
        <a href="/precios/" class="price-pill" data-reveal style="--d:2">
          <span class="price-pill__tag">Webs profesionales</span>
          <span class="price-pill__num">desde {basePlan.price} €</span>
          <span class="price-pill__iva">{basePlan.suffix}</span>
          <Arrow />
        </a>
        <p class="lead" data-reveal style="--d:3">
          Diseño web, SEO y posicionamiento en IA, agentes de IA y automatizaciones para autónomos y
          pymes. Tú te dedicas a tu negocio; nosotros, a que se vea.
        </p>
        <div class="hero__ctas" data-reveal style="--d:4">
          <a href="/contacto/?plan=web" class="btn btn--red btn--lg" data-magnetic
            >Quiero mi web por {basePlan.price} € <Arrow /></a
          >
          <a href="#trabajos" class="btn btn--ghost btn--lg">Ver trabajos</a>
        </div>
        <p class="hero__trust" data-reveal style="--d:5">
          <span class="hero__stars" aria-hidden="true">★★★★★</span>
          Confían en nosotros <strong>{trust.headline}</strong> y más de{" "}
          <strong>{trust.pymes} pymes</strong> en Mallorca.
        </p>
      </div>
    </div>
  </div>

  <div class="wrap">
    <dl class="stats">
      <div data-reveal>
        <dt>Años comunicando</dt>
        <dd>+<span data-count={years()}>{years()}</span></dd>
      </div>
      <div data-reveal style="--d:1">
        <dt>Pymes confían en nosotros</dt>
        <dd>+<span data-count={trust.pymes}>{trust.pymes}</span></dd>
      </div>
      <div data-reveal style="--d:2">
        <dt>Tu web, desde</dt>
        <dd>{basePlan.price}<span class="red">€</span></dd>
      </div>
      <div data-reveal style="--d:3">
        <dt>De Mallorca a toda España</dt>
        <dd>{site.spainSince}<span class="red">.</span></dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero {
    --p: 0;
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 7.5rem;
    padding-bottom: clamp(2rem, 4vw, 3rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .hero__glow {
    position: absolute;
    width: 70vmax;
    height: 70vmax;
    right: -25vmax;
    top: -30vmax;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(225 17 45 / 0.22), rgb(225 17 45 / 0) 70%);
    filter: blur(20px);
    animation: drift 18s var(--ease-io) infinite alternate;
  }
  .hero__comma-wrap {
    position: absolute;
    right: clamp(-7rem, -5vw, -2rem);
    top: 7%;
    width: clamp(9rem, 19vw, 19rem);
    transform: translate3d(0, calc(var(--p) * 38vh), 0) rotate(calc(var(--p) * 35deg))
      scale(calc(1 + var(--p) * 0.5));
    will-change: transform;
  }
  .hero__comma {
    width: 100%;
    color: var(--red);
    filter: drop-shadow(0 40px 60px rgb(225 17 45 / 0.3));
    animation:
      comma-in 1.6s var(--ease) 0.2s both,
      float 9s ease-in-out 1.8s infinite alternate;
  }
  @keyframes comma-in {
    from {
      transform: translateY(-40%) rotate(-25deg) scale(0.6);
      opacity: 0;
    }
  }
  @keyframes float {
    to {
      transform: translateY(-18px) rotate(4deg);
    }
  }
  @keyframes drift {
    to {
      transform: translate(-12vmax, 10vmax) scale(1.15);
    }
  }
  @media (max-width: 1099px) {
    .hero__comma-wrap {
      top: 5.5rem;
      right: -2.5rem;
      width: clamp(6.5rem, 18vw, 11rem);
    }
  }
  @media (max-width: 599px) {
    .hero__comma-wrap {
      top: 4.75rem;
      right: -1.75rem;
      width: 5.5rem;
    }
    .hero__inner .eyebrow {
      max-width: 78%;
    }
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    transform: translate3d(0, calc(var(--p) * -12vh), 0);
    opacity: calc(1 - var(--p) * 1.4);
  }
  .hero__title {
    font-size: clamp(2.7rem, 0.6rem + 7.8vw, 9.25rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    max-width: 14ch;
  }

  /* palabras rotativas */
  .rot {
    display: inline-grid;
    vertical-align: bottom;
    overflow: clip;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .rot :global(em) {
    grid-area: 1 / 1;
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
    transform: translateY(105%);
    transition: transform 0.7s var(--ease);
  }
  .rot :global(em.is-on) {
    transform: none;
  }
  .rot :global(em.is-out) {
    transform: translateY(-105%);
  }
  @supports not (-webkit-text-stroke: 1px black) {
    .rot :global(em) {
      color: var(--ink);
    }
  }

  .hero__row {
    display: grid;
    gap: 1.75rem;
  }
  .hero__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    max-width: 46rem;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__trust {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .hero__trust strong {
    color: var(--ink);
  }
  .hero__stars {
    color: var(--red);
    letter-spacing: 0.1em;
    margin-right: 0.35rem;
  }

  .stats {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 800px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stats > div {
    padding: 1.25rem 0 0;
    display: flex;
    flex-direction: column-reverse;
    gap: 0.25rem;
  }
  .stats dt {
    font-size: var(--fs-xs);
    color: var(--muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .stats dd {
    margin: 0;
    font-variation-settings: "wdth" 125;
    font-weight: 600;
    font-size: clamp(1.75rem, 1.2rem + 2vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__glow,
    .hero__comma {
      animation: none;
    }
  }
</style>
