---
import Arrow from "./Arrow.astro";
import Marquee from "./Marquee.astro";
import { site, trust } from "../data/site";
import { basePlan } from "../data/pricing";

const words = ["note", "vea", "encuentre", "elija", "recuerde"];
---

<section class="hero" data-progress="exit">
  <div class="hero__comma" aria-hidden="true">
    <svg viewBox="0 0 20 40"
      ><path d="M6 0h14v21c0 10-5 16.5-15 19l-2-5.5c5-1.8 7.5-5.2 8-9.5H6z" fill="currentColor"></path></svg
    >
  </div>

  <div class="wrap hero__inner">
    <div class="hero__meta" data-reveal>
      <span class="eyebrow">Agencia de diseño web y marketing</span>
      <span class="hero__where hide-sm">Mallorca → toda España · desde {site.since}</span>
    </div>

    <h1 class="hero__title">
      <span class="sr-only">Hacemos que tu empresa se note,</span>
      <span class="hero__lines" aria-hidden="true">
        <span class="ln"><span class="ln__in" data-kinetic>Hacemos que</span></span>
        <span class="ln"><span class="ln__in" data-kinetic>tu empresa se</span></span>
        <span class="ln">
          <span class="ln__in" data-reveal style="--d:3">
            <span class="rot" data-rotate data-nokin>{words.map((w) => <em>{w}<i>,</i></em>)}</span>
          </span>
        </span>
      </span>
    </h1>

    <div class="hero__row">
      <div class="hero__copy" data-reveal style="--d:4">
        <p class="lead">
          Abaratamos el coste de tener una web espectacular para que autónomos y pymes se dediquen a
          lo importante: su negocio. Claras, rápidas y visibles en Google y en la IA.
        </p>
        <p class="hero__trust">
          Confían en nosotros <strong>{trust.headline}</strong> y más de <strong>{trust.pymes} pymes</strong>.
        </p>
      </div>
      <div class="hero__cta" data-reveal style="--d:5">
        <a href="/precios/" class="btn btn--red btn--lg" data-magnetic>
          Calcula tu web desde {basePlan.price} € <Arrow />
        </a>
        <a href="#servicios" class="link-arrow">Qué hacemos</a>
      </div>
    </div>
  </div>

  <Marquee items={["Diseño web", "SEO", "GEO", "Agentes de IA", "Automatización"]} big />
</section>

<style>
  .hero {
    --p: 0;
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 7rem;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__comma {
    position: absolute;
    z-index: -1;
    right: clamp(-4rem, -3vw, -1rem);
    top: 15%;
    width: clamp(8rem, 17vw, 17rem);
    color: var(--red);
    transform: translate3d(0, calc(var(--p) * 30vh), 0) rotate(calc(var(--p) * 40deg - 8deg));
    will-change: transform;
  }
  /* con animaciones guiadas por scroll (CSS), el comma se mueve en el compositor sin JS */
  @supports (animation-timeline: scroll()) {
    .hero__comma {
      transform: none;
      will-change: auto;
      animation: comma-scroll linear both;
      animation-timeline: scroll(root);
      animation-range: 0 100svh;
    }
    @keyframes comma-scroll {
      to {
        transform: translate3d(0, 30vh, 0) rotate(32deg);
      }
    }
  }
  .hero__comma svg {
    animation: comma-in 1.4s var(--ease) 0.3s both;
  }
  @keyframes comma-in {
    from {
      transform: translateY(-60%) rotate(-30deg) scale(0.5);
      opacity: 0;
    }
  }
  .hero__inner {
    display: grid;
    gap: clamp(1.5rem, 3.5vw, 2.75rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  /* el desvanecido ligado al scroll solo en escritorio (en móvil encarece cada fotograma) */
  @media (hover: hover) and (pointer: fine) {
    .hero__inner {
      transform: translate3d(0, calc(var(--p) * -8vh), 0);
      opacity: calc(1 - var(--p) * 1.3);
    }
  }
  .hero__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .hero__where {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hero__title {
    font-size: var(--fs-hero);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variation-settings: normal;
    font-weight: 560;
  }
  .ln {
    display: block;
    white-space: nowrap;
    overflow: clip;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .ln__in {
    display: block;
  }
  .rot {
    display: inline-grid;
    vertical-align: bottom;
    overflow: clip;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
    font-variation-settings:
      "wdth" 125,
      "wght" 800;
  }
  .rot :global(em) {
    grid-area: 1 / 1;
    font-style: normal;
    color: var(--red);
    transform: translateY(135%);
    transition: transform 0.8s var(--ease);
  }
  .rot :global(em.is-on) {
    transform: none;
  }
  .rot :global(em.is-out) {
    transform: translateY(-135%);
  }
  .rot :global(i) {
    font-style: normal;
  }

  .hero__row {
    display: grid;
    gap: 1.5rem;
    align-items: end;
  }
  @media (min-width: 1000px) {
    .hero__row {
      grid-template-columns: 1.2fr 1fr;
      gap: 3rem;
    }
    .hero__cta {
      justify-self: start;
    }
  }
  .hero__copy {
    display: grid;
    gap: 1.25rem;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
  }
  .hero__trust {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .hero__trust strong {
    color: var(--ink);
  }
  @media (max-width: 599px) {
    .hero__comma {
      top: 3.75rem;
      width: 4.75rem;
      right: -1rem;
    }
    .hero__meta .eyebrow {
      max-width: calc(100% - 4.5rem);
    }
  }
</style>
