---
interface Item {
  title: string;
  text: string;
}
interface Props {
  items: Item[];
  title?: string;
}
const { items, title = "Preguntas frecuentes" } = Astro.props;
---

<section class="section faq">
  <div class="wrap faq__grid">
    <div class="faq__head">
      <p class="eyebrow" data-reveal>FAQ</p>
      <h2 data-split>{title}</h2>
    </div>
    <div class="faq__list" data-reveal>
      {
        items.map((q) => (
          <details name="faq">
            <summary>
              <span>{q.title}</span>
              <i aria-hidden="true" />
            </summary>
            <div class="faq__a">
              <p>{q.text}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .faq__grid {
      grid-template-columns: 1fr 1.4fr;
      gap: 5rem;
    }
    .faq__head {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
  }
  .faq__head {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .faq__list details {
    border-top: 1px solid var(--line);
  }
  .faq__list details:last-child {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0;
    cursor: pointer;
    list-style: none;
    font-variation-settings: "wdth" 112;
    font-weight: 600;
    font-size: var(--fs-lg);
    letter-spacing: -0.02em;
    line-height: 1.2;
    transition: color 0.3s;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--red);
  }
  summary i {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }
  summary i::before,
  summary i::after {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: transform 0.5s var(--ease);
  }
  summary i::after {
    transform: rotate(90deg);
  }
  details[open] summary i::after {
    transform: rotate(0deg);
  }
  .faq__a {
    padding-bottom: 1.5rem;
    color: var(--muted);
    max-width: 60ch;
  }
</style>
