---
import Arrow from "./Arrow.astro";
import { sectors } from "../data/site";
---

<section class="section sand sec">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow" data-reveal>Para quién trabajamos</p>
      <h2 data-split>Nos encantan las pymes<span class="comma">,</span></h2>
      <p class="lead" data-reveal style="--d:2">
        Farmacias, clínicas dentales, despachos, consultorías, restaurantes… Si tienes un negocio,
        sabemos cómo hacer que se vea, se encuentre y se elija.
      </p>
    </div>
    <ul class="sec__grid">
      {
        sectors.map((s, i) => (
          <li class="sec__card" data-reveal data-spot style={`--d:${i % 4}`}>
            <span class="sec__n">{String(i + 1).padStart(2, "0")}</span>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ul>
    <div class="sec__cta" data-reveal>
      <p>¿No ves tu sector? Trabajamos con cualquier tipo de negocio.</p>
      <a class="link-arrow" href="/contacto/">Cuéntanos el tuyo <Arrow /></a>
    </div>
  </div>
</section>

<style>
  .sec__grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }
  @media (min-width: 1100px) {
    .sec__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .sec__card {
    --mx: 50%;
    --my: 50%;
    position: relative;
    padding: 1.6rem;
    border-radius: var(--radius);
    background:
      radial-gradient(320px circle at var(--mx) var(--my), rgb(225 17 45 / 0.1), transparent 60%),
      var(--paper);
    border: 1px solid var(--line);
    display: grid;
    gap: 0.6rem;
    align-content: start;
    min-height: 12rem;
    transition:
      transform 0.6s var(--ease),
      border-color 0.4s;
  }
  .sec__card:hover {
    transform: translateY(-6px);
    border-color: rgb(225 17 45 / 0.4);
  }
  .sec__n {
    color: var(--red);
    font-size: var(--fs-xs);
    font-weight: 600;
    margin-bottom: auto;
    padding-bottom: 1.5rem;
  }
  .sec__card h3 {
    font-size: 1.3rem;
  }
  .sec__card p {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .sec__cta {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: center;
  }
</style>
