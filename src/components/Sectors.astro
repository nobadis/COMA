---
import Arrow from "./Arrow.astro";
import { sectors } from "../data/site";
---

<section class="section sec">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow" data-reveal>Para quién trabajamos</p>
      <h2 data-split>Nos encantan las pymes<span class="comma">,</span></h2>
      <p class="lead" data-reveal style="--d:2">
        Farmacias, clínicas dentales, despachos, consultorías, restaurantes… Si tienes un negocio,
        sabemos cómo hacer que se vea, se encuentre y se elija.
      </p>
    </div>
    <ul class="sec__list hs" data-hs>
      {
        sectors.map((s, i) => (
          <li class="sec__row" data-reveal>
            <span class="sec__n">{String(i + 1).padStart(2, "0")}</span>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ul>
    <div class="sec__cta" data-reveal>
      <p>¿No ves tu sector? Trabajamos con cualquier tipo de negocio.</p>
      <a class="link-arrow" href="/contacto/">Cuéntanos el tuyo <Arrow /></a>
    </div>
  </div>
</section>

<style>
  .sec__list {
    border-top: 1px solid var(--ink);
  }
  .sec__row {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
    transition:
      padding 0.5s var(--ease),
      background 0.4s var(--ease),
      color 0.4s var(--ease);
  }
  .sec__n {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--red);
  }
  .sec__row h3 {
    font-size: clamp(1.6rem, 1rem + 2.6vw, 3.5rem);
    letter-spacing: -0.045em;
  }
  .sec__row p {
    grid-column: 2;
    color: var(--muted);
    max-width: 52ch;
  }
  @media (min-width: 900px) {
    .sec__row {
      grid-template-columns: 3rem 1.2fr 1fr;
    }
    .sec__row p {
      grid-column: 3;
    }
  }
  @media (hover: hover) {
    .sec__row:hover {
      padding-inline: 1.25rem;
      background: var(--ink);
      color: var(--paper);
    }
    .sec__row:hover p {
      color: var(--night-muted);
    }
  }
  .sec__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
