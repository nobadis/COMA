---
/**
 * Copiloto del despacho: preguntas en lenguaje normal sobre los datos ya extraídos. Las respuestas
 * son ficticias y están escritas aquí; en producción salen de una consulta a la base de datos.
 */
interface Answer {
  q: string;
  text: string;
  rows?: [string, string][];
  foot?: string;
}
const answers: Answer[] = [
  {
    q: "¿Qué clientes van tarde con el 4.º trimestre?",
    text: "Tres clientes tienen documentación pendiente. Joyería Vidal es el más retrasado.",
    rows: [
      ["Joyería Vidal", "9 facturas · 61 %"],
      ["Bar Es Pla", "2 facturas · 82 %"],
      ["Fontanería Coll", "1 factura · 94 %"],
    ],
    foot: "¿Les envío un recordatorio por WhatsApp ahora?",
  },
  {
    q: "¿Qué retenciones van al 111 este trimestre?",
    text: "Cuatro facturas de profesionales con retención del 15 %.",
    rows: [
      ["Clínica Sant Jaume · Marta Pons", "90,00 €"],
      ["Estudio Ramis · Notaría Vives", "135,00 €"],
      ["Panadería Coll · Gestoría laboral", "42,00 €"],
      ["Total a declarar", "267,00 €"],
    ],
  },
  {
    q: "¿Cuánto IVA soportado lleva Panadería Coll?",
    text: "1.284,36 € en 47 facturas este trimestre, un 12 % más que el anterior. El 38 % viene de un solo proveedor de harina.",
  },
  {
    q: "Prepara el resumen del trimestre para Clínica Sant Jaume",
    text: "Hola, Laura: este trimestre habéis facturado 48.200 € y registrado 9.830 € de gastos. El IVA estimado a ingresar es de 1.250 €. Todo está completo; os enviamos los modelos para firmar la semana que viene.",
    foot: "Borrador listo para revisar y enviar",
  },
];
---

<div class="cp" data-copilot>
  <div class="cp__qs" role="group" aria-label="Preguntas de ejemplo">
    {
      answers.map((a, i) => (
        <button type="button" class="cp__q" data-q={i} aria-pressed={i === 0 ? "true" : "false"}>
          {a.q}
        </button>
      ))
    }
  </div>
  <div class="cp__box">
    <div class="cp__ask">
      <span class="cp__icon" aria-hidden="true">?</span>
      <span data-cp-ask>{answers[0].q}</span>
    </div>
    {
      answers.map((a, i) => (
        <div class="cp__ans" data-a={i} hidden={i !== 0} aria-live="polite">
          <p class="cp__text">{a.text}</p>
          {a.rows && (
            <dl class="cp__rows">
              {a.rows.map(([k, v]) => (
                <div class:list={[{ "is-total": k.startsWith("Total") }]}>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          )}
          {a.foot && <p class="cp__foot">→ {a.foot}</p>}
        </div>
      ))
    }
    <span class="cp__tag">Datos ficticios</span>
  </div>
</div>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-copilot]").forEach((cp) => {
    const qs = Array.from(cp.querySelectorAll<HTMLButtonElement>("[data-q]"));
    const ask = cp.querySelector<HTMLElement>("[data-cp-ask]");
    const answers = Array.from(cp.querySelectorAll<HTMLElement>("[data-a]"));
    let timers: number[] = [];
    const show = (i: number) => {
      timers.forEach(clearTimeout);
      timers = [];
      qs.forEach((q) => q.setAttribute("aria-pressed", String(q.dataset.q === String(i))));
      const text = qs[i].textContent?.trim() ?? "";
      answers.forEach((a) => (a.hidden = true));
      if (reduced || !ask) {
        if (ask) ask.textContent = text;
        answers[i].hidden = false;
        return;
      }
      // la pregunta se escribe y la respuesta entra después, como en un chat
      ask.textContent = "";
      const n = text.length;
      for (let k = 1; k <= n; k++) timers.push(window.setTimeout(() => (ask.textContent = text.slice(0, k)), k * 18));
      cp.classList.add("is-thinking");
      timers.push(
        window.setTimeout(() => {
          cp.classList.remove("is-thinking");
          answers[i].hidden = false;
        }, n * 18 + 650)
      );
    };
    qs.forEach((q) => q.addEventListener("click", () => show(Number(q.dataset.q))));
  });
</script>

<style>
  .cp {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 960px) {
    .cp {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 2rem;
      align-items: start;
    }
  }
  .cp__qs {
    display: grid;
    gap: 0.5rem;
  }
  .cp__q {
    text-align: left;
    padding: 1rem 1.15rem;
    border: 1px solid var(--line);
    background: transparent;
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
    transition:
      background 0.35s var(--ease),
      color 0.35s var(--ease),
      border-color 0.35s var(--ease),
      padding 0.4s var(--ease);
  }
  .cp__q:hover {
    border-color: var(--ink);
    padding-left: 1.5rem;
  }
  .cp__q[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .cp__box {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    min-height: 22rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--ink);
    color: var(--paper);
    --line: var(--night-line);
    --muted: var(--night-muted);
  }
  .cp__ask {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-weight: 600;
    min-height: 3.2rem;
  }
  .cp__icon {
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--red);
    display: grid;
    place-items: center;
    font-weight: 800;
  }
  .is-thinking .cp__icon {
    animation: cp-pulse 0.9s ease-in-out infinite;
  }
  @keyframes cp-pulse {
    50% {
      box-shadow: 0 0 0 8px rgb(225 17 45 / 0.2);
    }
  }
  .cp__ans {
    display: grid;
    gap: 1rem;
    animation: cp-in 0.6s var(--ease);
  }
  .cp__ans[hidden] {
    display: none;
  }
  @keyframes cp-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .cp__text {
    font-size: var(--fs-lg);
    line-height: 1.45;
  }
  .cp__rows > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
  .cp__rows > div.is-total dd {
    color: #ff6b7f;
  }
  .cp__rows dt {
    color: var(--muted);
  }
  .cp__rows dd {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .cp__foot {
    color: #3ad07a;
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .cp__tag {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .cp__ans,
    .is-thinking .cp__icon {
      animation: none;
    }
  }
</style>
