---
/**
 * Portada de /despachos/: la bandeja del despacho recibe documentos por cualquier canal y cada
 * uno pasa solo de «Leyendo» a «Listo» con su cuenta contable. Animación por clases (sin librerías).
 */
const docs = [
  { src: "Email", who: "Fontanería Coll", what: "F-2026/0418", acc: "629 · Otros servicios", total: "499,00 €" },
  { src: "WhatsApp", who: "Bar Es Pla", what: "Ticket gasolinera", acc: "628 · Suministros", total: "60,00 €" },
  { src: "Foto", who: "Clínica Sant Jaume", what: "Alquiler octubre", acc: "621 · Arrendamientos", total: "1.210,00 €" },
  { src: "PDF", who: "Estudio Ramis", what: "Honorarios abogado", acc: "623 · Profesionales", total: "636,00 €" },
  { src: "Drive", who: "Panadería Coll", what: "Factura de harina", acc: "600 · Compras", total: "842,15 €" },
];
---

<div class="ib" data-inbox>
  <div class="ib__top">
    <span class="ib__dot" aria-hidden="true"></span>
    <span>
      <strong>Bandeja del despacho</strong>
      <small>Documentos de clientes · hoy</small>
    </span>
    <span class="ib__tag">Ejemplo ilustrativo</span>
  </div>
  <ol class="ib__list">
    {
      docs.map((d) => (
        <li class="ib__row">
          <span class="ib__src">{d.src}</span>
          <span class="ib__main">
            <strong>{d.who}</strong>
            <small>{d.what}</small>
          </span>
          <span class="ib__state">
            <span class="ib__reading">Leyendo…</span>
            <span class="ib__acc">{d.acc}</span>
          </span>
          <span class="ib__total">{d.total}</span>
        </li>
      ))
    }
  </ol>
  <div class="ib__foot">
    <span><b data-inbox-count>{docs.length}</b> procesadas solas</span>
    <span class="ib__zero">Tecleadas a mano: <b>0</b></span>
  </div>
</div>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-inbox]").forEach((box) => {
    const rows = Array.from(box.querySelectorAll<HTMLElement>(".ib__row"));
    const count = box.querySelector<HTMLElement>("[data-inbox-count]");
    if (reduced) return;
    let total = 0;
    let timers: number[] = [];
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const play = () => {
      timers.forEach(clearTimeout);
      timers = [];
      rows.forEach((r) => r.classList.remove("is-in", "is-done"));
      let t = 300;
      rows.forEach((r) => {
        at(t, () => r.classList.add("is-in"));
        at(t + 1100, () => {
          r.classList.add("is-done");
          total += 1;
          if (count) count.textContent = String(total);
        });
        t += 700;
      });
      at(t + 3800, play);
    };
    if (count) count.textContent = "0";
    const io = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          io.disconnect();
          box.classList.add("is-live");
          play();
        }
      },
      { threshold: 0.3 }
    );
    io.observe(box);
    window.addEventListener("pagehide", () => timers.forEach(clearTimeout));
  });
</script>

<style>
  .ib {
    background: var(--ink);
    color: var(--paper);
    border-radius: 22px;
    padding: 0.75rem;
    box-shadow:
      0 50px 100px -40px rgb(0 0 0 / 0.45),
      0 0 0 1px rgb(255 255 255 / 0.04) inset;
    width: 100%;
    max-width: 34rem;
    justify-self: center;
    transform: rotate(-1.2deg);
    font-size: var(--fs-sm);
  }
  .ib__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.5rem 0.9rem;
    border-bottom: 1px solid var(--night-line);
    line-height: 1.3;
  }
  .ib__top small {
    display: block;
    color: var(--night-muted);
  }
  .ib__dot {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--red);
    position: relative;
    flex: none;
  }
  .ib__dot::after {
    content: "";
    position: absolute;
    inset: 0.7rem 0.62rem;
    border: 2px solid #fff;
    border-top-width: 0.45rem;
    border-radius: 2px;
  }
  .ib__tag {
    margin-left: auto;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--night-muted);
    border: 1px solid var(--night-line);
    border-radius: 999px;
    padding: 0.25rem 0.55rem;
    white-space: nowrap;
  }
  .ib__list {
    display: grid;
    gap: 0.45rem;
    padding: 0.85rem 0.25rem;
    min-height: 19.5rem;
    align-content: start;
  }
  .ib__row {
    display: grid;
    grid-template-columns: 5.4rem 1fr auto;
    grid-template-areas:
      "src main total"
      "src state state";
    align-items: center;
    gap: 0.2rem 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 12px;
    background: var(--night-2);
    border: 1px solid var(--night-line);
    transition:
      opacity 0.5s var(--ease),
      transform 0.7s var(--ease),
      border-color 0.5s var(--ease);
  }
  .ib__src {
    grid-area: src;
    justify-self: start;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--night-line);
    color: var(--night-muted);
  }
  .ib__main {
    grid-area: main;
    display: grid;
    min-width: 0;
    line-height: 1.25;
  }
  .ib__main strong,
  .ib__main small {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ib__main small {
    color: var(--night-muted);
  }
  .ib__state {
    grid-area: state;
    display: grid;
    justify-items: start;
    font-size: 0.72rem;
  }
  .ib__state > span {
    grid-area: 1 / 1;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
    transition:
      opacity 0.4s var(--ease),
      transform 0.5s var(--ease);
  }
  .ib__reading {
    color: #ffb35c;
    background: rgb(255 179 92 / 0.1);
    opacity: 0;
  }
  .ib__acc {
    color: #3ad07a;
    background: rgb(58 208 122 / 0.1);
  }
  .ib__acc::before {
    content: "✓ ";
  }
  .ib__total {
    grid-area: total;
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .ib__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.8rem 0.6rem 0.4rem;
    border-top: 1px solid var(--night-line);
    color: var(--night-muted);
  }
  .ib__foot b {
    color: var(--paper);
    font-variant-numeric: tabular-nums;
  }
  .ib__zero b {
    color: var(--red);
  }

  /* estados animados (solo con JS y movimiento permitido) */
  .is-live .ib__row {
    opacity: 0;
    transform: translateY(-14px) scale(0.97);
  }
  .is-live .ib__row.is-in {
    opacity: 1;
    transform: none;
    border-color: rgb(255 179 92 / 0.4);
  }
  .is-live .ib__row.is-in .ib__reading {
    opacity: 1;
    animation: ib-blink 0.9s ease-in-out infinite;
  }
  .is-live .ib__acc {
    opacity: 0;
    transform: translateY(6px);
  }
  .is-live .ib__row.is-done {
    border-color: var(--night-line);
  }
  .is-live .ib__row.is-done .ib__reading {
    opacity: 0;
    animation: none;
  }
  .is-live .ib__row.is-done .ib__acc {
    opacity: 1;
    transform: none;
  }
  @keyframes ib-blink {
    50% {
      opacity: 0.45;
    }
  }
</style>
