---
/**
 * Panel del cierre trimestral: barras de documentación por cliente y un recordatorio automático
 * que cambia el estado de un cliente de «Faltan 2» a «Completo». Datos ficticios.
 */
const clients = [
  { name: "Panadería Coll", pct: 100, state: "Completo", tone: "ok" },
  { name: "Clínica Sant Jaume", pct: 100, state: "Revisado", tone: "ok" },
  { name: "Bar Es Pla", pct: 82, state: "Faltan 2", tone: "warn", live: true },
  { name: "Fontanería Coll", pct: 94, state: "Falta 1", tone: "warn" },
  { name: "Estudio Ramis", pct: 100, state: "Completo", tone: "ok" },
  { name: "Joyería Vidal", pct: 61, state: "Recordatorio enviado", tone: "info" },
];
const done = clients.filter((c) => c.pct === 100).length;
---

<div class="cb" data-board>
  <div class="cb__top">
    <span>
      <strong>Cierre 4.º trimestre</strong>
      <small>Documentación de clientes</small>
    </span>
    <span class="cb__kpi"><b data-board-done>{done}</b>/{clients.length} completos</span>
  </div>
  <ul class="cb__list">
    {
      clients.map((c) => (
        <li class:list={["cb__row", { "is-live": c.live }]} style={`--p:${c.pct}%`} data-board-live={c.live ? "" : undefined}>
          <span class="cb__name">{c.name}</span>
          <span class="cb__bar" aria-hidden="true">
            <i />
          </span>
          <span class:list={["cb__state", `cb__state--${c.tone}`]} data-board-state>
            {c.state}
          </span>
        </li>
      ))
    }
  </ul>
  <div class="cb__toast" data-board-toast aria-hidden="true">
    <span class="cb__wa">WhatsApp · automático</span>
    <p>Hola, Joan. Para cerrar el trimestre nos faltan 2 facturas de octubre. Puedes enviarlas aquí mismo, con una foto vale. ¡Gracias!</p>
  </div>
  <span class="cb__tag">Ejemplo ilustrativo</span>
</div>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-board]").forEach((board) => {
    const live = board.querySelector<HTMLElement>("[data-board-live]");
    const state = live?.querySelector<HTMLElement>("[data-board-state]");
    const toast = board.querySelector<HTMLElement>("[data-board-toast]");
    const doneEl = board.querySelector<HTMLElement>("[data-board-done]");
    if (!live || !state || !toast || !doneEl) return;
    const baseDone = Number(doneEl.textContent);
    let timers: number[] = [];
    const at = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const setState = (text: string, tone: string) => {
      state.textContent = text;
      state.className = `cb__state cb__state--${tone}`;
    };
    const play = () => {
      timers.forEach(clearTimeout);
      timers = [];
      live.style.setProperty("--p", "82%");
      setState("Faltan 2", "warn");
      doneEl.textContent = String(baseDone);
      toast.classList.remove("is-on");
      at(1600, () => {
        toast.classList.add("is-on");
        setState("Recordatorio enviado", "info");
      });
      at(4600, () => {
        toast.classList.remove("is-on");
        live.style.setProperty("--p", "100%");
        setState("Completo", "ok");
        doneEl.textContent = String(baseDone + 1);
      });
      at(9500, play);
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          io.disconnect();
          board.classList.add("is-in");
          if (!reduced) at(900, play);
        }
      },
      { threshold: 0.35 }
    );
    io.observe(board);
    window.addEventListener("pagehide", () => timers.forEach(clearTimeout));
  });
</script>

<style>
  .cb {
    position: relative;
    background: var(--night-2);
    border: 1px solid var(--night-line);
    border-radius: 22px;
    padding: clamp(1rem, 2.5vw, 1.5rem);
    font-size: var(--fs-sm);
    width: 100%;
    max-width: 36rem;
    justify-self: center;
    box-shadow: 0 50px 100px -40px rgb(0 0 0 / 0.7);
  }
  .cb__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--night-line);
    line-height: 1.3;
  }
  .cb__top small {
    display: block;
    color: var(--night-muted);
  }
  .cb__kpi {
    color: var(--night-muted);
  }
  .cb__kpi b {
    color: var(--paper);
    font-variation-settings: "wdth" 125;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .cb__list {
    display: grid;
    padding-top: 0.5rem;
  }
  .cb__row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "name state"
      "bar bar";
    align-items: center;
    gap: 0.45rem 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--night-line);
  }
  @media (min-width: 560px) {
    .cb__row {
      grid-template-columns: 9.5rem 1fr 10rem;
      grid-template-areas: "name bar state";
    }
  }
  .cb__name {
    grid-area: name;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cb__bar {
    grid-area: bar;
    height: 6px;
    border-radius: 999px;
    background: rgb(239 236 228 / 0.1);
    overflow: hidden;
  }
  .cb__bar i {
    display: block;
    height: 100%;
    width: var(--p);
    background: var(--paper);
    border-radius: inherit;
    transition: width 1.2s var(--ease);
  }
  .cb__row.is-live .cb__bar i {
    background: var(--red);
  }
  .js .cb:not(.is-in) .cb__bar i {
    width: 0;
  }
  .cb__state {
    grid-area: state;
    justify-self: end;
    font-size: 0.72rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    white-space: nowrap;
    transition:
      color 0.4s,
      background 0.4s;
  }
  .cb__state--ok {
    color: #3ad07a;
    background: rgb(58 208 122 / 0.1);
  }
  .cb__state--warn {
    color: #ffb35c;
    background: rgb(255 179 92 / 0.1);
  }
  .cb__state--info {
    color: #8fb8ff;
    background: rgb(143 184 255 / 0.1);
  }
  .cb__toast {
    position: absolute;
    right: clamp(-1rem, -2vw, 0rem);
    bottom: 2.5rem;
    width: min(19rem, 86%);
    padding: 0.8rem 0.95rem;
    background: var(--paper);
    color: var(--ink);
    border-radius: 16px 16px 4px 16px;
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.6);
    line-height: 1.4;
    opacity: 0;
    transform: translateY(14px) scale(0.96);
    transform-origin: bottom right;
    transition:
      opacity 0.45s var(--ease),
      transform 0.6s var(--ease);
    pointer-events: none;
  }
  .cb__toast.is-on {
    opacity: 1;
    transform: none;
  }
  .cb__wa {
    display: block;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #128c4a;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .cb__tag {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--night-muted);
  }
</style>
