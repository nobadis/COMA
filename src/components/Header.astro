---
import Logo from "./Logo.astro";
import Arrow from "./Arrow.astro";
import { nav, navServices, site } from "../data/site";
import { basePlan } from "../data/pricing";

const mobile = [...nav.filter((n) => n.href !== "/#servicios"), ...navServices];
const path = Astro.url.pathname;
const current = (href: string) =>
  href === "/" ? path === "/" : href.startsWith("/#") ? false : path.startsWith(href);
---

<header class="hdr" data-header>
  <div class="hdr__bar wrap">
    <a href="/" class="hdr__logo" aria-label="COMA, ir al inicio"><Logo /></a>

    <nav class="hdr__nav" aria-label="Principal">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href) ? "page" : undefined}>
                <span data-text={item.label}>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/precios/" class="hdr__cta">
      <span>Web desde {basePlan.price} €</span>
      <Arrow />
    </a>

    <button class="hdr__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span class="hdr__label" aria-hidden="true">Menú</span>
      <span class="sr-only">Abrir menú</span>
      <span class="hdr__burger" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="menu" id="menu" data-menu hidden>
    <nav class="menu__inner wrap" aria-label="Menú móvil">
      <ul class="menu__list">
        {
          mobile.map((item, i) => (
            <li style={`--i:${i}`}>
              <span class="menu__n">{String(i + 1).padStart(2, "0")}</span>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
      <div class="menu__foot">
        <a class="btn btn--red btn--lg" href="/precios/">Calcula tu web desde {basePlan.price} € <Arrow /></a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span>{site.address.street} · {site.address.city}</span>
      </div>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: transform 0.6s var(--ease);
    color: var(--ink);
  }
  .hdr::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
    z-index: -1;
  }
  .hdr.is-stuck::before {
    opacity: 0.94;
  }
  .hdr.on-dark {
    color: var(--paper);
  }
  .hdr.on-dark::before {
    background: var(--night);
    border-color: var(--night-line);
  }
  .hdr.is-hidden:not(.is-open) {
    transform: translateY(-101%);
  }
  .hdr.is-open {
    color: var(--paper);
  }
  .hdr.is-open::before {
    opacity: 0;
  }
  .hdr__bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4.5rem;
  }
  .hdr__logo {
    text-decoration: none;
    margin-right: auto;
    position: relative;
    z-index: 2;
  }
  .hdr__nav ul {
    display: none;
    gap: 2rem;
  }
  .hdr__nav a {
    position: relative;
    display: block;
    overflow: hidden;
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    padding-block: 0.25rem;
  }
  .hdr__nav a span {
    display: block;
    transition: transform 0.5s var(--ease);
  }
  .hdr__nav a span::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 100%;
    color: var(--red);
  }
  .hdr__nav a:hover span {
    transform: translateY(-100%);
  }
  .hdr__nav a[aria-current="page"]::before {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--red);
  }
  .hdr__cta {
    display: none;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1.1rem;
    background: var(--red);
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.4s var(--ease);
  }
  .hdr__cta:hover {
    background: var(--ink);
  }
  .on-dark .hdr__cta:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .hdr__toggle {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 0;
    background: none;
    cursor: pointer;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.5rem 0;
  }
  .hdr__burger {
    display: grid;
    gap: 6px;
    width: 26px;
  }
  .hdr__burger i {
    display: block;
    height: 2px;
    background: currentColor;
    transition: transform 0.5s var(--ease);
  }
  .hdr.is-open .hdr__burger i:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .hdr.is-open .hdr__burger i:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
  @media (min-width: 1000px) {
    .hdr__nav ul {
      display: flex;
    }
    .hdr__cta {
      display: inline-flex;
    }
    .hdr__toggle {
      display: none;
    }
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--night);
    color: var(--paper);
    display: flex;
    align-items: flex-end;
    padding-block: 6rem 2rem;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.8s var(--ease-io);
  }
  .menu[hidden] {
    display: none;
  }
  .hdr.is-open .menu {
    clip-path: inset(0);
  }
  .menu__inner {
    display: grid;
    gap: 2rem;
    max-height: 100%;
    overflow-y: auto;
  }
  .menu__list li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    border-bottom: 1px solid var(--night-line);
    overflow: hidden;
  }
  .menu__n {
    font-size: var(--fs-xs);
    color: var(--red);
    font-weight: 700;
    min-width: 1.5rem;
  }
  .menu__list a {
    display: block;
    font-variation-settings: "wdth" 125;
    font-weight: 700;
    font-size: clamp(1.7rem, 7.5vw, 3rem);
    letter-spacing: -0.04em;
    line-height: 1.25;
    text-decoration: none;
    transform: translateY(110%);
    transition:
      transform 0.8s var(--ease),
      color 0.3s;
    transition-delay: calc(var(--i) * 45ms + 250ms);
  }
  .menu__list a:hover {
    color: var(--red);
  }
  .hdr.is-open .menu__list a {
    transform: none;
  }
  .menu__foot {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    color: var(--night-muted);
    font-size: var(--fs-sm);
  }
  .menu__foot .btn {
    margin-bottom: 0.75rem;
    color: #fff;
  }
</style>
