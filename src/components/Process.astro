---
interface Step {
  title: string;
  text: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  steps: Step[];
}
const { eyebrow = "Cómo trabajamos", title, steps } = Astro.props;
---

<section class="section pr">
  <div class="wrap pr__grid">
    <div class="pr__head">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h2 data-split>{title}</h2>
    </div>
    <ol class="pr__list">
      {
        steps.map((s, i) => (
          <li class="pr__item" style={`--i:${i}`}>
            <span class="pr__n">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .pr__grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1000px) {
    .pr__grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }
    .pr__head {
      position: sticky;
      top: 8rem;
    }
  }
  .pr__head {
    display: grid;
    gap: 1.5rem;
  }
  .pr__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .pr__item {
    position: sticky;
    top: calc(6.5rem + var(--i) * 1.25rem);
    box-shadow: 0 -20px 40px -30px rgb(0 0 0 / 0.25);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
    display: grid;
    gap: 0.75rem;
    align-content: start;
    min-height: clamp(14rem, 34vh, 20rem);
    grid-template-columns: auto 1fr;
    column-gap: clamp(1rem, 3vw, 2.5rem);
    transition:
      transform 0.6s var(--ease),
      box-shadow 0.6s var(--ease);
  }
  .pr__item > :not(.pr__n) {
    grid-column: 2;
  }
  .pr__n {
    grid-row: 1 / span 2;
    font-variation-settings: "wdth" 125;
    font-weight: 600;
    font-size: clamp(3rem, 2rem + 4vw, 6rem);
    line-height: 0.85;
    color: var(--red);
    letter-spacing: -0.05em;
  }
  .pr__item h3 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
  }
  .pr__item:nth-child(even) {
    background: var(--ink);
    color: var(--paper);
    --muted: var(--night-muted);
  }
  .pr__item p {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
</style>
