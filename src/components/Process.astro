---
interface Step {
  title: string;
  text: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  steps: Step[];
}
const { eyebrow = "Cómo trabajamos", title, steps } = Astro.props;
---

<section class="pr night" data-hscroll data-dark>
  <div class="pr__sticky">
    <div class="wrap pr__head">
      <div>
        <p class="eyebrow" data-reveal>{eyebrow}</p>
        <h2 data-split>{title}</h2>
      </div>
      <p class="pr__hint" aria-hidden="true">Sigue bajando <span>→</span></p>
    </div>
    <div class="pr__viewport">
      <ol class="pr__track" data-hscroll-track data-hs>
        {
          steps.map((s, i) => (
            <li class="pr__item" style={`--i:${i}`}>
              <span class="pr__n" aria-hidden="true">0{i + 1}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="wrap pr__bar" aria-hidden="true"><i></i></div>
  </div>
</section>

<style>
  .pr {
    --p: 0;
    position: relative;
    padding-block: clamp(4rem, 8vw, 6rem);
  }
  .pr__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .pr__head h2 {
    max-width: 16ch;
  }
  .pr__hint {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--night-muted);
  }
  .pr__item {
    display: grid;
    gap: 1rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--line);
    width: min(100% - 2 * var(--gutter), var(--max));
    margin-inline: auto;
  }
  .pr__n {
    font-variation-settings: "wdth" 125;
    font-weight: 800;
    font-size: clamp(4rem, 14vw, 9rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--red);
  }
  .pr__item h3 {
    margin-bottom: 0.6rem;
  }
  .pr__item p {
    color: var(--muted);
    max-width: 36ch;
  }
  .pr__bar {
    display: none;
  }
  @media (min-width: 900px) {
    .pr {
      padding-block: 0;
    }
    .pr__sticky {
      position: sticky;
      top: 0;
      height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0;
      overflow: hidden;
      padding-top: 4.5rem;
    }
    .pr__hint {
      display: block;
    }
    .pr__viewport {
      overflow: hidden;
    }
    .pr__track {
      display: flex;
      gap: clamp(2rem, 5vw, 5rem);
      width: max-content;
      padding-inline: var(--gutter);
      will-change: transform;
    }
    .pr__item {
      width: min(34rem, 42vw);
      margin: 0;
      flex: none;
      gap: 2rem;
      padding-top: 2rem;
      align-content: start;
    }
    .pr__bar {
      display: block;
      margin-top: clamp(1.5rem, 4vh, 3rem);
      height: 2px;
      background: var(--line);
      position: relative;
    }
    .pr__bar i {
      position: absolute;
      inset: 0;
      background: var(--red);
      transform-origin: 0 50%;
      transform: scaleX(var(--p));
    }
  }
  /* móvil: carrusel con imán, se desliza con el pulgar */
  @media (max-width: 899px) {
    .pr__viewport {
      overflow: hidden;
    }
    .pr__track {
      display: flex;
      gap: 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-inline: var(--gutter);
      padding-bottom: 0.5rem;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    .pr__track::-webkit-scrollbar {
      display: none;
    }
    .pr__item {
      flex: 0 0 78%;
      width: auto;
      margin: 0;
      scroll-snap-align: start;
      border: 1px solid var(--line);
      padding: 1.25rem;
      align-content: start;
      min-height: 15rem;
    }
    .pr__hint span {
      display: inline-block;
      animation: nudge 1.4s var(--ease) infinite;
    }
  }
  @keyframes nudge {
    50% {
      transform: translateX(6px);
    }
  }
</style>
