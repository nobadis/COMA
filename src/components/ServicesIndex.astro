---
import Arrow from "./Arrow.astro";
import { services } from "../data/services";

const rows = [
  ...services.map((s) => ({ href: `/${s.slug}/`, title: s.label, tagline: s.tagline, text: s.summary, tags: s.tags.slice(0, 4) })),
  {
    href: "/kit-digital/",
    title: "Kit Digital",
    tagline: "Digitalízate con ayudas.",
    text: "Te acompañamos en todo el proceso: requisitos, solución, implantación y justificación. Sin letra pequeña.",
    tags: ["Web", "Ecommerce", "Redes", "Ciberseguridad"],
  },
];
const extras = [
  "Tiendas online",
  "Google y Meta Ads",
  "Redes sociales",
  "Vídeo y televisión",
  "Radio y prensa",
  "Diseño gráfico",
  "Email marketing",
  "Analítica",
];
---

<section class="section night svc" id="servicios" data-dark>
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow" data-reveal>Lo que hacemos</p>
      <h2 data-split>Todo lo que tu empresa necesita para crecer<span class="comma">,</span></h2>
      <p class="lead" data-reveal style="--d:2">
        Una web que enamora, que te encuentren en Google y en la IA, y procesos que trabajan solos.
        Todo con un mismo equipo y precios pensados para autónomos y pymes.
      </p>
    </div>

    <ol class="svc__list">
      {
        rows.map((r, i) => (
          <li data-reveal style={`--d:${i}`}>
            <a class="svc__row" href={r.href} data-spot>
              <span class="svc__num">0{i + 1}</span>
              <span class="svc__main">
                <span class="svc__title">{r.title}</span>
                <span class="svc__tagline">{r.tagline}</span>
              </span>
              <span class="svc__text">{r.text}</span>
              <span class="svc__go" aria-hidden="true">
                <Arrow />
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="svc__extras" data-reveal>
      <p class="muted">Y además:</p>
      <ul class="chips">
        {extras.map((e) => <li class="chip">{e}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .svc__list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .svc__list li {
    border-bottom: 1px solid var(--line);
  }
  .svc__row {
    --mx: 50%;
    --my: 50%;
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.5rem 1.25rem;
    align-items: center;
    padding: clamp(1.5rem, 3vw, 2.5rem) 0.25rem;
    text-decoration: none;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-sm);
    transition: padding 0.6s var(--ease);
  }
  .svc__row::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(500px circle at var(--mx) var(--my), rgb(225 17 45 / 0.22), transparent 60%);
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }
  .svc__row:hover::before {
    opacity: 1;
  }
  @media (hover: hover) {
    .svc__row:hover {
      padding-inline: 1.25rem;
    }
  }
  .svc__num {
    align-self: start;
    font-size: var(--fs-xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    padding-top: 0.6em;
  }
  .svc__main {
    display: grid;
    gap: 0.35rem;
  }
  .svc__title {
    font-variation-settings: "wdth" 125;
    font-weight: 600;
    font-size: clamp(1.75rem, 1rem + 3.4vw, 4.25rem);
    letter-spacing: -0.04em;
    line-height: 1;
    transition: color 0.4s var(--ease);
  }
  .svc__row:hover .svc__title {
    color: var(--red);
  }
  .svc__tagline {
    color: var(--muted);
  }
  .svc__text {
    grid-column: 2 / -1;
    color: var(--muted);
    max-width: 46ch;
    font-size: var(--fs-sm);
  }
  .svc__go {
    grid-row: 1;
    grid-column: 3;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    transition:
      background 0.4s var(--ease),
      border-color 0.4s var(--ease),
      transform 0.6s var(--ease);
  }
  .svc__go :global(.arrow) {
    width: 1.25rem;
    transform: rotate(-45deg);
    transition: transform 0.6s var(--ease);
  }
  .svc__row:hover .svc__go {
    background: var(--red);
    border-color: var(--red);
  }
  .svc__row:hover .svc__go :global(.arrow) {
    transform: rotate(0deg);
  }
  @media (min-width: 900px) {
    .svc__row {
      grid-template-columns: 4rem 1.2fr 1fr auto;
    }
    .svc__text {
      grid-column: 3;
      grid-row: 1;
    }
    .svc__go {
      grid-column: 4;
    }
  }
  .svc__extras {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }
</style>
