---
import { site } from "../data/site";

const items = [
  { y: String(site.since), t: "Nacemos editando revistas", d: "Contar historias de empresas de Mallorca en papel fue el primer capítulo." },
  { y: "Radio", t: "Programas y campañas en antena", d: "Aprendimos a comunicar con voz, ritmo y cercanía." },
  { y: "TV", t: "Programas de televisión", d: "Producción audiovisual y formatos que llegan a toda la isla." },
  { y: "Digital", t: "Webs, redes y marketing online", d: "Más de 100 pymes en internet con webs que funcionan y venden." },
  { y: "IA", t: "Agentes, automatización y GEO", d: "Inteligencia artificial aplicada a lo que de verdad le importa a una pyme." },
  { y: String(site.spainSince), t: "De Mallorca a toda España", d: "El mismo equipo y la misma cercanía, ahora para empresas de todo el país." },
];
---

<section class="section tl" data-progress="view">
  <div class="wrap tl__grid">
    <div class="tl__head">
      <p class="eyebrow" data-reveal>Nuestra historia</p>
      <h2 data-split>De las revistas a la inteligencia artificial<span class="comma">,</span></h2>
      <p class="lead" data-reveal style="--d:2">
        Revistas, radio, televisión, webs, marketing digital e IA. Lo hemos hecho todo, por eso
        podemos hacer cualquier cosa por tu empresa.
      </p>
    </div>
    <ol class="tl__list">
      {
        items.map((it, i) => (
          <li class="tl__item" data-reveal style={`--d:${i % 2}`}>
            <span class="tl__y">{it.y}</span>
            <div>
              <h3>{it.t}</h3>
              <p>{it.d}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .tl__grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1000px) {
    .tl__grid {
      grid-template-columns: 1fr 1.2fr;
      gap: 6rem;
    }
    .tl__head {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
  }
  .tl__head {
    display: grid;
    gap: 1.5rem;
  }
  @media (max-width: 479px) {
    .tl__item {
      grid-template-columns: 1fr !important;
      gap: 0.25rem !important;
    }
  }
  .tl__item {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }
  .tl__item:last-child {
    border-bottom: 1px solid var(--line);
  }
  .tl__y {
    font-variation-settings: "wdth" 125;
    font-weight: 800;
    font-size: var(--fs-lg);
    letter-spacing: -0.04em;
    color: var(--red);
  }
  .tl__item h3 {
    font-size: 1.35rem;
    margin-bottom: 0.35rem;
  }
  .tl__item p {
    color: var(--muted);
    max-width: 46ch;
  }
</style>
