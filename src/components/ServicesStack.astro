---
import Arrow from "./Arrow.astro";
import Motif from "./Motif.astro";

const panels = [
  {
    href: "/automatizaciones/", kind: "auto", theme: "paper", n: "01",
    title: "Soluciones a medida",
    line: "Tu operativa, mejor conectada.",
    text: "Software, integraciones y automatización para quitar tareas, errores y pasos de más.",
    meta: "Del diagnóstico a la puesta en marcha",
  },
  {
    href: "/agentes-ia/", kind: "ia", theme: "red", n: "02",
    title: "IA aplicada",
    line: "Más capacidad para tu equipo.",
    text: "Agentes que atienden, leen documentos y preparan trabajo. Con revisión humana donde importa.",
    meta: "Integrada en tus procesos · a medida",
  },
  {
    href: "/diseno-web/", kind: "web", theme: "paper", n: "03",
    title: "Diseño web",
    line: "Diseño que convence. Tecnología que responde.",
    text: "Webs con carácter, rápidas y fáciles de usar. De la primera impresión al contacto.",
    meta: "Diseño propio · desarrollo · lanzamiento",
  },
  {
    href: "/seo-geo/", kind: "seo", theme: "ink", n: "04",
    title: "Visibilidad digital",
    line: "Que te encuentren cuando te necesitan.",
    text: "SEO, presencia local y contenido para buscadores y respuestas de IA. Con seguimiento y criterio.",
    meta: "Como parte de tu estrategia de crecimiento",
  },
] as const;
---

<section class="svs" id="servicios" aria-labelledby="svs-title">
  <div class="svs__intro wrap">
    <p class="eyebrow" data-reveal>Lo que hacemos</p>
    <h2 id="svs-title" data-split>Tecnología que se traduce en resultados<span class="comma">.</span></h2>
  </div>

  <ol class="svs__stack" data-stack>
    {
      panels.map((p) => (
        <li class={`pn pn--${p.theme}`}>
          <a class="pn__in wrap" href={p.href}>
            <span class="pn__n">{p.n} / 04</span>
            <h3 class="pn__title">{p.title}</h3>
            <div class="pn__main">
              <p class="pn__line">{p.line}</p>
              <p class="pn__text">{p.text}</p>
              <span class="pn__foot">
                <span class="pn__meta">{p.meta}</span>
                <span class="pn__go">
                  Ver servicio <Arrow />
                </span>
              </span>
            </div>
            <div class="pn__art">
              <Motif kind={p.kind} />
            </div>
          </a>
        </li>
      ))
    }
  </ol>

  <div class="wrap svs__more">
    <p class="eyebrow">Y además</p>
    <ul class="chips">
      {
        ["Notoriedad y medios", "Radio y televisión", "Redes y publicidad", "Branding y diseño gráfico", "Kit Digital"].map(
          (t) => <li class="chip">{t}</li>
        )
      }
    </ul>
    <a class="link-arrow" href="/notoriedad-de-marca/">Notoriedad de marca <Arrow /></a>
  </div>
</section>

<style>
  .svs {
    overflow-x: clip;
  }
  .svs__intro {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(4rem, 9vw, 8rem) clamp(2.5rem, 5vw, 4rem);
  }
  .svs__intro h2 {
    max-width: 16ch;
  }
  .pn {
    --cover: 0;
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: stretch;
    border-top: 1px solid var(--line);
  }
  .pn::after {
    content: "";
    position: absolute;
    inset: 0;
    background: #000;
    opacity: calc(var(--cover) * 0.7);
    pointer-events: none;
  }
  .pn--paper {
    background: var(--paper);
    color: var(--ink);
  }
  .pn--ink {
    background: var(--night);
    color: var(--paper);
    --line: var(--night-line);
    --muted: var(--night-muted);
  }
  .pn--red {
    background: var(--red);
    color: #fff;
    --line: rgb(255 255 255 / 0.35);
    --muted: rgb(255 255 255 / 0.8);
  }
  .pn__in {
    display: grid;
    gap: 2rem;
    padding-block: clamp(5rem, 9vw, 7rem) clamp(2.5rem, 5vw, 4rem);
    text-decoration: none;
    align-content: space-between;
  }
  .pn__n {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pn__title {
    font-size: clamp(2.2rem, 9.2vw, 10.5rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
    font-variation-settings: "wdth" 100;
    word-spacing: 0.14em;
    align-self: center;
    transition: transform 0.7s var(--ease);
  }
  .pn__in:hover .pn__title {
    transform: translateX(1.25rem);
  }
  .pn__main {
    display: grid;
    gap: 1.25rem;
    align-content: end;
  }
  .pn__line {
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    max-width: 24ch;
  }
  .pn__text {
    color: var(--muted);
    max-width: 48ch;
  }
  .pn__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-weight: 600;
  }
  .pn__go {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
  }
  .pn__go :global(.arrow) {
    transition: transform 0.5s var(--ease);
  }
  .pn__in:hover .pn__go :global(.arrow) {
    transform: translateX(6px);
  }
  /* sobre fondo rojo, el acento de la ilustración pasa a negro (si no, rojo sobre rojo) */
  .pn--red .pn__art {
    --red: var(--ink);
  }
  .pn__in {
    position: relative;
  }
  .pn__art {
    position: absolute;
    right: var(--gutter);
    top: 4.6rem;
    width: 6.5rem;
    opacity: 0.9;
  }
  @media (min-width: 900px) {
    .pn__in {
      grid-template-columns: 1.25fr 1fr;
      grid-template-rows: auto 1fr auto;
      gap: 0 4rem;
    }
    .pn__n,
    .pn__title {
      grid-column: 1 / -1;
    }
    .pn__art {
      position: static;
      display: grid;
      align-content: end;
      max-width: 22rem;
      justify-self: end;
      width: 100%;
      opacity: 1;
    }
  }
  /* apilado a pantalla completa: la card se queda fija y la siguiente sube por encima.
     El hueco de abajo es lo primero que tapa, así el texto se lee durante el efecto. */
  @media (min-height: 640px) {
    .pn {
      position: sticky;
      top: 0;
      height: 100svh;
      overflow: hidden;
    }
    .pn__in {
      height: 100%;
      padding-bottom: 22vh;
      transform: scale(calc(1 - var(--cover) * 0.05));
      transform-origin: 50% 0;
    }
  }
  @media (min-height: 640px) and (max-width: 999px) {
    .pn__in {
      padding-bottom: calc(5.75rem + 18vh);
    }
  }
  .svs__more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .svs__more .link-arrow {
    margin-left: auto;
  }
  @supports (animation-timeline: view()) {
    .pn__title {
      animation: ttl linear both;
    }
    .pn__title:not(.tl) {
      animation-timeline: view();
      animation-range: entry 0% entry 90%;
    }
    @keyframes ttl {
      from {
        transform: translateX(14vw);
        opacity: 0.15;
      }
    }
  }
</style>
