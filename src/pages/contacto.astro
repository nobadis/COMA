---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import { site, mailto } from "../data/site";
import { ads } from "../data/ads";

const viaEndpoint = Boolean(ads.formEndpoint);

const interests = [
  "Web desde 99 €",
  "Rediseño de mi web",
  "SEO y GEO",
  "Agentes de IA",
  "Automatizaciones",
  "Notoriedad y medios",
  "Kit Digital",
  "Otro",
];
const timings = ["Lo antes posible", "En 1-3 meses", "Solo estoy explorando"];
---

<Base
  crumbs={[{ name: "Contacto", path: "/contacto/" }]}
  stickyCta={false}
  title="Contacto"
  description="Pide tu web desde 99 € + IVA o cuéntanos tu proyecto de SEO, IA o automatización. Agencia en Palma de Mallorca para toda España: info@comunicacionenmallorca.com."
>
  <section class="ct">
    <div class="wrap ct__grid">
      <div class="ct__intro">
        <p class="eyebrow" data-reveal>Contacto</p>
        <h1 data-split>¿Necesitas alguna información sobre nosotros o algún servicio?</h1>
        <p class="lead" data-reveal style="--d:3">
          Cuéntanos qué tienes en mente. Rellena el brief y se abrirá tu correo con el mensaje listo
          para enviar, o escríbenos directamente.
        </p>
        <dl class="ct__info" data-reveal style="--d:4">
          <div>
            <dt>Email</dt>
            <dd><a href={mailto()}>{site.email}</a></dd>
          </div>
          <div>
            <dt>Estudio</dt>
            <dd>
              <a href={site.mapsUrl} target="_blank" rel="noopener">
                {site.address.street}, {site.address.postalCode} {site.address.city} ↗
              </a>
            </dd>
          </div>
        </dl>
      </div>

      <form class="brief" data-brief data-reveal style="--d:2" novalidate>
        <fieldset>
          <legend>¿En qué te podemos ayudar?</legend>
          <div class="brief__chips">
            {
              interests.map((i) => (
                <label class="pick">
                  <input type="checkbox" name="interes" value={i} />
                  <span>{i}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="brief__row">
          <label class="field">
            <span>Nombre</span>
            <input type="text" name="nombre" autocomplete="name" required />
          </label>
          <label class="field">
            <span>Empresa</span>
            <input type="text" name="empresa" autocomplete="organization" />
          </label>
        </div>

        {
          viaEndpoint && (
            <label class="field">
              <span>Email o teléfono</span>
              <input type="text" name="contacto" autocomplete="email" required />
            </label>
          )
        }

        <label class="field">
          <span>Cuéntanos un poco más</span>
          <textarea name="mensaje" rows="4" placeholder="Qué quieres conseguir, a quién te diriges, qué tienes ya en marcha…" required></textarea>
        </label>

        <fieldset>
          <legend>¿Cuándo te gustaría empezar?</legend>
          <div class="brief__chips">
            {
              timings.map((t, i) => (
                <label class="pick">
                  <input type="radio" name="plazo" value={t} checked={i === 0} />
                  <span>{t}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <p class="brief__error" data-brief-error hidden>Indica tu nombre{viaEndpoint ? ", cómo contactarte" : ""} y cuéntanos brevemente tu proyecto.</p>

        <div class="brief__foot">
          <button class="btn btn--red" type="submit" data-magnetic>
            {viaEndpoint ? "Enviar mensaje" : "Preparar email"} <Arrow />
          </button>
          <p class="brief__legal">
            {
              viaEndpoint
                ? "Usamos tus datos solo para responderte. Se envían a nuestro proveedor de formularios. "
                : "No guardamos nada en esta web: el mensaje se abre en tu programa de correo. "
            }Consulta nuestra <a href="/privacidad/">política de privacidad</a>.
          </p>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  import { submitLead } from "../scripts/lead";

  document.querySelectorAll<HTMLFormElement>("[data-brief]").forEach((form) => {
    // Precarga desde /precios/ o los botones de "Quiero mi web".
    const params = new URLSearchParams(window.location.search);
    const plan = params.get("plan");
    const interestFor: Record<string, string> = {
      web: 'input[name=interes][value^="Web desde"]',
      seo: 'input[name=interes][value="SEO y GEO"]',
      ia: 'input[name=interes][value="Agentes de IA"]',
      auto: 'input[name=interes][value="Automatizaciones"]',
      medios: 'input[name=interes][value="Notoriedad y medios"]',
    };
    if (plan && interestFor[plan]) {
      const box = form.querySelector<HTMLInputElement>(interestFor[plan]);
      if (box) box.checked = true;
    }
    const pre = params.get("extras");
    const total = params.get("total");
    if (pre || total) {
      const msg = form.querySelector<HTMLTextAreaElement>("textarea[name=mensaje]");
      if (msg && !msg.value) {
        const what = plan === "seo" ? "los servicios de SEO/GEO" : "la web";
        msg.value =
          `Me interesa ${what}` +
          (pre ? ` con: ${pre.split("|").join(", ")}` : "") +
          `.\n` +
          (total ? `Presupuesto orientativo calculado en la web: ${total}.\n` : "") +
          `\n`;
      }
    }
    const error = form.querySelector<HTMLElement>("[data-brief-error]");
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const nombre = String(data.get("nombre") ?? "").trim();
      const mensaje = String(data.get("mensaje") ?? "").trim();
      const contacto = String(data.get("contacto") ?? "").trim();
      const needsContact = form.querySelector("input[name=contacto]") !== null;
      if (!nombre || !mensaje || (needsContact && !contacto)) {
        if (error) error.hidden = false;
        form.querySelector<HTMLElement>(nombre ? "textarea" : "input[name=nombre]")?.focus();
        return;
      }
      if (error) error.hidden = true;
      const empresa = String(data.get("empresa") ?? "").trim();
      void submitLead({
        nombre,
        empresa,
        contacto,
        mensaje,
        intereses: data.getAll("interes").map(String),
        plazo: String(data.get("plazo") ?? ""),
        source: "contacto",
      });
    });
  });
</script>

<style>
  .ct {
    padding-top: clamp(8.5rem, 16vw, 12rem);
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }
  .ct__grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1000px) {
    .ct__grid {
      grid-template-columns: 1fr 1.05fr;
      align-items: start;
    }
    .ct__intro {
      position: sticky;
      top: 8rem;
    }
  }
  .ct__intro {
    display: grid;
    gap: 1.75rem;
  }
  .ct__intro h1 {
    font-size: var(--fs-2xl);
  }
  .ct__info {
    display: grid;
    gap: 1.25rem;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }
  .ct__info dt {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .ct__info dd {
    margin: 0.25rem 0 0;
    font-size: var(--fs-lg);
    font-weight: 600;
  }
  .ct__info a {
    text-decoration: none;
  }
  .ct__info a:hover {
    color: var(--red);
  }

  .brief {
    display: grid;
    gap: 1.75rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    background: #fff;
    color: var(--ink);
    border: 2px solid var(--ink);
    box-shadow: 10px 10px 0 var(--ink);
  }
  fieldset {
    border: 0;
    padding: 0;
    min-width: 0;
  }
  legend {
    font-weight: 700;
    margin-bottom: 0.9rem;
    font-variation-settings: "wdth" 115;
  }
  .brief__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pick {
    position: relative;
    cursor: pointer;
  }
  .pick input {
    position: absolute;
    opacity: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    cursor: pointer;
  }
  .pick span {
    display: inline-block;
    padding: 0.6rem 1rem;
    border: 2px solid var(--ink);
    background: #fff;
    font-size: var(--fs-sm);
    font-weight: 600;
    transition:
      background 0.3s var(--ease),
      color 0.3s var(--ease),
      transform 0.3s var(--ease);
  }
  .pick:hover span {
    background: var(--paper-2);
  }
  .pick input:checked + span {
    background: var(--ink);
    color: #fff;
  }
  .pick input:focus-visible + span {
    outline: 3px solid var(--red);
    outline-offset: 2px;
  }
  .pick input:active + span {
    transform: scale(0.97);
  }
  .brief__row {
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 640px) {
    .brief__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .field {
    display: grid;
    gap: 0.45rem;
  }
  .field span {
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--ink);
  }
  .field input,
  .field textarea {
    width: 100%;
    background: var(--paper);
    border: 2px solid var(--ink);
    border-radius: 0;
    padding: 0.85rem 1rem;
    font-size: var(--fs-md);
    color: var(--ink);
    resize: vertical;
    transition:
      border-color 0.3s,
      background 0.3s,
      box-shadow 0.3s;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    background: #fff;
    border-color: var(--red);
    box-shadow: 0 0 0 3px rgb(225 17 45 / 0.25);
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: #6b665f;
    opacity: 1;
  }
  .brief__error {
    color: var(--red-ink);
    font-weight: 600;
    font-size: var(--fs-sm);
    border-left: 4px solid var(--red);
    padding-left: 0.75rem;
  }
  .brief__foot {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .brief__legal {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .brief__legal a:hover {
    color: var(--red);
  }
</style>
