---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Faq from "../../components/Faq.astro";
import Cta from "../../components/Cta.astro";
import { enPages, enPath, type EnPage } from "../../data/en";
import { site, mailto, trust } from "../../data/site";

export function getStaticPaths() {
  return enPages.map((p) => ({ params: { slug: p.slug || undefined }, props: { p } }));
}
const p = Astro.props.p as EnPage;
const url = `${site.url}${enPath(p.slug)}`;
const home = p.slug === "";
const others = enPages.filter((x) => x.slug !== p.slug);
const mail = mailto(`Project enquiry: ${p.name}`);

const schema = [
  ...(home
    ? []
    : [
        {
          "@context": "https://schema.org",
          "@type": "Service",
          "@id": `${url}#service`,
          name: p.name,
          description: p.description,
          url,
          inLanguage: "en",
          provider: { "@id": `${site.url}/#org` },
          areaServed: [
            { "@type": "AdministrativeArea", name: "Mallorca" },
            { "@type": "Country", name: "Spain" },
          ],
          availableLanguage: ["English", "Spanish", "Catalan"],
          keywords: p.searches.join(", "),
        },
      ]),
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: "en",
    mainEntity: p.faq.map((q) => ({
      "@type": "Question",
      name: q.title,
      acceptedAnswer: { "@type": "Answer", text: q.text },
    })),
  },
];
const crumbs = home
  ? [{ name: "English", path: "/en/" }]
  : [
      { name: "English", path: "/en/" },
      { name: p.name, path: enPath(p.slug) },
    ];
---

<Base title={p.title} description={p.description} schema={schema} crumbs={crumbs} lang="en" stickyCta={false}>
  <section class="en-h">
    <div class="wrap en-h__in">
      <p class="eyebrow" data-reveal>{p.eyebrow}</p>
      <h1 data-split>{p.h1}<span class="comma">.</span></h1>
      <p class="lead" data-reveal style="--d:3">{p.lead}</p>
      <div class="en-h__cta" data-reveal style="--d:4">
        <a class="btn btn--red btn--lg" href={mail} data-magnetic data-track="cta_click" data-track-label={`en-${p.slug || "home"}`}>
          Email us <Arrow />
        </a>
        <a class="link-arrow" href={p.es} hreflang="es" lang="es">Ver en español</a>
      </div>
    </div>
  </section>

  <section class="section en-txt">
    <div class="wrap en-txt__grid">
      {p.sections.map((s) => (
        <div>
          <h2>{s.h2}</h2>
          {s.paragraphs.map((t) => <p>{t}</p>)}
          {s.list && <ul>{s.list.map((li) => <li>{li}</li>)}</ul>}
        </div>
      ))}
    </div>
  </section>

  <section class="section night en-do" data-dark>
    <div class="wrap">
      <p class="eyebrow">What you get</p>
      <h2>{p.name}</h2>
      <ul class="en-do__list">
        {p.points.map((b, i) => (
          <li>
            <span aria-hidden="true">0{i + 1}</span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </li>
        ))}
      </ul>
      <div class="en-price">
        <p class="en-price__lab">{p.price.label}</p>
        <p class="en-price__val">{p.price.value}</p>
        <p class="en-price__note">{p.price.note}</p>
      </div>
    </div>
  </section>

  <section class="section en-links">
    <div class="wrap en-links__grid">
      <div>
        <h2>{home ? "What we do" : "More in English"}</h2>
        <ul>
          {others.map((o) => (
            <li><a href={enPath(o.slug)}>{o.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h2>About COMA</h2>
        <p>
          {site.brand} ({site.legalName}), {site.address.street}, {site.address.postalCode} {site.address.city}. Since {site.since}. Clients include {trust.wall.slice(0, 4).map((w) => w.name).join(", ")}.
        </p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a> · <a href="/sobre-coma/" hreflang="es" lang="es">Sobre COMA (en español)</a></p>
      </div>
    </div>
  </section>

  <Faq items={p.faq} title="Frequently asked questions" />
  <Cta
    title={p.cta}
    lead="Tell us what you need in a couple of lines. We reply personally with a clear proposal: scope, timeline and price."
    action={{ href: mail, label: "Email us" }}
    mail={mail}
  />
</Base>

<style>
  .en-h {
    padding-top: clamp(8.5rem, 15vw, 12rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .en-h__in {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .en-h h1 {
    font-size: clamp(1.7rem, 0.6rem + 5vw, 5.2rem);
    max-width: 20ch;
    letter-spacing: -0.05em;
  }
  .en-h__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }
  .en-txt__grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1000px) {
    .en-txt__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 5rem;
    }
  }
  .en-txt h2 {
    font-size: var(--fs-2xl);
    margin-bottom: 1rem;
  }
  .en-txt p,
  .en-txt li {
    line-height: 1.6;
    max-width: 62ch;
  }
  .en-txt p + p,
  .en-txt ul {
    margin-top: 0.9rem;
  }
  .en-txt ul {
    padding-left: 1.25rem;
    display: grid;
    gap: 0.4rem;
  }
  .en-do__list {
    list-style: none;
    padding: 0;
    margin-top: 2.5rem;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 800px) {
    .en-do__list {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 3rem;
    }
  }
  .en-do__list li {
    display: grid;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--night-line);
  }
  .en-do__list span {
    color: var(--red);
    font-variation-settings: "wdth" 125;
    font-weight: 700;
  }
  .en-do__list p {
    color: var(--muted);
    line-height: 1.55;
  }
  .en-price {
    margin-top: 3rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--night-line);
    display: grid;
    gap: 0.5rem;
    max-width: 40rem;
  }
  .en-price__lab {
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .en-price__val {
    font-size: var(--fs-2xl);
    font-weight: 700;
    font-variation-settings: "wdth" 125;
  }
  .en-price__note {
    color: var(--muted);
  }
  .en-links {
    background: var(--paper-2);
  }
  .en-links__grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .en-links__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .en-links h2 {
    font-size: var(--fs-xl);
    margin-bottom: 1rem;
  }
  .en-links ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .en-links p {
    line-height: 1.6;
    max-width: 62ch;
  }
  .en-links p + p {
    margin-top: 0.75rem;
  }
  .en-links a {
    text-underline-offset: 0.2em;
  }
</style>
