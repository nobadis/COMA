---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Marquee from "../components/Marquee.astro";
import Process from "../components/Process.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import DeskInbox from "../components/despachos/DeskInbox.astro";
import InvoiceLab from "../components/despachos/InvoiceLab.astro";
import CloseBoard from "../components/despachos/CloseBoard.astro";
import WaAgent from "../components/despachos/WaAgent.astro";
import Modelo303 from "../components/despachos/Modelo303.astro";
import Trust from "../components/Trust.astro";
import { site, trust, years } from "../data/site";
import { diagnosticoMail, despachosSubject, modules, plans, onDemand, steps, faq, channels, checks, stack, compare, escala, terms } from "../data/despachos";

const title = "Automatización para despachos y Modelo 303";
const description =
  "Automatiza facturas y el Modelo 303: rellenado, revisión y presentación con aprobación de tu despacho. Integración a medida y diagnóstico gratuito.";
const mail = diagnosticoMail();
// "always": en español Intl no separa los miles con 4 cifras (1490), y en precios queda raro.
const num = (n: number) =>
  n.toLocaleString("es-ES", { maximumFractionDigits: 2, minimumFractionDigits: n % 1 ? 2 : 0, useGrouping: "always" } as Intl.NumberFormatOptions);
const eur = (n: number) => `${num(n)} €`;

const pains = [
  { pain: "Facturas por email, WhatsApp, papel y fotos torcidas", fix: "Un único buzón, ordenado por cliente" },
  { pain: "Teclear NIF, bases e IVA, una a una", fix: "La IA lo lee; tú revisas lo dudoso" },
  { pain: "Perseguir al cliente por el ticket que falta", fix: "Recordatorios automáticos" },
  { pain: "El último día del trimestre, todo a la vez", fix: "Documentación al día, cada semana" },
  { pain: "Volver a copiar los mismos importes en el 303", fix: "Borrador automático, revisión y presentación conectadas" },
  { pain: "Cero tiempo para asesorar", fix: "Horas libres para lo que de verdad se paga" },
];

const promises = [
  { t: "La IA propone, tu equipo decide", d: "Lo claro pasa solo. Lo dudoso se marca y lo revisa una persona." },
  { t: "Tu programa de siempre", d: "a3, Sage, Holded, Contasol o Excel. No migras nada." },
  { t: "Datos protegidos", d: "Contrato de encargado del tratamiento y proveedores con servidores en la UE." },
  { t: "Sin permanencia ni cajas negras", d: "Cuota mensual, todo documentado y tuyo." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: title,
    description,
    serviceType: "Automatización de procesos contables",
    audience: { "@type": "BusinessAudience", name: "Asesorías, gestorías y despachos profesionales" },
    url: `${site.url}/despachos/`,
    provider: { "@id": `${site.url}/#org` },
    areaServed: { "@type": "Country", name: "España" },
    offers: plans
      .filter((p) => p.month !== null || p.priceLabel)
      .map((p) => ({
        "@type": "Offer",
        name: p.name,
        price: p.setup ?? 0,
        priceCurrency: "EUR",
        description: p.pitch,
        url: `${site.url}/despachos/#precios`,
        ...(p.month
          ? {
              priceSpecification: [
                { "@type": "UnitPriceSpecification", price: p.setup, priceCurrency: "EUR", name: "Puesta en marcha", valueAddedTaxIncluded: false },
                { "@type": "UnitPriceSpecification", price: p.month, priceCurrency: "EUR", unitCode: "MON", valueAddedTaxIncluded: false },
              ],
            }
          : {}),
      })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((q) => ({ "@type": "Question", name: q.title, acceptedAnswer: { "@type": "Answer", text: q.text } })),
  },
];
---

<Base title={title} description={description} schema={schema} crumbs={[{ name: "Despachos", path: "/despachos/" }]} stickyCta={false}>
  <!-- ------------------------------------------------------------- portada -->
  <section class="dh">
    <div class="wrap dh__inner">
      <div class="dh__copy">
        <p class="eyebrow" data-reveal>COMA para asesorías y despachos</p>
        <h1 data-split>Menos teclear. Más asesorar<span class="comma">,</span></h1>
        <p class="lead" data-reveal style="--d:3">
          Documentos, contabilidad y cierre conectados. La IA prepara el trabajo; tu equipo revisa y aprueba.
        </p>
        <div class="dh__ctas" data-reveal style="--d:4">
          <a class="btn btn--red btn--lg" href={mail} data-magnetic data-track-label="despachos-hero">
            Diagnóstico gratis <Arrow />
          </a>
          <a class="link-arrow" href="#modelo-303">Descubre el Modelo 303 automático</a>
        </div>
        <ul class="dh__chips chips" data-reveal style="--d:5">
          <li class="chip">Sin cambiar de programa</li>
          <li class="chip">Sin permanencia</li>
          <li class="chip">Datos en la UE</li>
        </ul>
        <p class="dh__proof" data-reveal style="--d:6">
          <strong>+{trust.pymes} pymes</strong> confían en COMA desde {site.since}
        </p>
      </div>
      <div class="dh__art" data-reveal style="--d:2">
        <DeskInbox />
      </div>
    </div>
  </section>
  <Marquee items={["WhatsApp integrado", "Email por cliente", "Extracción con IA", "Agente que pide lo que falta", "a3 · Sage · Holded · Contasol", "Modelos 111 · 115", "Modelo 303 automático", "Panel del cierre"]} />

  <!-- ---------------------------------------------------------------- dolor -->
  <section class="section night pn" data-dark>
    <div class="wrap pn__inner">
      <div class="pn__head">
        <p class="eyebrow" data-reveal>Si esto te suena</p>
        <h2 data-split>El trimestre no debería ser una avalancha<span class="comma">,</span></h2>
        <p class="lead" data-reveal style="--d:2">
          Menos perseguir documentos y copiar datos. Más tiempo para tus clientes.
        </p>
      </div>
      <ul class="pn__list">
        {
          pains.map((p, i) => (
            <li data-reveal style={`--d:${i % 2}`}>
              <span class="pn__pain">
                <span>{p.pain}</span>
              </span>
              <span class="pn__fix">→ {p.fix}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ----------------------------------------------------------------- demo -->
  <section class="section" id="demo">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Pruébalo</p>
        <h2 data-split>Elige una factura. Mira cómo se registra sola<span class="comma">,</span></h2>
        <p class="lead" data-reveal style="--d:2">
          Lectura, comprobación y propuesta de cuenta. Probá la demo: lo dudoso queda marcado para revisión.
        </p>
      </div>
      <div data-reveal>
        <InvoiceLab />
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------- whatsapp -->
  <section class="section night wz" data-dark>
    <div class="wrap grid-2 wz__grid">
      <div class="wz__copy">
        <p class="eyebrow" data-reveal>Agente del despacho</p>
        <h2 data-split>Documentos recibidos. Clientes atendidos<span class="comma">,</span></h2>
        <p class="lead" data-reveal style="--d:2">
          Recibe documentos, confirma y pide lo que falta. Las consultas de asesoría pasan a tu equipo.
        </p>
        <ul class="wz__points" data-reveal style="--d:3">
          <li><strong>Confirma cada documento</strong> con lo que ha leído.</li>
          <li><strong>Detecta lo que no sirve</strong>: fotos borrosas, tickets sin NIF, facturas repetidas.</li>
          <li><strong>Persigue con nombre y apellido</strong>: «te falta el alquiler de octubre».</li>
          <li><strong>Te pasa la conversación</strong> cuando la pregunta es de asesoría.</li>
        </ul>
      </div>
      <div data-reveal style="--d:2">
        <WaAgent />
      </div>
    </div>
  </section>

  <!-- -------------------------------------------------------------- módulos -->
  <section class="section sand" id="que-hacemos">
    <div class="wrap md">
      <div class="md__head">
        <p class="eyebrow" data-reveal>Qué automatizamos</p>
        <h2 data-split>Del WhatsApp del cliente al cierre del IVA<span class="comma">,</span></h2>
        <p class="lead" data-reveal style="--d:2">
          Empezamos por lo que más horas te quita. Ampliamos cuando el flujo está validado.
        </p>
        <p class="sr-only">Canales de entrada:</p>
        <ul class="md__channels" data-reveal style="--d:3">
          {channels.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="md__body">
      <ol class="md__list hs" data-hs>
        {
          modules.map((m, i) => (
            <li class="md__item" data-reveal>
              <span class="md__n">0{i + 1}</span>
              <h3>{m.title}</h3>
              <p>{m.text}</p>
            </li>
          ))
        }
      </ol>
      <details class="md__details">
        <summary>Comprobaciones y tecnología</summary>
      <div class="md__checks" data-reveal>
        <p class="md__h">Cada documento pasa {checks.length} comprobaciones automáticas</p>
        <ul>
          {checks.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="md__stack" data-reveal>
        <p class="md__h">Construido con piezas probadas y abiertas</p>
        <ul>
          {stack.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      </details>
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------------------------- cierre -->
  <section class="section night bd" data-dark>
    <div class="wrap grid-2 bd__grid">
      <div class="bd__copy">
        <p class="eyebrow" data-reveal>Cierre trimestral</p>
        <h2 data-split>Sabes quién falta antes de que falte<span class="comma">,</span></h2>
        <p class="lead" data-reveal style="--d:2">
          Un panel con el estado de cada cliente y recordatorios que salen solos, con el tono de tu
          despacho. Nadie tiene que perseguir a nadie.
        </p>
        <ul class="bd__points" data-reveal style="--d:3">
          <li><strong>Avisos con lo que falta</strong>, no con un «mándame todo».</li>
          <li><strong>Por el canal del cliente</strong>: email o WhatsApp.</li>
          <li><strong>Escalado a una persona</strong> si el cliente no responde.</li>
        </ul>
      </div>
      <div data-reveal style="--d:2">
        <CloseBoard />
      </div>
    </div>
  </section>

  <Modelo303 />

  <!-- ------------------------------------------------------------ diferencia -->
  <section class="section" id="diferencia">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Por qué COMA</p>
        <h2 data-split>No te vendemos otro programa. Conectamos los que ya tienes<span class="comma">,</span></h2>
        <p class="lead" data-reveal style="--d:2">
          Las herramientas de captura son buenas, pero son una pieza más que tu equipo y tus clientes
          tienen que adoptar. Nosotros montamos el flujo entero, a medida, y lo mantenemos.
        </p>
      </div>
      <table class="vs" data-reveal>
        <caption class="sr-only">Comparativa entre una herramienta de captura genérica y COMA para despachos</caption>
        <thead>
          <tr class="vs__row vs__row--head">
            <th scope="col"><span class="sr-only">Aspecto</span></th>
            <th scope="col">Herramienta de captura genérica</th>
            <th scope="col">COMA para despachos</th>
          </tr>
        </thead>
        <tbody>
          {
            compare.map((c) => (
              <tr class="vs__row">
                <th scope="row">{c.what}</th>
                <td class="vs__tool">{c.tool}</td>
                <td class="vs__coma">{c.coma}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- --------------------------------------------------------------- precios -->
  <section class="section sand" id="precios">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Precios</p>
        <h2 data-split>Precio claro, volumen claro, sin permanencia<span class="comma">,</span></h2>
        <p class="lead" data-reveal style="--d:2">
          Una puesta en marcha y una cuota mensual con los documentos incluidos. Antes de pagar nada,
          el diagnóstico es gratis y el piloto se hace con tus clientes reales. El módulo 303 se
          presupuesta aparte según tu cartera, regímenes e integración.
        </p>
      </div>
      <ul class="pl" data-plans>
        {
          plans.map((p, i) => (
            <li class:list={["pl__card", { "pl__card--hot": p.featured }]} data-reveal style={`--d:${i}`}>
              {p.featured && <span class="pl__badge">Recomendado</span>}
              <h3>{p.name}</h3>
              <p class="pl__price">
                {p.setup === null ? (
                  <strong>{p.priceLabel}</strong>
                ) : (
                  <>
                    <strong>{eur(p.month ?? 0)}</strong>
                    <span>/mes</span>
                  </>
                )}
              </p>
              <p class="pl__setup">{p.setup === null ? "Sin compromiso" : `+ ${eur(p.setup)} de puesta en marcha`}</p>
              {p.docs && (
                <p class="pl__vol">
                  <strong>{num(p.docs)} documentos/mes</strong> incluidos · después {eur(p.extra ?? 0)}/doc
                </p>
              )}
              <p class="pl__pitch">{p.pitch}</p>
              <ul class="pl__inc">
                {p.includes.map((x) => <li>{x}</li>)}
              </ul>
              <a
                class:list={["btn", p.featured ? "btn--red" : "btn--ghost"]}
                href={diagnosticoMail(`Me interesa: ${p.name}.`)}
                data-track-label={`despachos-plan-${p.id}`}
              >
                {p.cta} <Arrow />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="pl__dots" aria-hidden="true" data-plan-dots>{plans.map((_, i) => <i class:list={[{ "is-on": i === 0 }]} />)}</div>
      <a class="esc" href={diagnosticoMail(`Me interesa el plan ${escala.name}.`)} data-reveal data-track-label="despachos-plan-escala">
        <span class="esc__name">{escala.name}</span>
        <span class="esc__text">{escala.text}</span>
        <span class="esc__price">Desde <strong>{eur(escala.from)}</strong>/mes</span>
        <Arrow />
      </a>
      <div class="xt" data-reveal>
        <details class="xt__item">
          <summary>
            <span>Bajo demanda <small>{onDemand.length} opciones con alcance claro</small></span>
            <i aria-hidden="true"></i>
          </summary>
          <ul class="xt__list">
            {
              onDemand.map((o) => (
                <li>
                  {o.href ? <a href={o.href}>{o.name}</a> : <span>{o.name}</span>}
                  <small>{o.note}</small>
                </li>
              ))
            }
          </ul>
        </details>
        <details class="xt__item">
          <summary>
            <span>Sin letra pequeña <small>Volumen, excesos y bajas</small></span>
            <i aria-hidden="true"></i>
          </summary>
          <ul class="xt__terms">
            {terms.map((t) => <li>{t}</li>)}
          </ul>
        </details>
      </div>
      <p class="pl__legal" data-reveal>
        Precios sin IVA. El precio final queda cerrado por escrito tras el diagnóstico.
      </p>
    </div>
  </section>

  <!-- -------------------------------------------------------------- confianza -->
  <section class="section tz">
    <div class="wrap tz__inner">
      <div class="tz__head">
        <p class="eyebrow" data-reveal>Hecho con un equipo contable</p>
        <p class="tz__quote display" data-scrub>
          Lo hemos diseñado con un equipo contable en ejercicio, no en una sala de reuniones. Por eso
          automatiza lo que sobra y deja a tu equipo lo que importa: el criterio.
        </p>
        <p class="tz__sign" data-reveal>
          COMA · {years()} años contando historias de empresas · más de {trust.pymes} pymes
        </p>
      </div>
      <ul class="tz__list">
        {
          promises.map((p, i) => (
            <li data-reveal style={`--d:${i % 2}`}>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Trust />
  <Process eyebrow="Cómo empezamos" title="Sin saltos al vacío: primero un piloto" steps={steps} />
  <Faq items={faq} />
  <Cta
    title="Recupera el trimestre. Empieza por un diagnóstico gratis"
    subject={despachosSubject}
    lead="Cuéntanos qué programa usas y cuántos modelos 303 gestionas. En el diagnóstico vemos qué puedes automatizar, cómo conectar la presentación y qué inversión necesita tu despacho. Alcance y precio, por escrito."
    action={{ href: mail, label: "Pedir diagnóstico" }}
    mail={mail}
  />

  <div class="sticky-cta" data-sticky-cta>
    <span>Diagnóstico <strong>gratis</strong> <span class="muted-sm">· 30 min</span></span>
    <a class="btn btn--red" href={mail} tabindex="-1" data-track-label="despachos-sticky">Escríbenos <Arrow /></a>
  </div>
</Base>

<script>
  // Punto activo del carrusel de planes en móvil (el desplazamiento es nativo, con imán).
  document.querySelectorAll<HTMLElement>("[data-plans]").forEach((list) => {
    const dots = Array.from(list.parentElement?.querySelectorAll<HTMLElement>("[data-plan-dots] i") ?? []);
    const cards = Array.from(list.children) as HTMLElement[];
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const i = cards.indexOf(e.target as HTMLElement);
          dots.forEach((d, k) => d.classList.toggle("is-on", k === i));
        }),
      { root: list, threshold: 0.6 }
    );
    cards.forEach((c) => io.observe(c));
  });
</script>

<style>
  .md__details { grid-column: 1 / -1; padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .md__details summary { cursor: pointer; font-weight: 700; }
  .md__details[open] summary { margin-bottom: 1.5rem; }
  /* ---------------------------------------------------------------- portada */
  .dh {
    padding-top: clamp(8.5rem, 15vw, 11rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .dh__inner {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .dh__inner {
      grid-template-columns: 1.2fr 1fr;
      gap: 4rem;
    }
  }
  .dh__copy {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .dh h1 {
    font-size: clamp(1.9rem, 0.6rem + 4.6vw, 5.4rem);
    max-width: 16ch;
    letter-spacing: -0.05em;
  }
  @media (max-width: 479px) {
    .dh h1 {
      font-variation-settings: "wdth" 100;
    }
  }
  .dh__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }
  .dh__chips .chip::before {
    content: "✓";
    color: var(--red);
    margin-right: 0.45rem;
    font-weight: 700;
  }
  .dh__art {
    display: grid;
  }
  .dh__proof {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .dh__proof strong {
    color: var(--ink);
    border-bottom: 2px solid var(--red);
  }

  /* -------------------------------------------------------------- whatsapp */
  .wz__grid {
    align-items: center;
  }
  .wz__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .wz__points {
    display: grid;
    gap: 0.6rem;
  }
  .wz__points li {
    padding-left: 1.5rem;
    position: relative;
  }
  .wz__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--red);
  }

  /* ------------------------------------------------------------- diferencia */
  .vs {
    display: block;
    width: 100%;
    border-collapse: collapse;
    border-top: 2px solid var(--ink);
    text-align: left;
  }
  .vs thead,
  .vs tbody {
    display: block;
  }
  .vs th,
  .vs td {
    display: block;
    padding: 0;
    font-weight: inherit;
  }
  .vs__row {
    display: grid;
    gap: 0.35rem 2rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 800px) {
    .vs__row {
      grid-template-columns: 0.8fr 1.1fr 1.3fr;
      align-items: baseline;
    }
  }
  .vs__row > th[scope="row"] {
    font-variation-settings: "wdth" 112;
    font-weight: 700;
    font-size: var(--fs-lg);
    letter-spacing: -0.02em;
  }
  .vs__tool {
    color: var(--muted);
  }
  .vs__tool::before {
    content: "— ";
  }
  .vs__coma {
    font-weight: 600;
  }
  .vs__coma::before {
    content: "✓ ";
    color: var(--red);
    font-weight: 800;
  }
  .vs__row--head {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .vs__row--head > :last-child {
    color: var(--red);
  }
  @media (max-width: 799px) {
    .vs__row--head {
      display: none;
    }
    .vs__tool,
    .vs__coma {
      font-size: var(--fs-sm);
    }
  }

  /* ------------------------------------------------------------------ dolor */
  .pn__inner {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1000px) {
    .pn__inner {
      grid-template-columns: 0.9fr 1.3fr;
      gap: 6rem;
    }
    .pn__head {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
  }
  .pn__head {
    display: grid;
    gap: 1.25rem;
  }
  .pn__list {
    border-top: 2px solid var(--paper);
  }
  .pn__list li {
    display: grid;
    gap: 0.4rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
  }
  .pn__pain {
    justify-self: start;
    font-variation-settings: "wdth" 112;
    font-weight: 600;
    font-size: clamp(1.25rem, 0.95rem + 1.4vw, 2.1rem);
    letter-spacing: -0.035em;
    line-height: 1.12;
    transition: color 0.6s var(--ease) 0.7s;
  }
  /* tachado rojo al entrar en pantalla (una raya por línea, también si el texto salta de línea) */
  .pn__pain > span {
