---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import Marquee from "../components/Marquee.astro";
import Process from "../components/Process.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import DeskInbox from "../components/despachos/DeskInbox.astro";
import InvoiceLab from "../components/despachos/InvoiceLab.astro";
import CloseBoard from "../components/despachos/CloseBoard.astro";
import RoiCalc from "../components/despachos/RoiCalc.astro";
import WaAgent from "../components/despachos/WaAgent.astro";
import Copilot from "../components/despachos/Copilot.astro";
import Trust from "../components/Trust.astro";
import { site, trust, years } from "../data/site";
import { diagnosticoMail, despachosSubject, modules, plans, onDemand, steps, faq, channels, checks, stack, compare } from "../data/despachos";

const title = "Automatización para asesorías y despachos contables";
const description =
  "WhatsApp y email integrados, extracción de facturas con IA, un agente que atiende a tus clientes e integración con a3, Sage, Holded o Contasol. Para asesorías y despachos. Diagnóstico gratuito.";
const mail = diagnosticoMail();
const eur = (n: number) => `${n.toLocaleString("es-ES")} €`;

const pains = [
  { pain: "Facturas por email, WhatsApp, papel y fotos torcidas", fix: "Un único buzón, ordenado por cliente" },
  { pain: "Teclear NIF, bases e IVA, una a una", fix: "La IA lo lee; tú revisas lo dudoso" },
  { pain: "Perseguir al cliente por el ticket que falta", fix: "Recordatorios automáticos" },
  { pain: "El último día del trimestre, todo a la vez", fix: "Documentación al día, cada semana" },
  { pain: "Cero tiempo para asesorar", fix: "Horas libres para lo que de verdad se paga" },
];

const promises = [
  { t: "La IA propone, tu equipo decide", d: "Lo claro pasa solo. Lo dudoso se marca y lo revisa una persona." },
  { t: "Tu programa de siempre", d: "a3, Sage, Holded, Contasol o Excel. No migras nada." },
  { t: "Datos protegidos", d: "Contrato de encargado del tratamiento y proveedores con servidores en la UE." },
  { t: "Sin permanencia ni cajas negras", d: "Cuota mensual, todo documentado y tuyo." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: title,
    description,
    serviceType: "Automatización de procesos contables",
    audience: { "@type": "BusinessAudience", name: "Asesorías, gestorías y despachos profesionales" },
    url: `${site.url}/despachos/`,
    provider: { "@id": `${site.url}/#org` },
    areaServed: { "@type": "Country", name: "España" },
    offers: plans
      .filter((p) => p.month !== null || p.priceLabel)
      .map((p) => ({
        "@type": "Offer",
        name: p.name,
        price: p.setup ?? 0,
        priceCurrency: "EUR",
        description: p.pitch,
        url: `${site.url}/despachos/#precios`,
        ...(p.month
          ? {
              priceSpecification: [
                { "@type": "UnitPriceSpecification", price: p.setup, priceCurrency: "EUR", name: "Puesta en marcha", valueAddedTaxIncluded: false },
                { "@type": "UnitPriceSpecification", price: p.month, priceCurrency: "EUR", unitCode: "MON", valueAddedTaxIncluded: false },
              ],
            }
          : {}),
      })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((q) => ({ "@type": "Question", name: q.title, acceptedAnswer: { "@type": "Answer", text: q.text } })),
  },
];
---

<Base title={title} description={description} schema={schema} crumbs={[{ name: "Despachos", path: "/despachos/" }]} stickyCta={false}>
  <!-- ------------------------------------------------------------- portada -->
  <section class="dh">
    <div class="wrap dh__inner">
      <div class="dh__copy">
        <p class="eyebrow" data-reveal>COMA para asesorías y despachos</p>
        <h1 data-split>Tus clientes envían facturas. Tu despacho deja de teclearlas<span class="comma">,</span></h1>
        <p class="lead" data-reveal style="--d:3">
          WhatsApp y email integrados, IA que extrae y comprueba cada factura, un agente que atiende a
          tus clientes y todo conectado a tu programa contable. Tú solo revisas lo dudoso. Diseñado
          junto a un contable en ejercicio.
        </p>
        <div class="dh__ctas" data-reveal style="--d:4">
          <a class="btn btn--red btn--lg" href={mail} data-magnetic data-track-label="despachos-hero">
            Diagnóstico gratis <Arrow />
          </a>
          <a class="link-arrow" href="#demo">Pruébalo con una factura</a>
        </div>
        <ul class="dh__chips chips" data-reveal style="--d:5">
          <li class="chip">Sin cambiar de programa</li>
          <li class="chip">Sin permanencia</li>
          <li class="chip">Datos en la UE</li>
        </ul>
        <p class="dh__proof" data-reveal style="--d:6">
          <strong>+{trust.pymes} pymes</strong> confían en COMA desde {site.since}
        </p>
      </div>
      <div class="dh__art" data-reveal style="--d:2">
        <DeskInbox />
      </div>
    </div>
  </section>
  <Marquee items={["WhatsApp integrado", "Extracción con IA", "Agentes", "a3 · Sage · Holded · Contasol", "Norma 43", "Modelos 111 · 115 · 349", "Copiloto del despacho"]} />

  <!-- ---------------------------------------------------------------- dolor -->
  <section class="section night pn" data-dark>
    <div class="wrap pn__inner">
      <div class="pn__head">
        <p class="eyebrow" data-reveal>Si esto te suena</p>
        <h2 data-split>El trimestre no debería ser una avalancha<span class="comma">,</span></h2>
        <p class="lead" data-reveal style="--d:2">
          Las asesorías pequeñas pierden horas cada semana en trabajo que no aporta criterio. Lo
          tachamos de la lista.
        </p>
      </div>
      <ul class="pn__list">
        {
          pains.map((p, i) => (
            <li data-reveal style={`--d:${i % 2}`}>
              <span class="pn__pain">
                <span>{p.pain}</span>
              </span>
              <span class="pn__fix">→ {p.fix}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ----------------------------------------------------------------- demo -->
  <section class="section" id="demo">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Pruébalo</p>
        <h2 data-split>Elige una factura. Mira cómo se registra sola<span class="comma">,</span></h2>
        <p class="lead" data-reveal style="--d:2">
          Así trabaja cada documento que te envía un cliente: se lee, se comprueba, se propone la
          cuenta y queda listo para tu programa. Y si algo no cuadra, te avisa.
        </p>
      </div>
      <div data-reveal>
        <InvoiceLab />
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------- whatsapp -->
  <section class="section night wz" data-dark>
    <div class="wrap grid-2 wz__grid">
      <div class="wz__copy">
        <p class="eyebrow" data-reveal>Agente del despacho</p>
        <h2 data-split>Tus clientes escriben por WhatsApp. Les contesta tu despacho, al momento<span class="comma">,</span></h2>
        <p class="lead" data-reveal style="--d:2">
          Un agente de IA con el nombre y el tono de tu asesoría. Recibe, lee, confirma y pide lo que
          falta, a cualquier hora. Tu equipo solo entra cuando hace falta criterio.
        </p>
        <ul class="wz__points" data-reveal style="--d:3">
          <li><strong>Confirma cada documento</strong> con lo que ha leído.</li>
          <li><strong>Detecta lo que no sirve</strong>: fotos borrosas, tickets sin NIF, facturas repetidas.</li>
          <li><strong>Persigue con nombre y apellido</strong>: «te falta el alquiler de octubre».</li>
          <li><strong>Te pasa la conversación</strong> cuando la pregunta es de asesoría.</li>
        </ul>
      </div>
      <div data-reveal style="--d:2">
        <WaAgent />
      </div>
    </div>
  </section>

  <!-- -------------------------------------------------------------- módulos -->
  <section class="section sand" id="que-hacemos">
    <div class="wrap md">
      <div class="md__head">
        <p class="eyebrow" data-reveal>Qué automatizamos</p>
        <h2 data-split>Del WhatsApp del cliente al libro de registro<span class="comma">,</span></h2>
        <p class="lead" data-reveal style="--d:2">
          Seis piezas que se montan juntas o por separado, a medida de tu despacho. Empezamos por la
          que más horas te quita.
        </p>
        <p class="sr-only">Canales de entrada:</p>
        <ul class="md__channels" data-reveal style="--d:3">
          {channels.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="md__body">
      <ol class="md__list hs" data-hs>
        {
          modules.map((m, i) => (
            <li class="md__item" data-reveal>
              <span class="md__n">0{i + 1}</span>
              <h3>{m.title}</h3>
              <p>{m.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="md__checks" data-reveal>
        <p class="md__h">Cada documento pasa {checks.length} comprobaciones automáticas</p>
        <ul>
          {checks.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <div class="md__stack" data-reveal>
        <p class="md__h">Construido con piezas probadas y abiertas</p>
        <ul>
          {stack.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      </div>
    </div>
  </section>

  <!-- -------------------------------------------------------------- copiloto -->
  <section class="section" id="copiloto">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Copiloto del despacho</p>
        <h2 data-split>Pregúntale a tu despacho. Te contesta con tus datos<span class="comma">,</span></h2>
        <p class="lead" data-reveal style="--d:2">
          Todo lo que entra queda ordenado y consultable. Pregunta como se lo preguntarías a un
          compañero y obtén la respuesta, la tabla o el borrador para el cliente.
        </p>
      </div>
      <div data-reveal>
        <Copilot />
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------------------------- cierre -->
  <section class="section night bd" data-dark>
    <div class="wrap grid-2 bd__grid">
      <div class="bd__copy">
        <p class="eyebrow" data-reveal>Cierre trimestral</p>
        <h2 data-split>Sabes quién falta antes de que falte<span class="comma">,</span></h2>
        <p class="lead" data-reveal style="--d:2">
          Un panel con el estado de cada cliente y recordatorios que salen solos, con el tono de tu
          despacho. Nadie tiene que perseguir a nadie.
        </p>
        <ul class="bd__points" data-reveal style="--d:3">
          <li><strong>Avisos con lo que falta</strong>, no con un «mándame todo».</li>
          <li><strong>Por el canal del cliente</strong>: email o WhatsApp.</li>
          <li><strong>Escalado a una persona</strong> si el cliente no responde.</li>
        </ul>
      </div>
      <div data-reveal style="--d:2">
        <CloseBoard />
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------ diferencia -->
  <section class="section sand" id="diferencia">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Por qué COMA</p>
        <h2 data-split>No te vendemos otro programa. Conectamos los que ya tienes<span class="comma">,</span></h2>
        <p class="lead" data-reveal style="--d:2">
          Las herramientas de captura son buenas, pero son una pieza más que tu equipo y tus clientes
          tienen que adoptar. Nosotros montamos el flujo entero, a medida, y lo mantenemos.
        </p>
      </div>
      <table class="vs" data-reveal>
        <caption class="sr-only">Comparativa entre una herramienta de captura genérica y COMA para despachos</caption>
        <thead>
          <tr class="vs__row vs__row--head">
            <th scope="col"><span class="sr-only">Aspecto</span></th>
            <th scope="col">Herramienta de captura genérica</th>
            <th scope="col">COMA para despachos</th>
          </tr>
        </thead>
        <tbody>
          {
            compare.map((c) => (
              <tr class="vs__row">
                <th scope="row">{c.what}</th>
                <td class="vs__tool">{c.tool}</td>
                <td class="vs__coma">{c.coma}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- ------------------------------------------------------------ calculadora -->
  <section class="section" id="ahorro">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Calcula tu ahorro</p>
        <h2 data-split>¿Cuántas horas le devuelves a tu despacho<span class="comma">?</span></h2>
        <p class="lead" data-reveal style="--d:2">
          Mueve los datos de tu despacho. El tiempo que hoy se va en teclear puede ir a asesorar,
          captar clientes o, simplemente, salir a tu hora.
        </p>
      </div>
      <div data-reveal>
        <RoiCalc />
      </div>
    </div>
  </section>

  <!-- --------------------------------------------------------------- precios -->
  <section class="section sand" id="precios">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Precios</p>
        <h2 data-split>Precio claro para empezar. El resto, bajo demanda<span class="comma">,</span></h2>
        <p class="lead" data-reveal style="--d:2">
          Una puesta en marcha y una cuota mensual sin permanencia. Antes de pagar nada, el diagnóstico
          es gratis y el piloto se hace con tus clientes reales.
        </p>
      </div>
      <ul class="pl">
        {
          plans.map((p, i) => (
            <li class:list={["pl__card", { "pl__card--hot": p.featured }]} data-reveal style={`--d:${i}`}>
              {p.featured && <span class="pl__badge">Recomendado</span>}
              <h3>{p.name}</h3>
              <p class="pl__price">
                {p.setup === null ? (
                  <strong>{p.priceLabel}</strong>
                ) : (
                  <>
                    <strong>{eur(p.month ?? 0)}</strong>
                    <span>/mes</span>
                  </>
                )}
              </p>
              <p class="pl__setup">{p.setup === null ? "Sin compromiso" : `+ ${eur(p.setup)} de puesta en marcha`}</p>
              <p class="pl__pitch">{p.pitch}</p>
              <ul class="pl__inc">
                {p.includes.map((x) => <li>{x}</li>)}
              </ul>
              <a
                class:list={["btn", p.featured ? "btn--red" : "btn--ghost"]}
                href={diagnosticoMail(`Me interesa: ${p.name}.`)}
                data-track-label={`despachos-plan-${p.id}`}
              >
                {p.cta} <Arrow />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="od">
        <div class="od__head" data-reveal>
          <h3>Bajo demanda</h3>
          <p>Se suma cuando lo necesites, con precio cerrado por escrito.</p>
        </div>
        <ul class="od__list" data-reveal style="--d:1">
          {
            onDemand.map((o) => (
              <li>
                {o.href ? <a href={o.href}>{o.name}</a> : <span>{o.name}</span>}
                <small>{o.note}</small>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="pl__legal" data-reveal>
        Precios sin IVA y orientativos. El precio final queda cerrado por escrito tras el diagnóstico.
        Volúmenes mayores o varios despachos: a medida.
      </p>
    </div>
  </section>

  <!-- -------------------------------------------------------------- confianza -->
  <section class="section tz">
    <div class="wrap tz__inner">
      <div class="tz__head">
        <p class="eyebrow" data-reveal>Hecho con un contable</p>
        <p class="tz__quote display" data-scrub>
          Lo hemos diseñado con un contable en ejercicio, no en una sala de reuniones. Por eso
          automatiza lo que sobra y deja a tu equipo lo que importa: el criterio.
        </p>
        <p class="tz__sign" data-reveal>
          COMA · {years()} años contando historias de empresas · más de {trust.pymes} pymes
        </p>
      </div>
      <ul class="tz__list">
        {
          promises.map((p, i) => (
            <li data-reveal style={`--d:${i % 2}`}>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Trust />
  <Process eyebrow="Cómo empezamos" title="Sin saltos al vacío: primero un piloto" steps={steps} />
  <Faq items={faq} />
  <Cta
    title="Recupera el trimestre. Empieza por un diagnóstico gratis"
    subject={despachosSubject}
    lead="Escríbenos y responde a cinco preguntas que ya te dejamos en el email. En 30 minutos sabrás cuántas horas puedes recuperar y cuánto cuesta, por escrito."
    action={{ href: mail, label: "Pedir diagnóstico" }}
    mail={mail}
  />

  <div class="sticky-cta" data-sticky-cta>
    <span>Diagnóstico <strong>gratis</strong> <span class="muted-sm">· 30 min</span></span>
    <a class="btn btn--red" href={mail} tabindex="-1" data-track-label="despachos-sticky">Escríbenos <Arrow /></a>
  </div>
</Base>

<style>
  /* ---------------------------------------------------------------- portada */
  .dh {
    padding-top: clamp(8.5rem, 15vw, 11rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .dh__inner {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .dh__inner {
      grid-template-columns: 1.2fr 1fr;
      gap: 4rem;
    }
  }
  .dh__copy {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .dh h1 {
    font-size: clamp(1.9rem, 0.6rem + 4.6vw, 5.4rem);
    max-width: 16ch;
    letter-spacing: -0.05em;
  }
  @media (max-width: 479px) {
    .dh h1 {
      font-variation-settings: "wdth" 100;
    }
  }
  .dh__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }
  .dh__chips .chip::before {
    content: "✓";
    color: var(--red);
    margin-right: 0.45rem;
    font-weight: 700;
  }
  .dh__art {
    display: grid;
  }
  .dh__proof {
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .dh__proof strong {
    color: var(--ink);
    border-bottom: 2px solid var(--red);
  }

  /* -------------------------------------------------------------- whatsapp */
  .wz__grid {
    align-items: center;
  }
  .wz__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .wz__points {
    display: grid;
    gap: 0.6rem;
  }
  .wz__points li {
    padding-left: 1.5rem;
    position: relative;
  }
  .wz__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--red);
  }

  /* ------------------------------------------------------------- diferencia */
  .vs {
    display: block;
    width: 100%;
    border-collapse: collapse;
    border-top: 2px solid var(--ink);
    text-align: left;
  }
  .vs thead,
  .vs tbody {
    display: block;
  }
  .vs th,
  .vs td {
    display: block;
    padding: 0;
    font-weight: inherit;
  }
  .vs__row {
    display: grid;
    gap: 0.35rem 2rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 800px) {
    .vs__row {
      grid-template-columns: 0.8fr 1.1fr 1.3fr;
      align-items: baseline;
    }
  }
  .vs__row > th[scope="row"] {
    font-variation-settings: "wdth" 112;
    font-weight: 700;
    font-size: var(--fs-lg);
    letter-spacing: -0.02em;
  }
  .vs__tool {
    color: var(--muted);
  }
  .vs__tool::before {
    content: "— ";
  }
  .vs__coma {
    font-weight: 600;
  }
  .vs__coma::before {
    content: "✓ ";
    color: var(--red);
    font-weight: 800;
  }
  .vs__row--head {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .vs__row--head > :last-child {
    color: var(--red);
  }
  @media (max-width: 799px) {
    .vs__row--head {
      display: none;
    }
    .vs__tool,
    .vs__coma {
      font-size: var(--fs-sm);
    }
  }

  /* ------------------------------------------------------------------ dolor */
  .pn__inner {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1000px) {
    .pn__inner {
      grid-template-columns: 0.9fr 1.3fr;
      gap: 6rem;
    }
    .pn__head {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
  }
  .pn__head {
    display: grid;
    gap: 1.25rem;
  }
  .pn__list {
    border-top: 2px solid var(--paper);
  }
  .pn__list li {
    display: grid;
    gap: 0.4rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
  }
  .pn__pain {
    justify-self: start;
    font-variation-settings: "wdth" 112;
    font-weight: 600;
    font-size: clamp(1.25rem, 0.95rem + 1.4vw, 2.1rem);
    letter-spacing: -0.035em;
    line-height: 1.12;
    transition: color 0.6s var(--ease) 0.7s;
  }
  /* tachado rojo al entrar en pantalla (una raya por línea, también si el texto salta de línea) */
  .pn__pain > span {
    background: linear-gradient(var(--red), var(--red)) 0 56% / 100% max(2px, 0.08em) no-repeat;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .pn__fix {
    color: #ff6b7f;
    font-weight: 600;
    font-size: var(--fs-lg);
  }
  .pn__list li.is-in .pn__pain {
    color: var(--night-muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .js .pn__pain > span {
      background-size: 0% max(2px, 0.08em);
      transition: background-size 0.8s var(--ease-io) 0.45s;
    }
    .js .pn__list li.is-in .pn__pain > span {
      background-size: 100% max(2px, 0.08em);
    }
    .js .pn__fix {
      opacity: 0;
