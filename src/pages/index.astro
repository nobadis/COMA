---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Trust from "../components/Trust.astro";
import Manifesto from "../components/Manifesto.astro";
import Timeline from "../components/Timeline.astro";
import Sectors from "../components/Sectors.astro";
import Process from "../components/Process.astro";
import KitBanner from "../components/KitBanner.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import ServicesStack from "../components/ServicesStack.astro";
import PriceExpand from "../components/PriceExpand.astro";
import Proof from "../components/Proof.astro";
import { site, trust, years } from "../data/site";
import { basePlan } from "../data/pricing";

const faq = [
  {
    title: `¿De verdad hacéis una web por ${basePlan.price} €?`,
    text: `Sí. La ${basePlan.name} cuesta ${basePlan.price} € ${basePlan.suffix}: una web profesional de una página, adaptada a móvil, con formulario de contacto, SEO básico y SSL. Si necesitas más (páginas, idiomas, blog, tienda, alojamiento, correo corporativo, IA…), lo añades como extra con presupuesto cerrado.`,
  },
  {
    title: "¿Trabajáis solo en Mallorca?",
    text: `No. Nacimos en Mallorca en ${site.since} y desde ${site.spainSince} trabajamos con empresas de toda España, en remoto y con la misma cercanía.`,
  },
  {
    title: "¿Qué es el GEO y por qué le importa a mi negocio?",
    text: "GEO (Generative Engine Optimization) es posicionar tu empresa en las respuestas de asistentes de IA como ChatGPT, Gemini o Perplexity. Cada vez más clientes preguntan a la IA antes de elegir; si no apareces, eligen a otro.",
  },
  {
    title: "¿Con qué tipo de empresas trabajáis?",
    text: `Con autónomos y pymes de cualquier sector: farmacias, clínicas dentales, despachos profesionales, consultorías, restauración, turismo, comercio y eventos como ${trust.headline}. Más de ${trust.pymes} pymes ya confían en nosotros.`,
  },
  {
    title: "¿Qué diferencia a COMA de otras agencias?",
    text: `Llevamos ${years()} años comunicando: revistas, radio, programas de televisión, webs, marketing digital y ahora IA. Unimos criterio de marca, tecnología y precios pensados para pymes en un único equipo.`,
  },
  {
    title: "¿Cómo empezamos?",
    text: "Escríbenos o rellena el brief de contacto. Te respondemos personalmente con una propuesta clara, con objetivos, plazos y precio cerrado.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((q) => ({
      "@type": "Question",
      name: q.title,
      acceptedAnswer: { "@type": "Answer", text: q.text },
    })),
  },
];
---

<Base
  description={`Diseño web desde ${basePlan.price} € + IVA, SEO y posicionamiento en IA (GEO), agentes de IA y automatizaciones para autónomos y pymes. Agencia en Mallorca desde ${site.since}, ahora en toda España.`}
  schema={schema}
>
  <Hero />
  <Trust />
  <Manifesto
    eyebrow="Cómo pensamos"
    text="Una web espectacular no es la que más se mueve. Es la que se entiende a la primera, se recuerda y te trae clientes. Diseño con carácter, estructura sencilla y un único objetivo: que te contacten."
  />
  <ServicesStack />
  <PriceExpand />
  <Proof />
  <Manifesto
    eyebrow="Quiénes somos"
    text={`Desde ${site.since} contamos historias de empresas. Empezamos con revistas, seguimos con la radio y la televisión, y llevamos más de ${trust.pymes} pymes a internet. Hoy sumamos SEO, inteligencia artificial y automatización. Lo que no ha cambiado: que tu marca se entienda, se recuerde y se elija.`}
  />
  <Timeline />
  <Sectors />
  <Process
    title="De la primera llamada a tu web publicada"
    steps={[
      { title: "Nos cuentas", text: "Tu negocio, tus clientes y lo que quieres conseguir. Sin tecnicismos ni compromiso." },
      { title: "Diseñamos", text: "Te enseñamos una propuesta visual y la ajustamos contigo hasta que te encante." },
      { title: "Publicamos", text: "Web online, rápida y lista para Google y la IA. Con SSL y formulario funcionando." },
      { title: "Creces", text: "Añade SEO, idiomas, tienda, agentes de IA o automatizaciones cuando lo necesites." },
    ]}
  />
  <KitBanner />
  <Faq items={faq} />
  <Cta />
</Base>
