---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Trust from "../components/Trust.astro";
import Manifesto from "../components/Manifesto.astro";
import Portal from "../components/Portal.astro";
import Timeline from "../components/Timeline.astro";
import Sectors from "../components/Sectors.astro";
import Process from "../components/Process.astro";
import KitBanner from "../components/KitBanner.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import ServicesStack from "../components/ServicesStack.astro";
import Proof from "../components/Proof.astro";
import { site } from "../data/site";
import { basePlan } from "../data/pricing";

const faq = [
  { title: "¿Qué tipo de proyectos desarrolla COMA?", text: "Webs, software a medida, integraciones, agentes de IA y automatización. Partimos del proceso que necesitas mejorar y definimos contigo qué construir, cómo entregarlo y cómo mantenerlo." },
  { title: "¿Cómo se presupuesta un proyecto a medida?", text: "Definimos objetivos, alcance, entregables y criterios de aceptación. Separamos implantación, infraestructura y soporte para que conozcas el coste de ponerlo en marcha y de operarlo." },
  { title: "¿Os encargáis de la entrega y el mantenimiento?", text: "Acordamos las pruebas, documentación y puesta en marcha. El soporte, mantenimiento y evolución se definen en la propuesta, tanto si lo operamos nosotros como si lo recibe tu equipo técnico." },
  { title: "¿Podemos empezar por un piloto?", text: "Sí. Cuando conviene validar una integración o un uso de IA, delimitamos un piloto con objetivos y pruebas antes de ampliar el proyecto." },
  { title: "¿Trabajáis solo en Mallorca?", text: `Tenemos sede en Palma desde ${site.since} y trabajamos con empresas de toda España.` },
  { title: "¿También hacéis webs sencillas?", text: `Sí. La ${basePlan.name} parte de ${basePlan.price} € ${basePlan.suffix}. Puedes consultar alcance y extras en Precios. Los proyectos de software e IA se valoran a medida.` },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((q) => ({
      "@type": "Question",
      name: q.title,
      acceptedAnswer: { "@type": "Answer", text: q.text },
    })),
  },
];
---

<Base
  title="Consultoría tecnológica, software a medida e IA"
  description="COMA: consultoría tecnológica en Mallorca para toda España. Software a medida, IA, automatización y diseño web. Del diagnóstico a la entrega, soporte y mantenimiento."
  schema={schema}
>
  <Hero />
  <Portal text="Menos trabajo repetitivo. Más tiempo para las personas que hacen avanzar tu empresa." />
  <ServicesStack />
  <Proof />
  <Manifesto
    eyebrow="Quiénes somos"
    text={`Desde ${site.since} contamos historias de empresas. Hoy unimos diseño, desarrollo e IA para mejorar cómo trabajan. Tecnología útil, de principio a fin.`}
  />
  <Timeline />
  <Sectors />
  <Process
    title="De la idea a una solución en marcha"
    steps={[
      { title: "Entendemos", text: "Revisamos el trabajo real, los sistemas y el objetivo. Definimos alcance, costes y criterios de aceptación." },
      { title: "Validamos", text: "Diseñamos la solución y, cuando hace falta, un piloto. Probamos lo importante antes de ampliar." },
      { title: "Entregamos", text: "Desarrollamos, integramos y comprobamos contigo. Puesta en marcha, documentación y formación acordadas." },
      { title: "Acompañamos", text: "Soporte, mantenimiento y mejoras con alcance definido. Para nuestro equipo o para el tuyo." },
    ]}
  />
  <Trust />
  <KitBanner />
  <Faq items={faq} />
  <Cta />
</Base>
