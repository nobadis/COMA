---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Trust from "../components/Trust.astro";
import Manifesto from "../components/Manifesto.astro";
import Portal from "../components/Portal.astro";
import Timeline from "../components/Timeline.astro";
import Sectors from "../components/Sectors.astro";
import Process from "../components/Process.astro";
import KitBanner from "../components/KitBanner.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import ServicesStack from "../components/ServicesStack.astro";
import PriceExpand from "../components/PriceExpand.astro";
import Proof from "../components/Proof.astro";
import { site, trust, years } from "../data/site";
import { basePlan } from "../data/pricing";

const faq = [
  {
    title: `¿De verdad hacéis una web por ${basePlan.price} €?`,
    text: `Sí. La ${basePlan.name} son ${basePlan.price} € ${basePlan.suffix}: hasta 4 páginas (Inicio, Servicios, Nosotros y Contacto), móvil, formulario, SEO básico y SSL. Tienda, reservas, idiomas o IA se añaden con precio cerrado.`,
  },
  {
    title: "¿Trabajáis solo en Mallorca?",
    text: `No. La sede está en Palma desde ${site.since}. Desde ${site.spainSince} trabajamos con toda España, en remoto.`,
  },
  {
    title: "¿Qué es el GEO y por qué le importa a mi negocio?",
    text: "Es aparecer en las respuestas de ChatGPT, Gemini o Perplexity. Cada vez más clientes preguntan a la IA antes de llamar. Si no sales, eligen a otro.",
  },
  {
    title: "¿Con qué tipo de empresas trabajáis?",
    text: `Autónomos y pymes: farmacias, clínicas, despachos, restauración, turismo, comercio y eventos como ${trust.headline}. Más de ${trust.pymes} pymes ya trabajan con nosotros.`,
  },
  {
    title: "¿Por qué sois tan baratos?",
    text: "Proceso propio, sin plantillas ni intermediarios, y el precio cerrado desde el primer día.",
  },
  {
    title: "¿Qué diferencia a COMA de otras agencias?",
    text: `${years()} años comunicando: revistas, radio, televisión, webs y ahora IA. Marca, tecnología y precio de pyme, en un solo equipo.`,
  },
  {
    title: "¿Cómo empezamos?",
    text: "Rellena el brief o escríbenos. Te respondemos en persona con objetivos, plazos y precio cerrado.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((q) => ({
      "@type": "Question",
      name: q.title,
      acceptedAnswer: { "@type": "Answer", text: q.text },
    })),
  },
];
---

<Base
  description={`Diseño web desde ${basePlan.price} € + IVA, SEO y posicionamiento en IA (GEO), agentes de IA y automatizaciones para autónomos y pymes. Agencia en Mallorca desde ${site.since}, ahora en toda España.`}
  schema={schema}
>
  <Hero />
  <Portal text="Diseño con carácter, fácil de leer y un solo camino: que te contacten." />
  <ServicesStack />
  <PriceExpand />
  <Proof />
  <Manifesto
    eyebrow="Quiénes somos"
    text={`Desde ${site.since} contamos historias de empresas. Hoy sumamos web, SEO e IA. Lo que no cambia: que tu marca se entienda y se elija.`}
  />
  <Timeline />
  <Sectors />
  <Process
    title="De la primera llamada a tu web publicada"
    steps={[
      { title: "Nos cuentas", text: "Tu negocio, tus clientes y lo que quieres conseguir. Sin tecnicismos ni compromiso." },
      { title: "Diseñamos", text: "Te enseñamos una propuesta visual y la ajustamos contigo hasta que te encante." },
      { title: "Publicamos", text: "Web online, rápida y lista para Google y la IA. Con SSL y formulario funcionando." },
      { title: "Creces", text: "Añade SEO, idiomas, tienda, agentes de IA o automatizaciones cuando lo necesites." },
    ]}
  />
  <Trust />
  <KitBanner />
  <Faq items={faq} />
  <Cta />
</Base>
