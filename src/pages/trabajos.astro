---
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import SiteMock from "../components/SiteMock.astro";
import Trust from "../components/Trust.astro";
import Sectors from "../components/Sectors.astro";
import Cta from "../components/Cta.astro";
import { works } from "../data/work";
import { trust } from "../data/site";
---

<Base
  title="Trabajos y ejemplos de diseño web"
  description={`Ejemplos de diseño web por sector: clínicas dentales, farmacias, despachos, restaurantes, hoteles y festivales. Confían en nosotros ${trust.headline} y más de ${trust.pymes} pymes.`}
  crumbs={[{ name: "Trabajos", path: "/trabajos/" }]}
>
  <section class="ph wrap">
    <p class="eyebrow" data-reveal>Trabajos y conceptos</p>
    <h1 data-split>Webs que hacen que te elijan<span class="comma">,</span></h1>
    <p class="lead" data-reveal style="--d:3">
      Ejemplos de diseño por sector para que veas hasta dónde puede llegar tu web. Cada proyecto lo
      diseñamos a medida para tu marca y tus clientes.
    </p>
    <a class="btn btn--red btn--lg" href="/contacto/?plan=web" data-reveal style="--d:4">
      Quiero una así <Arrow />
    </a>
  </section>

  <section class="wrap wk">
    <ol class="wk__grid">
      {
        works.map((w, i) => (
          <li class="wk__item" data-reveal style={`--d:${i % 2}`}>
            <SiteMock work={w} />
            <div class="wk__meta">
              <h2>{w.sector}</h2>
              <ul class="chips">
                {w.tags.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <Trust />
  <Sectors />
  <Cta title="¿Diseñamos la tuya?" subject="Quiero una web como las de vuestros trabajos" />
</Base>

<style>
  .ph {
    padding-top: clamp(9rem, 16vw, 12rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .wk {
    padding-bottom: clamp(4rem, 9vw, 8rem);
  }
  .wk__grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (min-width: 900px) {
    .wk__grid {
      grid-template-columns: 1fr 1fr;
    }
    .wk__item:nth-child(even) {
      margin-top: 6rem;
    }
  }
  .wk__item {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .wk__item :global(.mk) {
    transition: transform 0.7s var(--ease);
  }
  .wk__item:hover :global(.mk) {
    transform: translateY(-8px) rotate(-0.6deg);
  }
  .wk__meta {
    display: grid;
    gap: 0.75rem;
  }
  .wk__meta h2 {
    font-size: 1.6rem;
  }
</style>
