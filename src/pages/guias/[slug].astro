---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Faq from "../../components/Faq.astro";
import Cta from "../../components/Cta.astro";
import { guides, guideBySlug, type Guide } from "../../data/guides";
import { site, years } from "../../data/site";

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props;
const guide = g as Guide;
const url = `${site.url}/guias/${guide.slug}/`;
const related = guide.related.map((s) => guideBySlug(s)).filter(Boolean) as Guide[];
const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" });

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${url}#article`,
    headline: guide.h1,
    description: guide.description,
    datePublished: guide.published,
    dateModified: guide.modified,
    inLanguage: "es-ES",
    mainEntityOfPage: { "@id": `${url}#page` },
    image: `${site.url}/og-coma.png`,
    author: { "@id": `${site.url}/#org` },
    publisher: { "@id": `${site.url}/#org` },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: guide.faq.map((q) => ({
      "@type": "Question",
      name: q.title,
      acceptedAnswer: { "@type": "Answer", text: q.text },
    })),
  },
];
---

<Base
  title={guide.title}
  description={guide.description}
  type="article"
  published={guide.published}
  modified={guide.modified}
  schema={schema}
  crumbs={[
    { name: "Guías", path: "/guias/" },
    { name: guide.title, path: `/guias/${guide.slug}/` },
  ]}
>
  <article class="ga">
    <header class="ga__head wrap">
      <p class="eyebrow" data-reveal>Guía · {guide.readMin} min</p>
      <h1 data-split>{guide.h1}</h1>
      <p class="ga__meta" data-reveal style="--d:2">
        Por el equipo de COMA ({years()} años comunicando empresas desde Mallorca) · Actualizado el
        <time datetime={guide.modified}> {fmt(guide.modified)}</time>
      </p>
      <p class="lead" data-reveal style="--d:3">{guide.intro}</p>
    </header>

    <div class="ga__body wrap">
      {
        guide.sections.map((s) => (
          <section>
            <h2>{s.h2}</h2>
            {s.paragraphs.map((p) => <p>{p}</p>)}
            {s.list && <ul>{s.list.map((li) => <li>{li}</li>)}</ul>}
          </section>
        ))
      }
      <aside class="ga__cta">
        <p>¿Te ayudamos con esto?</p>
        <a class="btn btn--red" href={guide.cta.href} data-track="cta_click" data-track-label={`guia-${guide.slug}`}>
          {guide.cta.label} <Arrow />
        </a>
      </aside>
    </div>
  </article>

  <Faq items={guide.faq} title="Preguntas rápidas" />

  {
    related.length > 0 && (
      <section class="section ga__rel">
        <div class="wrap">
          <h2>Sigue leyendo</h2>
          <ul>
            {related.map((r) => (
              <li><a href={`/guias/${r.slug}/`}>{r.title}</a></li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
  <Cta />
</Base>

<style>
  .ga__head {
    padding-top: clamp(8.5rem, 15vw, 12rem);
    padding-bottom: 2rem;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .ga__head h1 {
    font-size: clamp(1.8rem, 1rem + 4vw, 4.2rem);
    max-width: 22ch;
    letter-spacing: -0.045em;
  }
  .ga__meta {
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .ga__body {
    display: grid;
    gap: 2.5rem;
    max-width: 46rem;
    margin-inline: auto;
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  .ga__body section {
    display: grid;
    gap: 1rem;
    font-size: var(--fs-md);
    line-height: 1.7;
  }
  .ga__body h2 {
    font-size: var(--fs-xl);
    line-height: 1.1;
  }
  .ga__body ul {
    padding-left: 1.25rem;
    display: grid;
    gap: 0.55rem;
  }
  .ga__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--ink);
    font-weight: 600;
  }
  .ga__rel {
    background: var(--paper-2);
  }
  .ga__rel h2 {
    font-size: var(--fs-xl);
    margin-bottom: 1rem;
  }
  .ga__rel ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
</style>
