---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Faq from "../../components/Faq.astro";
import Cta from "../../components/Cta.astro";
import Trust from "../../components/Trust.astro";
import { places, placeBySlug, childrenOf, inPlace } from "../../data/places";
import { localServiceSlugs, presence, serviceLabel, placeTrail } from "../../data/local";
import { services } from "../../data/services";
import { site, years } from "../../data/site";
import { basePlan } from "../../data/pricing";

export function getStaticPaths() {
  return places.map((p) => ({ params: { place: p.slug }, props: { placeSlug: p.slug } }));
}
const { placeSlug } = Astro.props as { placeSlug: string };
const place = placeBySlug(placeSlug)!;
const where = inPlace(place);
const trail = placeTrail(place);
const inside = childrenOf(place.slug);
const near = (place.near ?? []).map((s) => placeBySlug(s)!).filter(Boolean);
const url = `${site.url}/zonas/${place.slug}/`;

const faq = [
  {
    title: `¿Qué servicios ofrecéis ${where}?`,
    text: `Diseño web desde ${basePlan.price} € + IVA, SEO local y GEO (posicionamiento en IA), agentes de IA, automatizaciones y notoriedad de marca en medios. Todo con precio claro y sin plantillas.`,
  },
  {
    title: `¿Trabajáis con empresas ${where}?`,
    text: presence(place),
  },
  {
    title: `¿Cuánto cuesta una web ${where}?`,
    text: `Desde ${basePlan.price} € ${basePlan.suffix} la Web Esencial, con hasta 4 páginas, adaptada a móvil, formulario, SEO básico y SSL. El mismo precio ${where} que en el resto de España.`,
  },
];
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${url}#page`,
    url,
    name: `COMA ${where}`,
    isPartOf: { "@id": `${site.url}/#web` },
    about: { "@id": `${site.url}/#org` },
    inLanguage: "es-ES",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((q) => ({
      "@type": "Question",
      name: q.title,
      acceptedAnswer: { "@type": "Answer", text: q.text },
    })),
  },
];
---

<Base
  title={`Diseño web, SEO e IA ${where}`}
  description={`Diseño web desde ${basePlan.price} €, SEO, GEO y agentes de IA ${where}. ${years()} años de experiencia; sede en Palma.`}
  crumbs={[{ name: "Zonas", path: "/zonas/" }, ...trail.map((t) => ({ name: t.name, path: `/zonas/${t.slug}/` }))]}
  schema={schema}
>
  <section class="page-head wrap">
    <p class="eyebrow" data-reveal>Agencia de marketing digital {where}</p>
    <h1 data-split>Diseño web, SEO e IA {where}<span class="comma">.</span></h1>
    <p class="lead" data-reveal style="--d:3">{place.local}</p>
    <a class="btn btn--red btn--lg" href="/contacto/" data-magnetic data-track="cta_click" data-track-label={`zona-${place.slug}`} data-reveal style="--d:4">
      Pedir propuesta <Arrow />
    </a>
  </section>

  <section class="section zp">
    <div class="wrap zp__grid">
      <div>
        <p class="eyebrow">Cómo se compite</p>
        <h2>{place.name} en una frase</h2>
      </div>
      <div class="zp__text">
        <p>{place.angle}</p>
        <p>Sectores con más movimiento: {place.sectors.join(", ").toLowerCase()}.</p>
        {place.languages && <p>Idiomas a cuidar en la web: {place.languages.join(", ")}.</p>}
        <p class="zp__presence">{presence(place)}</p>
      </div>
    </div>
  </section>

  <section class="section night zp-s" data-dark>
    <div class="wrap">
      <p class="eyebrow">Servicios {where}</p>
      <h2>Lo que hacemos {where}</h2>
      <ul class="zp-s__list">
        {localServiceSlugs.map((s) => {
          const svc = services.find((x) => x.slug === s)!;
          return (
            <li>
              <h3><a href={`/${s}/${place.slug}/`}>{serviceLabel(s)} {where}</a></h3>
              <p>{svc.summary}</p>
            </li>
          );
        })}
        {["automatizaciones", "notoriedad-de-marca"].map((s) => {
          const svc = services.find((x) => x.slug === s)!;
          return (
            <li>
              <h3><a href={`/${s}/`}>{svc.label}</a></h3>
              <p>{svc.summary}</p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <Trust />

  {
    (inside.length > 0 || near.length > 0) && (
      <section class="section zp-l">
        <div class="wrap zp-l__grid">
          {inside.length > 0 && (
            <div>
              <h2>Dentro de {place.name}</h2>
              <ul>
                {inside.map((c) => (<li><a href={`/zonas/${c.slug}/`}>{c.name}</a></li>))}
              </ul>
            </div>
          )}
          {near.length > 0 && (
            <div>
              <h2>Cerca de {place.name}</h2>
              <ul>
                {near.map((c) => (<li><a href={`/zonas/${c.slug}/`}>{c.name}</a></li>))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }

  <Faq items={faq} />
  <Cta title={`¿Empezamos ${where}?`} subject={`Consulta desde ${place.name}`} />
</Base>

<style>
  .zp__grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 1000px) {
    .zp__grid {
      grid-template-columns: 1fr 1.4fr;
      gap: 5rem;
    }
  }
  .zp__text {
    display: grid;
    gap: 1.1rem;
    font-size: var(--fs-md);
    line-height: 1.6;
    max-width: 62ch;
  }
  .zp__presence {
    border-left: 3px solid var(--red);
    padding-left: 1rem;
    color: var(--muted);
  }
  .zp-s__list {
    list-style: none;
    padding: 0;
    margin-top: 2.5rem;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 800px) {
    .zp-s__list {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 3rem;
    }
  }
  .zp-s__list li {
    border-top: 1px solid var(--night-line);
    padding-top: 1rem;
    display: grid;
    gap: 0.5rem;
  }
  .zp-s__list h3 a {
    text-decoration: none;
  }
  .zp-s__list p {
    color: var(--night-muted);
    line-height: 1.55;
  }
  .zp-l {
    background: var(--paper-2);
  }
  .zp-l__grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 800px) {
    .zp-l__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .zp-l h2 {
    font-size: var(--fs-xl);
    margin-bottom: 1rem;
  }
  .zp-l ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
  }
</style>
