---
import Base from "../layouts/Base.astro";
import Configurator from "../components/Configurator.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import Trust from "../components/Trust.astro";
import { basePlan } from "../data/pricing";
import { site } from "../data/site";

const faq = [
  {
    title: `¿Qué incluye la web de ${basePlan.price} €?`,
    text: `${basePlan.includes.join(". ")}. El precio es ${basePlan.price} € ${basePlan.suffix}.`,
  },
  {
    title: "¿Cuánto cuestan los extras?",
    text: "Cada extra tiene su precio a la vista y el presupuesto se actualiza al instante mientras eliges. Lo que depende de tu caso (agentes de IA, automatizaciones, medios) se presupuesta a medida tras una llamada gratuita.",
  },
  {
    title: "¿Puedo ampliar mi web más adelante?",
    text: "Sí. Empieza con lo esencial y añade páginas, idiomas, blog, tienda online, agentes de IA o automatizaciones cuando tu negocio lo pida.",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: `${basePlan.name} - Diseño web profesional`,
    description: basePlan.pitch,
    brand: { "@type": "Brand", name: site.brand },
    offers: {
      "@type": "Offer",
      price: basePlan.price,
      priceCurrency: "EUR",
      availability: "https://schema.org/InStock",
      url: `${site.url}/precios/`,
      seller: { "@id": `${site.url}/#org` },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((q) => ({ "@type": "Question", name: q.title, acceptedAnswer: { "@type": "Answer", text: q.text } })),
  },
];
---

<Base
  title={`Precios: web profesional desde ${basePlan.price} € + IVA`}
  description={`Diseño web desde ${basePlan.price} € + IVA para autónomos y pymes. Extras a la carta: multiidioma, alojamiento, correo corporativo, blog, tienda online, SEO, agentes de IA y automatizaciones.`}
  crumbs={[{ name: "Precios", path: "/precios/" }]}
  schema={schema}
>
  <section class="page-head wrap">
    <p class="eyebrow" data-reveal>Precios y presupuesto en directo</p>
    <h1 data-split>Monta tu web. El precio, a la vista<span class="comma">.</span></h1>
    <p class="lead" data-reveal style="--d:3">
      Empiezas por {basePlan.price} € + IVA y añades solo lo que necesitas. Cada elección actualiza tu
      presupuesto al momento. La IA y las automatizaciones, a medida.
    </p>
  </section>
  <Configurator heading={false} />
  <Trust />
  <Faq items={faq} />
  <Cta />
</Base>
