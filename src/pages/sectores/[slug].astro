---
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import Faq from "../../components/Faq.astro";
import Cta from "../../components/Cta.astro";
import Trust from "../../components/Trust.astro";
import { niches, nicheBySlug, nicheGroups, nichePack, priceFaq, eur, type Niche } from "../../data/niches";
import { solutions } from "../../data/solutions";
import { site } from "../../data/site";
import { basePlan } from "../../data/pricing";

export function getStaticPaths() {
  return niches.map((n) => ({ params: { slug: n.slug }, props: { n } }));
}
const n = Astro.props.n as Niche;
const url = `${site.url}/sectores/${n.slug}/`;
const pk = nichePack(n);
const faq = [priceFaq(n), ...n.faq];
const group = nicheGroups.find((g) => g.id === n.group)!;
const related = n.related.map((s) => nicheBySlug(s)).filter(Boolean) as Niche[];
const sols = solutions.filter((s) => s.niches.includes(n.slug)).slice(0, 5);
const packQuery = n.pack.map((p) => (p.qty && p.qty > 1 ? `${p.id}:${p.qty}` : p.id)).join(",");
const per = (b: string) => (b === "month" ? "/mes" : b === "year" ? "/año" : "");

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${url}#service`,
    name: `Diseño web, automatización e IA para ${n.forWho}`,
    serviceType: `Diseño web para ${n.forWho}`,
    description: n.description,
    url,
    provider: { "@id": `${site.url}/#org` },
    areaServed: [
      { "@type": "Country", name: "España" },
      { "@type": "AdministrativeArea", name: "Illes Balears" },
    ],
    audience: { "@type": "BusinessAudience", audienceType: n.name },
    keywords: n.searches.join(", "),
    offers: {
      "@type": "Offer",
      name: `Paquete web para ${n.forWho}`,
      price: pk.once,
      priceCurrency: "EUR",
      priceSpecification: {
        "@type": "PriceSpecification",
        price: pk.once,
        priceCurrency: "EUR",
        valueAddedTaxIncluded: false,
      },
      url: `${site.url}/precios/`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((q) => ({
      "@type": "Question",
      name: q.title,
      acceptedAnswer: { "@type": "Answer", text: q.text },
    })),
  },
];
---

<Base
  title={n.title}
  description={n.description}
  schema={schema}
  crumbs={[
    { name: "Sectores", path: "/sectores/" },
    { name: n.name, path: `/sectores/${n.slug}/` },
  ]}
>
  <section class="nx-h">
    <div class="wrap nx-h__in">
      <p class="eyebrow" data-reveal>{n.name} · desde {basePlan.price} € + IVA</p>
      <h1 data-split>{n.h1}<span class="comma">.</span></h1>
      <p class="lead" data-reveal style="--d:3">{n.lead}</p>
      <div class="nx-h__cta" data-reveal style="--d:4">
        <a class="btn btn--red btn--lg" href="/contacto/" data-magnetic data-track="cta_click" data-track-label={`sector-${n.slug}`}>
          Pedir propuesta <Arrow />
        </a>
        <a class="link-arrow" href={`/precios/?pack=${packQuery}#presupuesto`}>Ver mi presupuesto</a>
      </div>
      <nav class="nx-h__trail" aria-label="Ubicación">
        <a href="/sectores/">Sectores</a><span aria-hidden="true">/</span><a href={`/sectores/#${n.group}`}>{group.label}</a>
      </nav>
    </div>
  </section>

  <section class="section nx-why">
    <div class="wrap nx-why__grid">
      <div>
        <p class="eyebrow">El punto de partida</p>
        <h2>Qué cambia con una buena web</h2>
      </div>
      <div class="nx-why__text">
        {n.context.map((t) => <p>{t}</p>)}
        <p class="nx-why__local"><strong>En Mallorca.</strong> {n.mallorca}</p>
      </div>
    </div>
  </section>

  <section class="section night nx-do" data-dark>
    <div class="wrap">
      <p class="eyebrow">Tu web</p>
      <h2>Qué lleva una web para {n.forWho}</h2>
      <ul class="nx-do__list">
        {n.web.map((b, i) => (
          <li>
            <span aria-hidden="true">0{i + 1}</span>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </li>
        ))}
      </ul>

      <div class="nx-pack">
        <p class="nx-pack__lab">Paquete recomendado</p>
        <ul>
          {pk.lines.map((l) => (
            <li>
              <span>{l.name}{l.qty > 1 ? ` × ${l.qty}` : ""}</span>
              <span>{eur(l.amount)}{per(l.billing)}</span>
            </li>
          ))}
        </ul>
        <p class="nx-pack__total">
          <strong>{eur(pk.once)}</strong> + IVA, pago único
          {pk.month > 0 && <span> · {eur(pk.month)}/mes + IVA</span>}
          {pk.year > 0 && <span> · {eur(pk.year)}/año + IVA</span>}
        </p>
        <p class="nx-pack__note">{n.packNote}</p>
        <a class="link-arrow" href={`/precios/?pack=${packQuery}#presupuesto`}>Ajustarlo en el presupuesto en directo</a>
      </div>
    </div>
  </section>

  <section class="section nx-auto">
    <div class="wrap">
      <p class="eyebrow">Automatización e IA</p>
      <h2>Lo que puede hacerse solo</h2>
      <ul class="nx-auto__list">
        {n.automations.map((a) => (
          <li>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))}
      </ul>
      <p class="nx-auto__agent"><strong>Agente de IA.</strong> {n.agent}</p>
      <p class="nx-auto__more">
        <a href="/automatizaciones/">Soluciones a medida</a> · <a href="/agentes-ia/">IA aplicada</a> · presupuesto cerrado tras una llamada.
      </p>
    </div>
  </section>

  <Trust />

  <section class="section nx-links">
    <div class="wrap nx-links__grid">
      <div>
        <h2>Sectores parecidos</h2>
        <ul>
          {related.map((r) => (
            <li><a href={`/sectores/${r.slug}/`}>Web para {r.forWho}</a></li>
          ))}
          <li><a href="/sectores/">Todos los sectores</a></li>
        </ul>
      </div>
      {sols.length > 0 && (
        <div>
          <h2>Te puede interesar</h2>
          <ul>
            {sols.map((s) => (
              <li><a href={`/soluciones/${s.slug}/`}>{s.name}</a></li>
            ))}
          </ul>
        </div>
      )}
      <div>
        <h2>Más de COMA</h2>
        <ul>
          {n.link && <li><a href={n.link.href}>{n.link.label}</a></li>}
          <li><a href="/diseno-web/mallorca/">Diseño web en Mallorca</a></li>
          <li><a href="/seo-geo/">SEO y posicionamiento en IA</a></li>
          <li><a href="/precios/">Presupuesto en directo</a></li>
          <li><a href="/zonas/">Toda España, en remoto</a></li>
        </ul>
      </div>
    </div>
  </section>

  <Faq items={faq} title={`Preguntas sobre webs para ${n.forWho}`} />
  <Cta title="¿Te enseñamos cómo sería tu web?" subject={`Web para ${n.forWho}`} />
</Base>

<style>
  .nx-h {
    padding-top: clamp(8.5rem, 15vw, 12rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .nx-h__in {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .nx-h h1 {
    font-size: clamp(1.7rem, 0.6rem + 5vw, 5.2rem);
    max-width: 20ch;
    letter-spacing: -0.05em;
  }
  .nx-h__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }
  .nx-h__trail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .nx-h__trail a {
    color: inherit;
    text-underline-offset: 0.2em;
  }
  .nx-why__grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 1000px) {
    .nx-why__grid {
      grid-template-columns: 1fr 1.4fr;
      gap: 5rem;
    }
  }
  .nx-why__text {
    display: grid;
    gap: 1.1rem;
    font-size: var(--fs-md);
    line-height: 1.6;
    max-width: 62ch;
  }
  .nx-why__local {
    border-left: 3px solid var(--red);
    padding-left: 1rem;
    color: var(--muted);
  }
  .nx-do__list,
  .nx-auto__list {
    list-style: none;
    padding: 0;
    margin-top: 2.5rem;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 800px) {
    .nx-do__list {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 3rem;
    }
    .nx-auto__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
  .nx-do__list li,
  .nx-auto__list li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: 1rem;
    border-top: 1px solid var(--night-line);
  }
  .nx-auto__list li {
    border-top-color: var(--ink);
  }
  .nx-do__list span {
    color: var(--red);
    font-variation-settings: "wdth" 125;
    font-weight: 700;
  }
  .nx-do__list p,
  .nx-auto__list p {
    color: var(--muted);
    line-height: 1.55;
  }
  .nx-pack {
    margin-top: 3rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--night-line);
    display: grid;
    gap: 0.9rem;
    max-width: 40rem;
  }
  .nx-pack__lab {
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .nx-pack ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .nx-pack li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px dashed var(--night-line);
    padding-bottom: 0.4rem;
  }
  .nx-pack__total strong {
    font-size: var(--fs-2xl);
    font-variation-settings: "wdth" 125;
  }
  .nx-pack__note {
    color: var(--muted);
  }
  .nx-auto__agent {
    margin-top: 2.5rem;
    max-width: 62ch;
    border-left: 3px solid var(--red);
    padding-left: 1rem;
    line-height: 1.6;
  }
  .nx-auto__more {
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .nx-auto__more a {
    color: inherit;
    text-underline-offset: 0.2em;
  }
  .nx-links {
    background: var(--paper-2);
  }
  .nx-links__grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .nx-links__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .nx-links h2 {
    font-size: var(--fs-xl);
    margin-bottom: 1rem;
  }
  .nx-links ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .nx-links a {
    text-underline-offset: 0.2em;
  }
</style>
