---
import { Picture } from 'astro:assets';
import vino from '../../assets/photos/vino.jpg';
import sol from '../../assets/sol-rays.svg?raw';
---

<section class="qt sec" aria-label="Sentite en casa">
  <div class="wrap qt__grid">
    <figure class="qt__photo rv-img">
      <Picture
        src={vino}
        alt="Empanadas recién horneadas con una copa de vino tinto argentino"
        formats={['avif', 'webp']}
        widths={[420, 600]}
        sizes="(min-width: 960px) 32vw, 86vw"
        loading="lazy"
      />
    </figure>

    <blockquote class="qt__body">
      <span class="qt__sun rv" aria-hidden="true" set:html={sol} />
      <p class="qt__text rv" style="--d:1">
        Sentite en casa… <em>o viajá a Argentina en un bocado.</em>
      </p>
      <footer class="qt__by rv" style="--d:2">
        <span></span> Sabor Patricio · Cala Major
      </footer>
    </blockquote>
  </div>
</section>

<style>
  .qt {
    background: var(--white);
  }
  .qt__grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  .qt__photo {
    margin: 0;
    max-width: 460px;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .qt__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .qt__body {
    margin: 0;
  }
  .qt__sun {
    display: block;
    width: 34px;
    margin-bottom: 28px;
    color: var(--sol);
  }
  .qt__sun :global(svg) {
    width: 34px;
    height: 34px;
  }
  .qt__text {
    max-width: 18ch;
    font-family: var(--serif);
    font-size: clamp(2.1rem, 1.4rem + 2.6vw, 3.8rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--navy);
  }
  .qt__text em {
    color: var(--azul);
  }
  .qt__by {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 32px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .qt__by span {
    width: 36px;
    height: 1px;
    background: currentColor;
  }
  @media (min-width: 960px) {
    .qt__grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 112px;
    }
  }
</style>
