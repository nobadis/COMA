---
import { Picture } from 'astro:assets';
import vino from '../../assets/photos/vino.jpg';
import sunSvg from '../../assets/sol-rays.svg?raw';
---

<section class="bn on-dark" aria-label="Sentite en casa">
  <div class="bn__media" aria-hidden="true">
    <div class="bn__px" data-px="0.18">
      <Picture src={vino} alt="" formats={['avif', 'webp']} widths={[600]} sizes="100vw" loading="lazy" />
    </div>
  </div>
  <div class="wrap bn__in">
    <span class="bn__sun rv" aria-hidden="true" set:html={sunSvg} />
    <p class="bn__quote rv" style="--d:1">Sentite <em>en casa.</em></p>
    <p class="bn__brush rv" style="--d:2">…o viajá a Argentina en un bocado</p>
  </div>
</section>

<style>
  .bn {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(74vh, 680px);
    color: var(--white);
    overflow: clip;
    isolation: isolate;
  }
  .bn__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .bn__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(6 15 36 / 0.9) 0%, rgb(10 26 58 / 0.55) 55%, rgb(10 26 58 / 0.25) 100%),
      linear-gradient(0deg, rgb(6 15 36 / 0.6), transparent 40%);
  }
  .bn__px {
    position: absolute;
    inset: -18% 0;
  }
  .bn__px :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85);
  }
  .bn__in {
    padding-block: 120px;
  }
  .bn__sun {
    display: block;
    width: 44px;
    color: var(--sol);
    margin-bottom: 28px;
  }
  .bn__sun :global(svg) {
    width: 44px;
    height: 44px;
    animation: spin 30s linear infinite;
  }
  .bn__quote {
    font-size: clamp(2.8rem, 1.4rem + 5vw, 6.4rem);
    font-weight: 750;
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }
  .bn__quote em {
    display: block;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.08em;
    letter-spacing: -0.03em;
    text-transform: none;
    color: var(--celeste);
  }
  .bn__brush {
    margin-top: 22px;
    font-family: var(--brush);
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    line-height: 1.1;
    color: var(--sol-soft);
    transform: rotate(-2deg);
    transform-origin: left;
  }
  .js .bn__brush.rv.is-in {
    transform: rotate(-2deg);
  }
</style>
