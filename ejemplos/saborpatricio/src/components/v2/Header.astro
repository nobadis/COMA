---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-blanco-800.png';
import Icon from './Icon.astro';
import { igLink, site, telLink, waLink } from '../../config/site';

const left = [
  { href: '#obrador', label: 'Obrador' },
  { href: '#sabores', label: 'Sabores' },
  { href: '#carta', label: 'Carta' },
];
const right = [
  { href: '#catering', label: 'Catering' },
  { href: '#visitanos', label: 'Tienda' },
  { href: '#franquicias', label: 'Franquicias' },
];
const nav = [...left, ...right];
const order = waLink(`¡Hola ${site.name}! Quiero hacer un pedido 🥟`);
---

<header class="hd" data-hd>
  <div class="hd__top" aria-hidden="true">
    <div class="wrap hd__top-in">
      <span>Auténtica empanada argentina · Obrador en Mallorca</span>
      <span class="hd__top-r">
        <span>{site.address.street} · {site.address.area}</span>
        <span>{site.phone}</span>
      </span>
    </div>
  </div>

  <div class="wrap hd__in">
    <nav class="hd__nav hd__nav--l" aria-label="Principal">
      {left.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>

    <a class="hd__wa" href={order} target="_blank" rel="noopener" aria-label="Pedir por WhatsApp">
      <Icon name="whatsapp" size={20} />
    </a>

    <a href="#main" class="hd__logo" aria-label={`${site.name}, inicio`}>
      <Image src={logo} alt="" width={160} height={160} loading="eager" />
    </a>

    <div class="hd__r">
      <nav class="hd__nav" aria-label="Secundaria">
        {right.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <a class="hd__cta" href={order} target="_blank" rel="noopener">
        Pedir <Icon name="arrowUpRight" size={15} />
      </a>
    </div>

    <button class="hd__burger" type="button" aria-expanded="false" aria-controls="v2-menu" data-burger>
      <span class="sr-only">Abrir menú</span>
      <span class="hd__bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="mm" id="v2-menu" data-menu hidden>
    <nav class="mm__nav" aria-label="Menú móvil">
      {
        nav.map((n, i) => (
          <a href={n.href} style={`--i:${i}`}>
            <span>{n.label}</span>
            <small>0{i + 1}</small>
          </a>
        ))
      }
    </nav>
    <div class="mm__foot">
      <a class="btn btn--white btn--lg" href={order} target="_blank" rel="noopener">
        <Icon name="whatsapp" size={20} /> Pedí por WhatsApp
      </a>
      <div class="mm__info">
        <p>{site.address.street}<br />{site.address.area}, {site.address.city}</p>
        <p>
          <a href={telLink}>{site.phone}</a><br />
          <a href={igLink} target="_blank" rel="noopener">@{site.instagram}</a>
        </p>
      </div>
    </div>
  </div>
</header>

<script>
  const hd = document.querySelector<HTMLElement>('[data-hd]')!;
  const burger = hd.querySelector<HTMLButtonElement>('[data-burger]')!;
  const menu = hd.querySelector<HTMLElement>('[data-menu]')!;

  let last = scrollY;
  const onScroll = () => {
    const y = scrollY;
    hd.classList.toggle('is-solid', y > 40);
    // Se esconde al bajar y vuelve al subir, para dejar respirar la página
    hd.classList.toggle('is-hidden', y > 600 && y > last && !hd.classList.contains('is-open'));
    last = y;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    hd.classList.toggle('is-open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.querySelector('.sr-only')!.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) menu.hidden = false;
    else setTimeout(() => !hd.classList.contains('is-open') && (menu.hidden = true), 450);
  };
  burger.addEventListener('click', () => setOpen(!hd.classList.contains('is-open')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  addEventListener('keydown', (e) => e.key === 'Escape' && hd.classList.contains('is-open') && setOpen(false));
</script>

<style>
  .hd {
    position: fixed;
    inset: 0 0 auto;
    z-index: 90;
    color: var(--white);
    transition:
      transform 0.6s var(--ease),
      background-color 0.5s,
      box-shadow 0.5s;
  }
  .hd.is-solid {
    background: rgb(8 21 48 / 0.88);
    backdrop-filter: saturate(140%) blur(18px);
    -webkit-backdrop-filter: saturate(140%) blur(18px);
    box-shadow: 0 1px 0 var(--line-inv);
  }
  .hd.is-hidden {
    transform: translateY(-100%);
  }

  /* Franja superior: datos de la tienda en pequeño, como una etiqueta */
  .hd__top {
    display: none;
    overflow: hidden;
    max-height: 36px;
    border-bottom: 1px solid var(--line-inv);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
    transition:
      max-height 0.5s var(--ease),
      opacity 0.4s,
      border-color 0.4s;
  }
  .hd.is-solid .hd__top {
    max-height: 0;
    opacity: 0;
    border-color: transparent;
  }
  .hd__top-in {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 36px;
  }
  .hd__top-r {
    display: flex;
    gap: 28px;
  }

  .hd__in {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-h);
  }
  .hd__logo {
    grid-column: 2;
    display: block;
    width: 56px;
    transition:
      width 0.5s var(--ease),
      transform 0.6s var(--ease);
  }
  .hd__logo img {
    width: 100%;
    height: auto;
  }
  .hd__logo:hover {
    transform: rotate(-6deg);
  }

  .hd__nav {
    display: none;
    gap: clamp(20px, 2.4vw, 40px);
  }
  .hd__nav a,
  .hd__cta {
    position: relative;
    padding: 8px 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgb(255 255 255 / 0.78);
    transition: color 0.3s;
  }
  .hd__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.2em;
    bottom: 2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s var(--ease);
  }
  .hd__nav a:hover {
    color: var(--white);
  }
  .hd__nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .hd__r {
    grid-column: 3;
    display: none;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(20px, 2.4vw, 40px);
  }
  .hd__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 11px 18px 11px 20px;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 999px;
    color: var(--white);
    transition:
      background-color 0.35s,
      color 0.35s,
      border-color 0.35s;
  }
  .hd__cta:hover {
    background: var(--white);
    border-color: var(--white);
    color: var(--navy);
  }

  .hd__wa,
  .hd__burger {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-inv);
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .hd__wa {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
  }
  .hd__burger {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
  }
  .hd__bars {
    display: grid;
    gap: 6px;
    width: 18px;
  }
  .hd__bars i {
    display: block;
    height: 1.4px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.4s var(--ease);
  }
  .hd.is-open .hd__bars i:first-child {
    transform: translateY(3.7px) rotate(45deg);
  }
  .hd.is-open .hd__bars i:last-child {
    transform: translateY(-3.7px) rotate(-45deg);
  }

  /* Menú móvil */
  .mm {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: grid;
    align-content: space-between;
    padding: calc(var(--header-h) + 40px) var(--gutter) calc(28px + env(safe-area-inset-bottom));
    background: var(--navy);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s var(--ease),
      visibility 0s 0.45s;
  }
  .hd.is-open .mm {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.45s var(--ease);
  }
  .mm__nav {
    display: grid;
    border-top: 1px solid var(--line-inv);
  }
  .mm__nav a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-inv);
    font-family: var(--serif);
    font-size: clamp(1.9rem, 7.6vw, 2.6rem);
    line-height: 1.1;
    text-decoration: none;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.5s var(--ease),
      transform 0.6s var(--ease);
  }
  .mm__nav small {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--celeste);
  }
  .hd.is-open .mm__nav a {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.1s + var(--i) * 0.045s);
  }
  .mm__foot {
    display: grid;
    gap: 22px;
  }
  .mm__info {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.82rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.6);
  }
  .mm__info p:last-child {
    text-align: right;
  }
  .mm__info a {
    text-decoration: none;
  }

  @media (min-width: 1080px) {
    .hd__top {
      display: block;
    }
    .hd__nav,
    .hd__r {
      display: flex;
    }
    .hd__wa,
    .hd__burger,
    .mm {
      display: none;
    }
    .hd__logo {
      width: 76px;
    }
    .hd.is-solid .hd__logo {
      width: 54px;
    }
  }
</style>
