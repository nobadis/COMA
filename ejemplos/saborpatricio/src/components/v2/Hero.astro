---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Seal from './Seal.astro';
import sunSvg from '../../assets/sol-rays.svg?raw';
import { flavors, site, waLink } from '../../config/site';

const imgs = import.meta.glob<{ default: ImageMetadata }>('../../assets/flavors/*.png', { eager: true });
const img = (id: string) => imgs[`../../assets/flavors/${id}.png`].default;
---

<section class="hero grain" aria-labelledby="hero-title" data-hero>
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__light"></div>
  </div>

  <div class="wrap hero__in">
    <div class="hero__copy">
      <p class="hero__eyebrow">
        <span class="hero__dot" aria-hidden="true"></span>
        Obrador en Mallorca · Est. {site.founded}
      </p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__l"><span>Auténtica</span></span>
        <span class="hero__l"><span>empanada</span></span>
        <span class="hero__l"><span><em>argentina</em></span></span>
      </h1>
      <p class="hero__lead">
        Recetas criollas elaboradas en nuestro obrador de Mallorca y recién horneadas en Cala Major. Para que te sientas en
        casa… o viajes a Argentina en un bocado.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--white btn--lg" href="#carta">Ver la carta <Icon name="arrow" size={20} /></a>
        <a class="btn btn--ghost-inv btn--lg" href={waLink(`¡Hola ${site.name}! Quiero hacer un pedido 🥟`)} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} /> Pedí por WhatsApp
        </a>
      </div>
    </div>

    <div class="stage" data-stage>
      <div class="stage__tilt" data-tilt>
        <div class="stage__sun" aria-hidden="true" set:html={sunSvg} />
        <div class="stage__disc" aria-hidden="true"></div>
        <div class="stage__float">
          {
            flavors.map((f, i) => (
              <div class:list={['stage__emp', { 'is-on': i === 0 }]} data-emp>
                <Picture
                  src={img(f.id)}
                  alt={`Empanada de ${f.name.toLowerCase()} abierta, con el relleno a la vista`}
                  formats={['avif', 'webp']}
                  widths={[380, 560, 727]}
                  sizes="(min-width: 960px) 44vw, 90vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                />
              </div>
            ))
          }
          <div class="stage__shadow" aria-hidden="true"></div>
        </div>
        <Seal class="stage__seal" />
      </div>

      <div class="stage__info" aria-live="polite">
        <p class="stage__name" data-name>{flavors[0].name}</p>
        <p class="stage__ing" data-ing>{flavors[0].ingredients}</p>
      </div>

      <div class="chips" role="group" aria-label="Elegí un sabor">
        {
          flavors.map((f, i) => (
            <button
              type="button"
              class="chip"
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-chip
              data-name={f.name}
              data-ing={f.ingredients}
            >
              <span aria-hidden="true">0{i + 1}</span> {f.name}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <a href="#obrador" class="hero__scroll" aria-label="Bajar a conocer el obrador">
    <span>Descubrí</span>
    <i aria-hidden="true"></i>
  </a>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const stage = hero.querySelector<HTMLElement>('[data-stage]')!;
  const tilt = hero.querySelector<HTMLElement>('[data-tilt]')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Inclinación 3D siguiendo el puntero
  if (!reduce && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let raf = 0,
      tx = 0,
      ty = 0,
      cx = 0,
      cy = 0;
    const loop = () => {
      cx += (tx - cx) * 0.07;
      cy += (ty - cy) * 0.07;
      tilt.style.setProperty('--rx', `${(-cy * 12).toFixed(2)}deg`);
      tilt.style.setProperty('--ry', `${(cx * 16).toFixed(2)}deg`);
      raf = Math.abs(tx - cx) + Math.abs(ty - cy) > 0.002 ? requestAnimationFrame(loop) : 0;
    };
    hero.addEventListener('pointermove', (e) => {
      const r = stage.getBoundingClientRect();
      tx = Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width) * 2 - 1));
      ty = Math.max(-1, Math.min(1, ((e.clientY - r.top) / r.height) * 2 - 1));
      if (!raf) raf = requestAnimationFrame(loop);
    });
    hero.addEventListener('pointerleave', () => {
      tx = ty = 0;
      if (!raf) raf = requestAnimationFrame(loop);
    });
  }

  // Selector de sabores con rotación automática
  const chips = [...stage.querySelectorAll<HTMLButtonElement>('[data-chip]')];
  const emps = [...stage.querySelectorAll<HTMLElement>('[data-emp]')];
  const name = stage.querySelector<HTMLElement>('[data-name]')!;
  const ing = stage.querySelector<HTMLElement>('[data-ing]')!;
  let idx = 0;
  let timer = 0;
  let auto = !reduce;

  const show = (i: number) => {
    if (i === idx) return;
    const prev = emps[idx];
    prev.classList.remove('is-on');
    prev.classList.add('is-out');
    setTimeout(() => prev.classList.remove('is-out'), 800);
    idx = i;
    emps[idx].classList.add('is-on');
    chips.forEach((c, j) => c.setAttribute('aria-pressed', String(j === idx)));
    name.textContent = chips[idx].dataset.name!;
    ing.textContent = chips[idx].dataset.ing!;
    stage.classList.remove('is-swap');
    void stage.offsetWidth;
    stage.classList.add('is-swap');
  };
  chips.forEach((c, i) =>
    c.addEventListener('click', () => {
      auto = false;
      clearInterval(timer);
      show(i);
    }),
  );
  const start = () => {
    clearInterval(timer);
    if (auto) timer = window.setInterval(() => show((idx + 1) % emps.length), 3600);
  };
  new IntersectionObserver(([e]) => (e.isIntersecting ? start() : clearInterval(timer))).observe(stage);
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: calc(var(--header-h) + 28px) 0 96px;
    border-bottom: 1px solid var(--line-inv);
    background: var(--navy);
    color: var(--white);
    overflow: clip;
    isolation: isolate;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(90% 70% at 78% 40%, #1d3f86 0%, transparent 62%),
      radial-gradient(60% 60% at 0% 100%, #0f2a63 0%, transparent 70%),
      linear-gradient(180deg, var(--navy) 0%, var(--navy-900) 100%);
  }
  .hero__light {
    position: absolute;
    right: 4%;
    top: 18%;
    width: 46vmax;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(246 180 14 / 0.2), transparent);
    filter: blur(30px);
  }
  .hero__in {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 40px;
    align-items: center;
    min-width: 0;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 12px;
    border: 1px solid var(--line-inv);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--celeste-300);
    animation: up 1s var(--ease) both;
  }
  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sol);
    box-shadow: 0 0 0 4px rgb(246 180 14 / 0.2);
  }
  .hero__title {
    display: grid;
    margin-top: 26px;
    font-size: clamp(2.5rem, 1.2rem + 4.2vw, 5.4rem);
    font-weight: 750;
    line-height: 0.92;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  .hero__l {
    display: block;
    overflow: clip;
    padding-bottom: 0.04em;
  }
  .hero__l > span {
    display: block;
    animation: rise 1.1s var(--ease) both;
  }
  .hero__l:nth-child(2) > span {
    animation-delay: 0.08s;
  }
  .hero__l:nth-child(3) > span {
    animation-delay: 0.16s;
  }
  .hero__title em {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.12em;
    letter-spacing: -0.03em;
    text-transform: none;
    color: var(--celeste);
  }
  .hero__lead {
    max-width: 42ch;
    margin-top: 24px;
    font-size: clamp(1rem, 0.96rem + 0.25vw, 1.15rem);
    color: rgb(255 255 255 / 0.74);
    animation: up 1s 0.3s var(--ease) both;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
    animation: up 1s 0.4s var(--ease) both;
  }

  /* Escenario */
  .stage {
    position: relative;
    min-width: 0;
    perspective: 1200px;
    animation: up 1.2s 0.2s var(--ease) both;
  }
  .stage__tilt {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 0.78;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
  }
  .stage__sun {
    position: absolute;
    width: 100%;
    aspect-ratio: 1;
    color: var(--sol);
    opacity: 0.55;
    transform: translateZ(-90px);
  }
  .stage__sun :global(svg) {
    width: 100%;
    height: 100%;
    animation: spin 90s linear infinite;
  }
  .stage__disc {
    position: absolute;
    width: 62%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 30%, #3f6fcf 0%, var(--azul) 45%, var(--navy-700) 100%);
    box-shadow:
      inset 0 2px 0 rgb(255 255 255 / 0.18),
      0 40px 90px -30px rgb(0 0 0 / 0.6);
    transform: translateZ(-60px);
  }
  .stage__float {
    position: relative;
    width: 86%;
    aspect-ratio: 727 / 335;
    transform: translateZ(70px);
    transform-style: preserve-3d;
    animation: float 6.5s ease-in-out infinite;
  }
  .stage__emp {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateX(-12%) rotate(-8deg) scale(0.86);
    filter: drop-shadow(0 34px 34px rgb(3 8 24 / 0.55));
    transition:
      opacity 0.6s var(--ease),
      transform 0.9s var(--ease);
  }
  .stage__emp.is-on {
    opacity: 1;
    transform: none;
  }
  .stage__emp.is-out {
    opacity: 0;
    transform: translateX(14%) rotate(8deg) scale(0.86);
  }
  .stage__emp :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .stage__shadow {
    position: absolute;
    left: 14%;
    right: 14%;
    bottom: -24%;
    height: 16%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(2 6 20 / 0.6), transparent);
    transform: translateZ(-40px);
  }
  .stage :global(.stage__seal) {
    position: absolute;
    top: 10%;
    right: 2%;
    transform: translateZ(120px) rotate(8deg);
  }
  .stage__info {
    min-height: 5.4em;
    margin-top: 18px;
    text-align: center;
  }
  .stage__name {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    line-height: 1;
  }
  .stage__ing {
    max-width: 40ch;
    margin: 8px auto 0;
    font-size: 0.95rem;
    color: rgb(255 255 255 / 0.62);
  }
  .stage.is-swap .stage__info > * {
    animation: up 0.6s var(--ease) both;
  }
  .stage.is-swap .stage__ing {
    animation-delay: 0.06s;
  }

  .chips {
    display: flex;
    gap: 8px;
    margin-top: 18px;
    padding: 4px 2px 8px;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }
  .chips::-webkit-scrollbar {
    display: none;
  }
  .chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid var(--line-inv);
    border-radius: 999px;
    background: transparent;
    color: rgb(255 255 255 / 0.8);
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    scroll-snap-align: start;
    transition:
      background-color 0.3s,
      color 0.3s,
      border-color 0.3s;
  }
  .chip span {
    font-family: var(--serif);
    font-style: italic;
    color: var(--celeste);
  }
  .chip:hover {
    border-color: rgb(255 255 255 / 0.5);
    color: var(--white);
  }
  .chip[aria-pressed='true'] {
    background: var(--white);
    border-color: var(--white);
    color: var(--navy);
  }
  .chip[aria-pressed='true'] span {
    color: var(--azul);
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 26px;
    z-index: 1;
    display: none;
    justify-items: center;
    gap: 10px;
    translate: -50% 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgb(255 255 255 / 0.6);
  }
  .hero__scroll i {
    width: 1px;
    height: 44px;
    background: linear-gradient(var(--white), transparent);
    transform-origin: top;
    animation: drip 2s var(--ease) infinite;
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes up {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes drip {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  @media (min-width: 1080px) {
    .hero {
      padding-top: calc(var(--header-h) + 64px);
    }
  }
  @media (min-width: 960px) {
    .hero__in {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .chips {
      justify-content: center;
      flex-wrap: wrap;
      overflow: visible;
    }
    .hero__scroll {
      display: grid;
    }
  }
</style>
