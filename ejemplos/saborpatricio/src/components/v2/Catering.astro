---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import caja from '../../assets/photos/caja.jpg';
import quilmes from '../../assets/photos/caja-quilmes.jpg';
import { site, waLink } from '../../config/site';

const uses = [
  { t: 'Empresas y oficinas', d: 'Reuniones, desayunos de trabajo y afterworks.' },
  { t: 'Cumpleaños y fiestas', d: 'Lo que siempre se termina primero en la mesa.' },
  { t: 'Eventos y celebraciones', d: 'Bodas, comuniones, eventos de marca y más.' },
  { t: 'Bandejas para compartir', d: 'Surtidas a tu gusto, de clásicas y gourmet.' },
];

const steps = [
  { t: 'Contanos tu plan', d: 'Fecha, número de personas y qué te apetece.' },
  { t: 'Te armamos la propuesta', d: 'Sabores, cantidades y presupuesto a medida.' },
  { t: 'Recién horneadas', d: 'Las preparamos en el obrador, listas para servir.' },
];

const mail = `mailto:${site.legal.email}?subject=${encodeURIComponent('Catering Sabor Patricio')}`;
---

<section id="catering" class="cat sec" aria-labelledby="cat-title">
  <div class="wrap cat__grid">
    <div class="cat__media" aria-hidden="true">
      <div class="cat__a rv-img">
        <Picture src={caja} alt="" formats={['avif', 'webp']} widths={[420, 600]} sizes="(min-width: 960px) 30vw, 70vw" loading="lazy" />
      </div>
      <div class="cat__b rv-img">
        <Picture src={quilmes} alt="" formats={['avif', 'webp']} widths={[320, 480]} sizes="(min-width: 960px) 20vw, 50vw" loading="lazy" />
      </div>
    </div>

    <div class="cat__copy">
      <div class="head">
        <p class="kicker rv">Catering</p>
        <h2 id="cat-title" class="title rv" style="--d:1">Sabor Patricio <em>en tu evento</em></h2>
        <p class="lead rv" style="--d:2">
          Llevamos el sabor de Argentina a tu mesa: empanadas de obrador, recién horneadas y en el formato que
          necesites.
        </p>
      </div>

      <ul class="uses">
        {
          uses.map((u, i) => (
            <li class="use rv" style={`--d:${i}`}>
              <h3>{u.t}</h3>
              <p>{u.d}</p>
            </li>
          ))
        }
      </ul>

      <ol class="flow rv">
        {
          steps.map((s, i) => (
            <li>
              <span>{i + 1}</span>
              <div>
                <h4>{s.t}</h4>
                <p>{s.d}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="cat__ctas rv">
        <a class="btn btn--lg" href={waLink(`¡Hola ${site.name}! Quiero pedir presupuesto de catering para un evento.`)} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={20} /> Pedí tu presupuesto
        </a>
        <a class="btn btn--ghost btn--lg" href={mail}><Icon name="mail" size={20} /> {site.legal.email}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cat {
    background: var(--hielo);
    overflow: clip;
  }
  .cat__grid {
    display: grid;
    gap: 64px;
  }
  .cat__media {
    position: relative;
    padding: 0 18% 22% 0;
  }
  .cat__a,
  .cat__b {
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .cat__a {
    aspect-ratio: 4 / 4.6;
  }
  .cat__b {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 48%;
    aspect-ratio: 3 / 4;
    border: 6px solid var(--hielo);
    border-radius: calc(var(--r-lg) + 6px);
  }
  .cat__a :global(img),
  .cat__b :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .uses {
    display: grid;
    border-top: 1px solid rgb(10 26 58 / 0.14);
  }
  .use {
    display: grid;
    gap: 4px;
    padding: 18px 0;
    border-bottom: 1px solid rgb(10 26 58 / 0.14);
  }
  .use h3 {
    font-family: var(--serif);
    font-size: clamp(1.3rem, 1.15rem + 0.5vw, 1.6rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--navy);
  }
  .use p {
    font-size: 0.93rem;
    color: var(--muted);
  }

  .flow {
    display: grid;
    gap: 0;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: f;
  }
  .flow li {
    position: relative;
    display: flex;
    gap: 18px;
    padding-bottom: 22px;
  }
  .flow li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 19px;
    top: 42px;
    bottom: 2px;
    width: 1px;
    background: rgb(31 69 148 / 0.3);
  }
  .flow span {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgb(31 69 148 / 0.35);
    border-radius: 50%;
    background: var(--hielo);
    color: var(--azul);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.2rem;
  }
  .flow h4 {
    padding-top: 8px;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .flow p {
    font-size: 0.93rem;
    color: var(--muted);
  }
  .cat__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .cat__ctas .btn--ghost {
    color: var(--navy);
  }

  @media (min-width: 700px) {
    .use {
      grid-template-columns: 1fr 1.1fr;
      align-items: baseline;
      gap: 24px;
    }
  }
  @media (min-width: 960px) {
    .cat__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 96px;
      align-items: center;
    }
  }
</style>
