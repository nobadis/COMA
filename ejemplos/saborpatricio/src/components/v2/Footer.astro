---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-blanco-800.png';
import Icon from './Icon.astro';
import ComaCredit from '../ComaCredit.astro';
import { igLink, site, telLink, waLink } from '../../config/site';
const year = new Date().getFullYear();
---

<footer class="ft">
  <div class="wrap">
    <p class="ft__big" aria-hidden="true">Sabor <em>Patricio</em></p>

    <div class="ft__grid">
      <div class="ft__brand">
        <Image src={logo} alt="Sabor Patricio" width={96} height={96} loading="lazy" />
        <p>Auténtica empanada argentina.<br />Hecha en nuestro obrador de Mallorca, con el corazón allá.</p>
      </div>
      <nav aria-label="Secciones">
        <h3>Explorá</h3>
        <a href="#obrador">Obrador</a>
        <a href="#sabores">Sabores</a>
        <a href="#carta">Carta</a>
        <a href="#catering">Catering</a>
        <a href="#franquicias">Franquicias</a>
      </nav>
      <div>
        <h3>Contacto</h3>
        <a href={waLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp</a>
        <a href={telLink}><Icon name="phone" size={18} /> {site.phone}</a>
        <a href={`mailto:${site.legal.email}`}><Icon name="mail" size={18} /> {site.legal.email}</a>
        <a href={igLink} target="_blank" rel="noopener"><Icon name="instagram" size={18} /> @{site.instagram}</a>
      </div>
      <div>
        <h3>Tienda</h3>
        <a href={site.mapsUrl} target="_blank" rel="noopener"
          ><Icon name="pin" size={18} /> {site.address.street}, {site.address.area}</a
        >
      </div>
    </div>

    <div class="ft__bottom">
      <div class="ft__legal">
        <p>© {year} {site.name} · {site.legal.company}</p>
        <nav aria-label="Información legal">
          <a href="/aviso-legal">Aviso legal</a>
          <a href="/privacidad">Privacidad</a>
          <a href="/cookies">Cookies</a>
        </nav>
      </div>
      <ComaCredit />
    </div>
  </div>
</footer>

<style>
  .ft {
    background: var(--navy-900);
    color: rgb(255 255 255 / 0.72);
    padding: clamp(64px, 8vw, 110px) 0 calc(28px + env(safe-area-inset-bottom));
    overflow: clip;
  }
  .ft__big {
    font-size: clamp(2.6rem, 1rem + 6.4vw, 7.4rem);
    font-weight: 750;
    line-height: 0.85;
    letter-spacing: -0.06em;
    text-transform: uppercase;
    color: var(--white);
    white-space: nowrap;
  }
  .ft__big em {
    font-family: var(--serif);
    font-weight: 400;
    text-transform: none;
    letter-spacing: -0.03em;
    color: var(--celeste);
  }
  .ft__grid {
    display: grid;
    gap: 40px;
    margin-top: clamp(48px, 6vw, 80px);
    padding-top: 40px;
    border-top: 1px solid var(--line-inv);
  }
  .ft__brand {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .ft__brand p {
    max-width: 32ch;
  }
  .ft h3 {
    margin-bottom: 10px;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--celeste);
  }
  .ft__grid > nav,
  .ft__grid > div:not(.ft__brand) {
    display: grid;
    align-content: start;
  }
  .ft a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 38px;
    text-decoration: none;
    transition: color 0.25s;
  }
  .ft a:hover {
    color: var(--white);
  }
  .ft__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line-inv);
    font-size: 0.85rem;
    color: rgb(255 255 255 / 0.5);
  }
  .ft__legal nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
  }
  .ft__legal a {
    min-height: 32px;
  }
  @media (min-width: 900px) {
    .ft__grid {
      grid-template-columns: 1.5fr 1fr 1.2fr 1fr;
    }
  }
  @media (max-width: 899px) {
    .ft {
      padding-bottom: calc(96px + env(safe-area-inset-bottom));
    }
  }
</style>
