---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import emp from '../assets/flavors/picante.png';
import { waLink, site } from '../config/site';
---

<section class="fin" aria-labelledby="fin-title">
  <div class="wrap fin__in">
    <h2 id="fin-title" class="fin__h reveal">
      ¿Hambre?<br /><span>Nosotros, empanadas.</span>
    </h2>
    <div class="fin__emp reveal" aria-hidden="true">
      <Picture src={emp} alt="" formats={['avif', 'webp']} widths={[360, 600]} sizes="(min-width: 900px) 34vw, 80vw" loading="lazy" />
    </div>
    <div class="fin__ctas reveal">
      <a class="btn btn--ink btn--lg" href={waLink(`¡Hola ${site.name}! Quiero hacer un pedido 🥟`)} target="_blank" rel="noopener">
        <Icon name="whatsapp" /> Pedir por WhatsApp
      </a>
      <a class="btn btn--ghost btn--lg" href="#donde">Vení a visitarnos <Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .fin {
    position: relative;
    padding-block: clamp(80px, 12vw, 160px);
    background: var(--sol);
    color: var(--ink);
    overflow: clip;
    text-align: center;
  }
  .fin::before {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 140vmax;
    height: 140vmax;
    translate: -50% -50%;
    background: repeating-conic-gradient(from 0deg, rgb(255 255 255 / 0.18) 0 6deg, transparent 6deg 12deg);
    animation: rays 80s linear infinite;
  }
  .fin__in {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 24px;
  }
  .fin__h {
    font-size: clamp(3rem, 1.4rem + 8vw, 8rem);
    text-transform: uppercase;
    line-height: 0.85;
    letter-spacing: -0.05em;
  }
  .fin__h span {
    color: var(--blue);
  }
  .fin__emp {
    width: min(560px, 86vw);
    margin-block: -10px;
  }
  .fin__emp :global(img) {
    width: 100%;
    filter: drop-shadow(0 30px 24px rgb(80 40 0 / 0.35));
    -webkit-mask: linear-gradient(#000 88%, transparent);
    mask: linear-gradient(#000 88%, transparent);
    animation: bounce 3.2s ease-in-out infinite;
  }
  .fin__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  @keyframes rays {
    to {
      rotate: 360deg;
    }
  }
  @keyframes bounce {
    50% {
      transform: translateY(-14px) rotate(2deg) scale(1.03);
    }
  }
</style>
