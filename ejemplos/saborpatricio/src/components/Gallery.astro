---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { igLink, site, reviews } from '../config/site';
import stack from '../assets/photos/stack.jpg';
import horno from '../assets/photos/horno.jpg';
import vitrina from '../assets/photos/vitrina.jpg';
import vino from '../assets/photos/vino.jpg';
import caja from '../assets/photos/caja.jpg';

const photos = [
  { src: stack, alt: 'Empanadas de carne cortadas mostrando el relleno con queso' },
  { src: vitrina, alt: 'Vitrina llena de empanadas recién horneadas' },
  { src: vino, alt: 'Empanadas en canasta con copa de vino tinto' },
  { src: horno, alt: 'Empanadas doradas recién salidas del horno' },
  { src: caja, alt: 'Caja de Sabor Patricio con empanadas' },
];
---

<section class="gal section" aria-labelledby="gal-title">
  <div class="wrap gal__head">
    <div>
      <p class="eyebrow reveal">@{site.instagram}</p>
      <h2 id="gal-title" class="h2 reveal">Recién salidas<br />del horno</h2>
    </div>
    <a href={igLink} class="btn btn--ghost reveal" target="_blank" rel="noopener">
      <Icon name="instagram" /> Seguinos en Instagram
    </a>
  </div>

  <div class="gal__rail" role="region" aria-label="Galería de fotos" tabindex="0">
    {
      photos.map((p, i) => (
        <figure class="gal__item" style={`--r:${i % 2 ? 2 : -2}deg`}>
          <Picture
            src={p.src}
            alt={p.alt}
            formats={['avif', 'webp']}
            widths={[320, 480]}
            sizes="(min-width: 900px) 24vw, 62vw"
            loading="lazy"
          />
        </figure>
      ))
    }
  </div>

  <div class="wrap">
    <div class="rv reveal">
      <div class="rv__stars" aria-hidden="true">
        {[1, 2, 3, 4, 5].map(() => <Icon name="star" size={28} />)}
      </div>
      {
        reviews.length > 0 ? (
          <ul class="rv__list" role="list">
            {reviews.map((r) => (
              <li class="rv__item">
                <blockquote>“{r.text}”</blockquote>
                <p class="rv__author">
                  {r.author} · {'★'.repeat(r.rating)}
                </p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="rv__h">¿Ya las probaste? Mirá lo que dice la gente.</p>
        )
      }
      <div class="rv__ctas">
        <a href={site.reviewsUrl} class="btn" target="_blank" rel="noopener">Ver reseñas en Google</a>
        <a href={site.reviewsUrl} class="btn btn--ghost" target="_blank" rel="noopener">Dejar mi reseña</a>
      </div>
    </div>
  </div>
</section>

<style>
  .gal {
    background: var(--cream);
    overflow: clip;
  }
  .gal__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
  }
  .gal__head > div {
    display: grid;
    gap: 16px;
  }
  .gal__rail {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 20px var(--gutter) 36px;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .gal__rail::-webkit-scrollbar {
    display: none;
  }
  .gal__item {
    flex: none;
    width: clamp(220px, 62vw, 340px);
    margin: 0;
    scroll-snap-align: start;
    transform: rotate(var(--r));
    transition: transform 0.5s var(--ease-spring);
  }
  .gal__item:hover {
    transform: rotate(0) scale(1.04);
  }
  .gal__item :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: 0 20px 40px -20px rgb(12 26 64 / 0.4);
  }

  .rv {
    display: grid;
    justify-items: center;
    gap: 20px;
    margin-top: 48px;
    padding: clamp(32px, 5vw, 56px);
    border-radius: calc(var(--radius) + 8px);
    background: var(--blue);
    color: #fff;
    text-align: center;
  }
  .rv__stars {
    display: flex;
    gap: 4px;
    color: var(--sol);
  }
  .rv__h {
    font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
    max-width: 22ch;
  }
  .rv__list {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }
  .rv__item blockquote {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
  }
  .rv__author {
    margin-top: 6px;
    color: var(--celeste-soft);
    font-size: 0.95rem;
  }
  .rv__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  @media (min-width: 900px) {
    .gal__rail {
      padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    }
    .rv__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
