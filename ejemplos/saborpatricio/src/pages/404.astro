---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Página no encontrada · Sabor Patricio" solidHeader hideMobileBar>
  <section class="nf">
    <div class="wrap nf__in">
      <p class="nf__code">4<img src="/sol.svg" alt="0" width="160" height="160" />4</p>
      <h1 class="h2">Esta empanada<br />se nos perdió</h1>
      <p class="lead">La página que buscás no existe. Pero las empanadas sí.</p>
      <div class="nf__ctas">
        <a class="btn btn--blue btn--lg" href="/">Volver al inicio</a>
        <a class="btn btn--lg" href="/pedir">Hacer un pedido <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: calc(var(--header-h) + 40px) 0 80px;
    text-align: center;
  }
  .nf__in {
    display: grid;
    justify-items: center;
    gap: 20px;
  }
  .nf__code {
    display: flex;
    align-items: center;
    font-size: clamp(6rem, 4rem + 10vw, 12rem);
    font-weight: 800;
    line-height: 1;
    color: var(--blue);
  }
  .nf__code img {
    width: 0.85em;
    height: 0.85em;
    animation: spin 12s linear infinite;
  }
  .nf__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
