---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Visit from '../components/Visit.astro';
import { flavors, site, telLink } from '../config/site';

const imgs = import.meta.glob<{ default: ImageMetadata }>('../assets/flavors/*.png', { eager: true });
const img = (id: string) => imgs[`../assets/flavors/${id}.png`].default;

const extras = [
  { id: 'quilmes', name: 'Quilmes', note: 'Cerveza argentina bien fría' },
  { id: 'vino', name: 'Vino tinto', note: 'Para acompañar como se debe' },
  { id: 'pizza', name: 'Pizza argentina', note: 'Te contamos las variedades del día' },
];

const names = Object.fromEntries([...flavors, ...extras].map((i) => [i.id, i.name]));
const packs = {
  media: { label: 'Media docena surtida', items: { criolla: 2, pollo: 2, picante: 1, caprese: 1 } },
  docena: { label: 'Docena surtida', items: { criolla: 3, picante: 2, pollo: 3, caprese: 2, cebolla: 2 } },
};
---

<Base
  title="Hacé tu pedido · Sabor Patricio"
  description="Armá tu pedido de empanadas argentinas en segundos y envialo por WhatsApp. Recogida en Cala Major, Palma de Mallorca."
  solidHeader
  hideMobileBar
>
  <section class="ph">
    <div class="wrap">
      <p class="eyebrow">Pedido en 3 toques</p>
      <h1 class="display ph__h">Hacé tu<br /><span>pedido</span></h1>
      <p class="lead ph__lead">
        Elegí tus empanadas, mandanos el pedido por WhatsApp y te respondemos para confirmar. Sin apps, sin registros, sin
        vueltas.
      </p>
    </div>
  </section>

  <section class="order" aria-label="Formulario de pedido">
    <div class="wrap order__grid">
      <form class="order__form" data-order novalidate>
        <fieldset class="step">
          <legend class="step__h"><span>1</span> Tus empanadas</legend>
          <div class="packs">
            {
              Object.entries(packs).map(([k, p]) => (
                <button type="button" class="pack" data-pack={JSON.stringify(p.items)}>
                  <Icon name="plus" size={18} /> {p.label}
                </button>
              ))
            }
          </div>
          <ul class="rows" role="list">
            {
              flavors.map((f) => (
                <li class="row" style={`--c:${f.color}`}>
                  <div class="row__img">
                    <Picture src={img(f.id)} alt="" formats={['avif', 'webp']} widths={[160, 240]} sizes="120px" loading="lazy" />
                  </div>
                  <div class="row__txt">
                    <p class="row__name">{f.name}</p>
                    <p class="row__ing">{f.ingredients}</p>
                  </div>
                  <div class="qty" data-qty={f.id}>
                    <button type="button" data-dec aria-label={`Quitar una ${f.name}`}>
                      <Icon name="minus" size={18} />
                    </button>
                    <output aria-live="polite" aria-label={`Cantidad de ${f.name}`}>0</output>
                    <button type="button" data-inc aria-label={`Añadir una ${f.name}`}>
                      <Icon name="plus" size={18} />
                    </button>
                  </div>
                </li>
              ))
            }
          </ul>
        </fieldset>

        <fieldset class="step" id="extras">
          <legend class="step__h"><span>2</span> Para acompañar</legend>
          <ul class="rows rows--extras" role="list">
            {
              extras.map((x) => (
                <li class="row row--extra">
                  <div class="row__txt">
                    <p class="row__name">{x.name}</p>
                    <p class="row__ing">{x.note}</p>
                  </div>
                  <div class="qty" data-qty={x.id}>
                    <button type="button" data-dec aria-label={`Quitar ${x.name}`}>
                      <Icon name="minus" size={18} />
                    </button>
                    <output aria-live="polite" aria-label={`Cantidad de ${x.name}`}>0</output>
                    <button type="button" data-inc aria-label={`Añadir ${x.name}`}>
                      <Icon name="plus" size={18} />
                    </button>
                  </div>
                </li>
              ))
            }
          </ul>
        </fieldset>

        <fieldset class="step">
          <legend class="step__h"><span>3</span> Tus datos</legend>
          <div class="fields">
            <label class="field">
              <span>Nombre</span>
              <input name="name" autocomplete="given-name" placeholder="¿A nombre de quién?" required />
            </label>
            <label class="field">
              <span>¿Para cuándo?</span>
              <select name="when">
                <option>Lo antes posible</option>
                <option>Para el mediodía</option>
                <option>Para la noche</option>
                <option>Para otro día (lo aclaro en notas)</option>
              </select>
            </label>
            <div class="field field--full" role="radiogroup" aria-label="Modalidad">
              <span>Modalidad</span>
              <div class="seg">
                <label><input type="radio" name="mode" value="Recojo en el local" checked /><span>Recojo en el local</span></label>
                <label><input type="radio" name="mode" value="Consulto envío a domicilio" /><span>Consultar envío</span></label>
              </div>
            </div>
            <label class="field field--full">
              <span>Notas <small>(opcional)</small></span>
              <textarea name="notes" rows="3" placeholder="Alergias, hora exacta, pedido para un evento…"></textarea>
            </label>
          </div>
        </fieldset>
      </form>

      <aside class="sum" aria-label="Resumen del pedido">
        <div class="sum__card">
          <p class="sum__h">Tu pedido</p>
          <ul class="sum__list" role="list" data-summary></ul>
          <p class="sum__empty" data-empty>Todavía no elegiste nada. ¡Arrancá por la criolla! 😉</p>
          <div class="sum__total" data-total-row hidden>
            <span>Empanadas</span>
            <strong data-total>0</strong>
          </div>
          <p class="sum__hint" data-hint hidden></p>
          <button type="button" class="btn btn--wa btn--lg sum__send" data-send>
            <Icon name="whatsapp" /> Enviar por WhatsApp
          </button>
          <p class="sum__err" role="alert" data-err></p>
          <button type="button" class="sum__clear" data-clear>Vaciar pedido</button>
          <p class="sum__alt">¿Preferís llamar? <a href={telLink}>{site.phone}</a></p>
        </div>
      </aside>
    </div>
  </section>

  <div class="sbar" data-sbar>
    <span class="sbar__n"><b data-sbar-n>0</b> en tu pedido</span>
    <button type="button" class="btn btn--wa" data-send-proxy><Icon name="whatsapp" /> Enviar</button>
  </div>

  <Visit heading="Contacto" />
</Base>

<script define:vars={{ names, phone: site.phoneRaw, brand: site.name, flavorIds: flavors.map((f) => f.id) }}>
  window.__ORDER__ = { names, phone, brand, flavorIds };
</script>

<script>
  import { readCart, setQty, writeCart, type Cart } from '../scripts/cart';

  const cfg = (window as any).__ORDER__ as {
    names: Record<string, string>;
    phone: string;
    brand: string;
    flavorIds: string[];
  };
  const form = document.querySelector<HTMLFormElement>('[data-order]')!;
  const summary = document.querySelector<HTMLElement>('[data-summary]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const totalRow = document.querySelector<HTMLElement>('[data-total-row]')!;
  const totalEl = document.querySelector<HTMLElement>('[data-total]')!;
  const hint = document.querySelector<HTMLElement>('[data-hint]')!;
  const err = document.querySelector<HTMLElement>('[data-err]')!;
  const NAME_KEY = 'sp-name';

  try {
    const saved = localStorage.getItem(NAME_KEY);
    if (saved) (form.elements.namedItem('name') as HTMLInputElement).value = saved;
  } catch {}

  const render = (cart: Cart) => {
    document.querySelectorAll<HTMLElement>('[data-qty]').forEach((el) => {
      const n = cart[el.dataset.qty!] ?? 0;
      el.querySelector('output')!.textContent = String(n);
      el.classList.toggle('has', n > 0);
      el.querySelector<HTMLButtonElement>('[data-dec]')!.disabled = n === 0;
    });
    const entries = Object.entries(cart).filter(([k, v]) => v > 0 && cfg.names[k]);
    summary.innerHTML = entries
      .map(
        ([k, v]) =>
          `<li><span class="sum__q">${v}×</span> ${cfg.names[k]}<button type="button" class="sum__x" data-rm="${k}" aria-label="Quitar ${cfg.names[k]}">×</button></li>`,
      )
      .join('');
    const emp = cfg.flavorIds.reduce((a, id) => a + (cart[id] ?? 0), 0);
    empty.hidden = entries.length > 0;
    totalRow.hidden = emp === 0;
    totalEl.textContent = String(emp);
    if (emp > 0 && emp < 6) {
      hint.hidden = false;
      hint.textContent = `Te faltan ${6 - emp} para la media docena 👀`;
    } else if (emp > 6 && emp < 12) {
      hint.hidden = false;
      hint.textContent = `Te faltan ${12 - emp} para la docena 🔥`;
    } else hint.hidden = true;
    err.textContent = '';
  };

  const sbarN = document.querySelector<HTMLElement>('[data-sbar-n]');
  const sbar = document.querySelector<HTMLElement>('[data-sbar]');
  const sumCard = document.querySelector<HTMLElement>('.sum__card');
  const paintBar = (cart: Cart) => {
    if (sbarN) sbarN.textContent = String(Object.entries(cart).reduce((a, [k, v]) => a + (cfg.names[k] ? v : 0), 0));
  };
  if (sbar && sumCard) {
    // Oculta la barra cuando el resumen completo ya está en pantalla
    new IntersectionObserver(([e]) => sbar.classList.toggle('is-hidden', e.isIntersecting)).observe(sumCard);
  }
  document.querySelector('[data-send-proxy]')?.addEventListener('click', () => {
    document.querySelector<HTMLButtonElement>('[data-send]')!.click();
    if (err.textContent) sumCard?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
  document.addEventListener('cart:change', (e) => paintBar((e as CustomEvent<Cart>).detail));
  paintBar(readCart());
  document.addEventListener('cart:change', (e) => render((e as CustomEvent<Cart>).detail));
  render(readCart());

  form.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const q = t.closest<HTMLElement>('[data-qty]');
    if (q) {
      const id = q.dataset.qty!;
      const cur = readCart()[id] ?? 0;
      if (t.closest('[data-inc]')) setQty(id, cur + 1);
      else if (t.closest('[data-dec]')) setQty(id, cur - 1);
      q.classList.remove('bump');
      void q.offsetWidth;
      q.classList.add('bump');
      return;
    }
    const p = t.closest<HTMLElement>('[data-pack]');
    if (p) {
      const items = JSON.parse(p.dataset.pack!) as Cart;
      const cart = readCart();
      for (const [k, v] of Object.entries(items)) cart[k] = (cart[k] ?? 0) + v;
      writeCart(cart);
    }
  });

  summary.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-rm]');
    if (b) setQty(b.dataset.rm!, 0);
  });

  document.querySelector('[data-clear]')!.addEventListener('click', () => writeCart({}));

  document.querySelector('[data-send]')!.addEventListener('click', () => {
    const cart = readCart();
    const entries = Object.entries(cart).filter(([k, v]) => v > 0 && cfg.names[k]);
    if (!entries.length) {
      err.textContent = 'Elegí al menos una empanada para enviar el pedido.';
      document.querySelector('.rows')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }
    const fd = new FormData(form);
    const name = String(fd.get('name') ?? '').trim();
    if (!name) {
      err.textContent = 'Decinos tu nombre para el pedido.';
      const input = form.elements.namedItem('name') as HTMLInputElement;
      input.focus();
      input.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return;
    }
    try {
      localStorage.setItem(NAME_KEY, name);
    } catch {}
    const emp = cfg.flavorIds.reduce((a, id) => a + (cart[id] ?? 0), 0);
    const lines = [
      `¡Hola ${cfg.brand}! 👋 Quiero hacer un pedido:`,
      '',
      ...entries.map(([k, v]) => `${cfg.flavorIds.includes(k) ? '🥟' : '➕'} ${v}× ${cfg.names[k]}`),
      '',
      emp ? `Total empanadas: ${emp}` : '',
      `👤 Nombre: ${name}`,
      `🕒 ${fd.get('when')}`,
      `📍 ${fd.get('mode')}`,
      String(fd.get('notes') ?? '').trim() ? `📝 ${String(fd.get('notes')).trim()}` : '',
      '',
      '¡Gracias!',
    ].filter((l, i, a) => l !== '' || a[i - 1] !== '');
    const url = `https://wa.me/${cfg.phone}?text=${encodeURIComponent(lines.join('\n'))}`;
    window.open(url, '_blank', 'noopener');
  });
</script>

<style>
  .ph {
    padding: calc(var(--header-h) + clamp(40px, 7vw, 88px)) 0 clamp(40px, 6vw, 72px);
    background: var(--blue);
    color: #fff;
    background-image:
      radial-gradient(60% 90% at 90% 0%, rgb(246 180 14 / 0.35), transparent 60%),
      linear-gradient(180deg, var(--blue), var(--blue-deep));
  }
  .ph .eyebrow {
    color: var(--celeste-soft);
    margin-bottom: 16px;
  }
  .ph__h span {
    color: var(--sol);
  }
  .ph__lead {
    margin-top: 20px;
    color: rgb(255 255 255 / 0.85);
  }

  .order {
    padding: clamp(32px, 5vw, 64px) 0 clamp(64px, 8vw, 112px);
  }
  .order__grid {
    display: grid;
    gap: 28px;
    align-items: start;
  }
  .step {
    margin: 0 0 28px;
    padding: clamp(20px, 3vw, 32px);
    border: 0;
    border-radius: var(--radius);
    background: #fff;
    box-shadow: 0 1px 0 rgb(14 21 48 / 0.06), 0 20px 40px -28px rgb(14 21 48 / 0.35);
  }
  .step__h {
    display: flex;
    align-items: center;
    gap: 12px;
    float: left;
    width: 100%;
    margin-bottom: 18px;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .step__h + * {
    clear: both;
  }
  .step__h span {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--sol);
    font-size: 1.1rem;
  }
  .packs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }
  .pack {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px;
    border: 2px dashed var(--blue);
    border-radius: 999px;
    background: var(--celeste-soft);
    color: var(--blue);
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s var(--ease-spring);
  }
  .pack:hover {
    transform: translateY(-2px);
  }
  .rows {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    display: grid;
    grid-template-columns: 84px 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 10px 12px 10px 10px;
    border-radius: var(--radius-sm);
    background: var(--cream);
  }
  .row--extra {
    grid-template-columns: 1fr auto;
    padding-left: 18px;
  }
  .row__img {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 14px;
    background: var(--c);
    overflow: hidden;
  }
  .row__img :global(img) {
    width: 118%;
    max-width: none;
    filter: drop-shadow(0 6px 6px rgb(0 0 0 / 0.3));
  }
  .row__name {
    font-weight: 800;
    font-size: 1.1rem;
    line-height: 1.15;
  }
  .row__ing {
    font-size: 0.88rem;
    color: var(--ink-soft);
    line-height: 1.35;
    margin-top: 2px;
  }
  .qty {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 999px;
    background: #fff;
    box-shadow: inset 0 0 0 2px rgb(14 21 48 / 0.08);
  }
  .qty.has {
    background: var(--ink);
    color: #fff;
    box-shadow: none;
  }
  .qty.bump output {
    animation: bump 0.35s var(--ease-spring);
  }
  .qty button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .qty button:hover:not(:disabled) {
    background: rgb(127 127 127 / 0.2);
  }
  .qty button:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .qty [data-inc] {
    background: var(--sol);
    color: var(--ink);
  }
  .qty [data-inc]:hover {
    background: var(--sol-deep) !important;
  }
  .qty output {
    min-width: 26px;
    text-align: center;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  @keyframes bump {
    50% {
      transform: scale(1.45);
    }
  }

  .fields {
    display: grid;
    gap: 16px;
  }
  .field {
    display: grid;
    gap: 6px;
    font-weight: 700;
  }
  .field small {
    font-weight: 500;
    color: var(--ink-soft);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 52px;
    padding: 12px 16px;
    border: 2px solid rgb(14 21 48 / 0.12);
    border-radius: 14px;
    background: var(--cream);
    font-weight: 500;
    font-size: 1rem;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--blue);
    background: #fff;
  }
  .seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    padding: 5px;
    border-radius: 16px;
    background: var(--cream);
  }
  .seg label {
    position: relative;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    inset: 0;
  }
  .seg span {
    display: grid;
    place-items: center;
    min-height: 46px;
    padding: 0 8px;
    border-radius: 12px;
    text-align: center;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .seg input:checked + span {
    background: var(--blue);
    color: #fff;
  }
  .seg input:focus-visible + span {
    outline: 3px solid var(--sol);
  }

  .sum__card {
    display: grid;
    gap: 14px;
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--cream);
  }
  .sum__h {
    font-size: 1.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.03em;
  }
  .sum__list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sum__list :global(li) {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 8px;
    border-bottom: 1px dashed rgb(255 255 255 / 0.15);
    font-weight: 600;
  }
  .sum__list :global(.sum__q) {
    color: var(--sol);
    font-weight: 800;
    min-width: 2.2ch;
  }
  .sum__list :global(.sum__x) {
    margin-left: auto;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: inherit;
    font-size: 1.2rem;
    cursor: pointer;
  }
  .sum__empty {
    color: rgb(255 248 236 / 0.7);
  }
  .sum__total {
    display: flex;
    justify-content: space-between;
    font-size: 1.2rem;
  }
  .sum__total strong {
    font-size: 1.6rem;
    color: var(--sol);
  }
  .sum__total[hidden],
  .sum__hint[hidden],
  .sum__empty[hidden] {
    display: none;
  }
  .sum__hint {
    padding: 8px 12px;
    border-radius: 12px;
    background: rgb(246 180 14 / 0.15);
    color: var(--sol);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .sum__send {
    width: 100%;
  }
  .sum__err {
    color: #ff9c8a;
    font-weight: 700;
    min-height: 0;
  }
  .sum__err:empty {
    display: none;
  }
  .sum__clear {
    justify-self: center;
    border: 0;
    background: none;
    color: rgb(255 248 236 / 0.6);
    text-decoration: underline;
    cursor: pointer;
  }
  .sum__alt {
    text-align: center;
    font-size: 0.95rem;
    color: rgb(255 248 236 / 0.7);
  }
  .sum__alt a {
    color: var(--sol);
    font-weight: 700;
  }

  @media (min-width: 980px) {
    .order__grid {
      grid-template-columns: 1fr 380px;
      gap: 32px;
    }
    .sum {
      position: sticky;
      top: calc(var(--header-h) + 20px);
    }
    .fields {
      grid-template-columns: 1fr 1fr;
    }
    .field--full {
      grid-column: 1 / -1;
    }
  }
  .sbar {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    z-index: 55;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 8px 8px 20px;
    border-radius: 999px;
    background: rgb(12 26 64 / 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: #fff;
    box-shadow: 0 16px 40px -12px rgb(0 0 0 / 0.5);
    transition: transform 0.4s var(--ease-spring);
  }
  .sbar.is-hidden {
    transform: translateY(150%);
  }
  .sbar__n {
    font-weight: 800;
    white-space: nowrap;
  }
  .sbar__n b {
    color: var(--sol);
  }
  .sbar .btn {
    margin-left: auto;
    min-height: 50px;
    padding: 0 20px;
  }
  @media (min-width: 980px) {
    .sbar {
      display: none;
    }
  }
  @media (max-width: 979px) {
    .order {
      padding-bottom: 120px;
    }
