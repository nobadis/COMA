---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, waLink } from '../config/site';

// De momento no se admiten pedidos desde la web: /pedir lleva directo a WhatsApp.
// El formulario con carrito está aparcado en _pedir-formulario.astro.
const wa = waLink(`¡Hola ${site.name}! Quiero hacer un pedido 🥟`);
---

<Base title={`Pedir por WhatsApp · ${site.name}`} description="Escríbenos por WhatsApp para hacer tu pedido." solidHeader hideMobileBar noindex>
  <meta http-equiv="refresh" content={`0;url=${wa}`} />
  <section class="go">
    <div class="wrap go__in">
      <h1 class="h2">Te llevamos a WhatsApp</h1>
      <p class="lead">Escríbenos tu pedido y te respondemos para confirmarlo.</p>
      <a class="btn btn--wa btn--lg" href={wa}><Icon name="whatsapp" /> Abrir WhatsApp</a>
      <p><a href="/">Volver al inicio</a></p>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ wa }}>
  window.location.replace(wa);
</script>

<style>
  .go {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: calc(var(--header-h) + 40px) 0 80px;
    text-align: center;
  }
  .go__in {
    display: grid;
    justify-items: center;
    gap: 20px;
  }
  .go a:not(.btn) {
    text-decoration: underline;
  }
</style>
