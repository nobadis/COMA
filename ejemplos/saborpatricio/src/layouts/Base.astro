---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../config/site';
import { jsonLd } from '../config/schema';

type Props = {
  title?: string;
  description?: string;
  solidHeader?: boolean;
  hideMobileBar?: boolean;
  noindex?: boolean;
};

const {
  title = `${site.name} · Empanadas argentinas en Cala Major, Palma`,
  description = 'Empanadas argentinas clásicas y gourmet en Cala Major, Palma de Mallorca. Postres argentinos, vino y catering. Pedí por WhatsApp o vení a visitarnos.',
  solidHeader = false,
  hideMobileBar = false,
  noindex = false,
} = Astro.props;

const path = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/$/, '')}/`;
const canonical = new URL(path, Astro.site ?? site.url).href;
const ogImage = new URL('/og.jpg', Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="es" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#264d9c" />
    <link rel="preload" href="/fonts/bricolage.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sabor Patricio, empanadas argentinas en Cala Major, Palma de Mallorca" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <script type="application/ld+json" set:html={jsonLd({ base: Astro.site ?? site.url, canonical, title, description })} />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <Header solid={solidHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {!hideMobileBar && <MobileBar />}
    <div class="toast" role="status" aria-live="polite" data-toast></div>

    <script>
      import '../scripts/reveal';
    </script>

    <style is:global>
      .toast {
        position: fixed;
        left: 50%;
        bottom: calc(96px + env(safe-area-inset-bottom));
        z-index: 60;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 20px;
        border-radius: 999px;
        background: var(--ink);
        color: var(--cream);
        font-weight: 700;
        box-shadow: var(--shadow-lg);
        transform: translate(-50%, 20px) scale(0.9);
        opacity: 0;
        pointer-events: none;
        transition:
          transform 0.4s var(--ease-spring),
          opacity 0.25s;
        white-space: nowrap;
      }
      .toast.is-on {
        opacity: 1;
        transform: translate(-50%, 0) scale(1);
      }
      .toast a {
        color: var(--sol);
      }
      @media (min-width: 900px) {
        .toast {
          bottom: 32px;
        }
      }
    </style>
  </body>
</html>
