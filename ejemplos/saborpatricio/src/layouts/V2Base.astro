---
import "../styles/v2.css";
import { site } from "../config/site";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sabor Patricio · Un pedacito de Argentina en Mallorca</title>
    <meta
      name="description"
      content="110gr de puro amor. Empanadas argentinas elaboradas en nuestro obrador de Mallorca. Descubrí nuestra carta, catering y franquicias."
    />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={`${site.url}/v2/`} />
    <meta name="theme-color" content="#142b50" />
    <link rel="icon" href="/favicon-48.png" />
    <link
      rel="preload"
      href="/fonts/bricolage.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-serif-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta
      property="og:title"
      content="Sabor Patricio · Un pedacito de Argentina en Mallorca"
    />
    <meta
      property="og:description"
      content="De nuestro obrador a tu mesa. 110gr de puro amor."
    />
    <meta property="og:image" content={`${site.url}/og.jpg`} />
    <meta property="og:url" content={`${site.url}/v2/`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
  </head>
  <body class="patricio">
    <a class="skip" href="#contenido">
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
