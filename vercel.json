{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.clarity.ms https://scripts.clarity.ms https://www.googletagmanager.com https://www.google-analytics.com https://googleads.g.doubleclick.net https://connect.facebook.net https://analytics.tiktok.com https://snap.licdn.com https://bat.bing.com; font-src 'self' data:; connect-src 'self' https://*.clarity.ms https://www.clarity.ms https://c.bing.com https://bat.bing.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.doubleclick.net https://www.google.com https://www.facebook.com https://connect.facebook.net https://analytics.tiktok.com https://px.ads.linkedin.com https://formspree.io https://api.web3forms.com; frame-src https://www.googletagmanager.com https://td.doubleclick.net https://www.facebook.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ejemplos-web/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/portfolio/:path*",
      "destination": "/sobre-coma/",
      "permanent": true
    },
    {
      "source": "/portfolio-item/:path*",
      "destination": "/sobre-coma/",
      "permanent": true
    },
    {
      "source": "/proyectos/:path*",
      "destination": "/sobre-coma/",
      "permanent": true
    },
    {
      "source": "/quienes-somos/:path*",
      "destination": "/sobre-coma/",
      "permanent": true
    },
    {
      "source": "/nosotros/:path*",
      "destination": "/sobre-coma/",
      "permanent": true
    },
    {
      "source": "/sobre-nosotros/:path*",
      "destination": "/sobre-coma/",
      "permanent": true
    },
    {
      "source": "/empresa/:path*",
      "destination": "/sobre-coma/",
      "permanent": true
    },
    {
      "source": "/trabajos/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/inicio/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/feed/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/servicios/:path*",
      "destination": "/soluciones/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/guias/",
      "permanent": true
    },
    {
      "source": "/noticias/:path*",
      "destination": "/guias/",
      "permanent": true
    },
    {
      "source": "/category/:path*",
      "destination": "/guias/",
      "permanent": true
    },
    {
      "source": "/tag/:path*",
      "destination": "/guias/",
      "permanent": true
    },
    {
      "source": "/author/:path*",
      "destination": "/guias/",
      "permanent": true
    },
    {
      "source": "/politica-de-privacidad/:path*",
      "destination": "/privacidad/",
      "permanent": true
    },
    {
      "source": "/privacy-policy/:path*",
      "destination": "/privacidad/",
      "permanent": true
    },
    {
      "source": "/politica-de-cookies/:path*",
      "destination": "/cookies/",
      "permanent": true
    },
    {
      "source": "/contactar/:path*",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/contacta/:path*",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/contact/:path*",
      "destination": "/contacto/",
      "permanent": true
    },
    {
      "source": "/tienda/:path*",
      "destination": "/soluciones/tienda-online-barata/",
      "permanent": true
    },
    {
      "source": "/shop/:path*",
      "destination": "/soluciones/tienda-online-barata/",
      "permanent": true
    }
  ]
}
